[FORMAT]
# Black controla el código a 99 chars. Subimos el límite de pylint a 120
# para tolerar docstrings y strings literales que black no puede partir.
max-line-length=120

# El default son 1000 líneas por módulo. mc_rov_revision.py lo pasó en 19.0.16.2.0 con
# 1045 — de las cuales **507 son comentarios, docstrings y líneas en blanco**, y solo unas
# 540 código. El largo lo produce la convención del CLAUDE.md, que pide explicar el porqué
# en el código, no un modelo inflado.
#
# La alternativa era sacar los tres modelos de línea a su propio archivo, y separa cosas que
# se leen juntas: la revisión y sus líneas son una unidad. Se sube el techo con holgura, no
# se quita — un archivo que llegue a 1400 sí necesita partirse.
max-module-lines=1400

[MESSAGES CONTROL]
disable=
    # Odoo no está instalado fuera del runtime — los imports son válidos en producción
    E0401,
    # Los modelos Odoo suelen ser solo declaración de campos, sin métodos públicos
    R0903,
    # __init__.py y __manifest__.py no requieren docstring de módulo en Odoo
    C0114,
    # __manifest__.py es un dict literal válido en Odoo, no un "pointless statement"
    W0104,
    # post-migrate usa guiones (convención Odoo), unittest usa camelCase (setUpClass/setUp)
    C0103,
    # Los métodos de test no requieren docstring — el nombre ya describe el caso
    C0116,
    # El setup de tests comparte código por diseño (TransactionCase)
    R0801,
    # migrate(cr, version): version es API obligatoria de Odoo aunque no se use
    W0613,
    # Los saltos de línea son responsabilidad del editor / git — no del linter
    C0327,
    # En Odoo el guion bajo marca API interna del MÓDULO, no de la clase, y llamarla entre
    # recordsets es la convención: `_for_xml_id` es la forma recomendada de resolver una
    # acción, y un helper propio se invoca sobre el recordset filtrado del mismo modelo.
    # Pylint lee las dos cosas como acceso a miembro protegido de una clase ajena.
    W0212,
