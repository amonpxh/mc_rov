<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_work_assignment_team" model="res.groups">
        <field name="name">Consultar trabajo del equipo</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Permite consultar asignaciones de otras cuentas, respetando los permisos de sus documentos.</field>
    </record>
    <record id="group_work_assignment_coordinate" model="res.groups">
        <field name="name">Coordinar asignaciones</field>
        <field name="implied_ids" eval="[Command.link(ref('base.group_user'))]"/>
        <field name="comment">Permiso independiente de consulta del equipo; no concede acceso a documentos ni a RRHH.</field>
    </record>
    <record id="group_customer_commitment_supervisor" model="res.groups">
        <field name="name">Supervisar compromisos al cliente</field>
        <field name="comment">Formaliza promesas y acredita salidas con los permisos nativos del documento y su empresa.</field>
    </record>
    <record id="group_repair_return_supervisor" model="res.groups">
        <field name="name">Dictaminar retornos de reparación</field>
        <field name="comment">Confirma el dictamen cuando ambas visitas y su evidencia son accesibles.</field>
    </record>
</odoo>
