<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_form_mc_rov" model="ir.ui.view">
        <field name="name">stock.lot.form.mc.rov</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">

            <!-- Sin header ni botones en el formulario: la baja vive en el menú de
                 acciones (engranaje), junto a Duplicar y Eliminar, que es la familia a
                 la que pertenece. Ver views/mc_rov_baja_wizard_views.xml. -->

            <!-- Una cinta se ve al abrir la ficha; un campo de estado hay que ir a leerlo.
                 Un equipo de baja no debería poder confundirse con uno operativo. -->
            <xpath expr="//div[@class='oe_title']" position="before">
                <widget name="web_ribbon"
                        title="De baja"
                        bg_color="text-bg-danger"
                        invisible="not mc_fecha_baja"/>
            </xpath>

            <!-- Campos de identificación y estado ROV -->
            <!-- Anclado a product_id (campo requerido en stock.lot, más estable que ref) -->
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="es_un_rov"/>
                <field name="mc_propietario_id" invisible="not es_un_rov"/>
                <field name="mc_fecha_puesta_servicio" invisible="not es_un_rov"/>
                <field name="ultima_mantencion" readonly="1" invisible="not es_un_rov"/>
                <field name="proxima_mantencion" readonly="1" invisible="not es_un_rov"/>
                <field name="ultima_reparacion" readonly="1" invisible="not es_un_rov"/>
                <field name="mc_estado_comercial"
                       readonly="1"
                       invisible="not es_un_rov"
                       help="Se deriva del propietario, de los arriendos vigentes y de la fecha de baja."/>
                <field name="mc_estado_operativo"
                       invisible="not es_un_rov"
                       help="Indica si el equipo está siendo reparado, en mantención o está operativo."/>

                <!-- La baja solo se muestra cuando existe: un equipo vigente no tiene por
                     qué mostrar campos vacíos de un evento que no ocurrió. -->
                <field name="mc_fecha_baja" invisible="not mc_fecha_baja"/>
                <field name="mc_motivo_baja" invisible="not mc_fecha_baja"/>
            </xpath>

            <!-- Pestañas de ficha técnica ROV (ocultas si no es ROV) -->
            <!-- Anclado a //sheet para no depender de nombres internos de grupos de Odoo -->
            <xpath expr="//sheet" position="inside">

                <!-- **Una sola señal de ficha incompleta, y es esta.** Hasta 19.0.15.2.1
                     convivía con el `required="es_un_rov"` de cada campo, así que lo mismo se
                     decía dos veces: el aviso nombraba los campos y además salían pintados de
                     rojo abajo.

                     Se quedó el aviso porque es el que cubre los tres casos donde el rojo no
                     llega: los numéricos en cero —que el navegador rechaza pero no pinta, así
                     que el guardado fallaba sin causa visible—, los campos que viven en otra
                     pestaña, y lo que entra por importación o por código, donde no hay
                     formulario que mirar.

                     Y el `required` no solo sobraba: era todo o nada. Quien conoce 12 de las
                     14 especificaciones no podía guardar las 12, y la salida era inventar las
                     otras 2 — un valor supuesto es indistinguible de uno verificado, que es
                     justamente lo que este módulo trata de evitar desde que se retiró la
                     opción «Desconocido» en 19.0.7.0.0.

                     No se pierde presión: el aviso aparece en cada apertura y el filtro «Ficha
                     incompleta» de la lista sigue encontrando a todos. Se pierde el bloqueo,
                     que estaba protegiendo el formulario a costa de premiar el dato
                     inventado. -->
                <div class="alert alert-warning" role="alert"
                     invisible="not es_un_rov or mc_ficha_completa">
                    <!-- El conteo entra en 19.0.15.2.2. Sin él el aviso decía exactamente lo
                         mismo con un campo vacío que con dieciséis, así que llenar quince de
                         dieciséis se veía igual que no haber empezado: el mismo muro amarillo.
                         Con el avance a la vista, completar la ficha por partes es progreso
                         visible en vez de un aviso que no se mueve. -->
                    <strong>Faltan
                        <field name="mc_ficha_faltantes_n" nolabel="1" readonly="1" class="oe_inline"/>
                        de
                        <field name="mc_ficha_total_n" nolabel="1" readonly="1" class="oe_inline"/>
                        datos de la ficha técnica:
                    </strong>
                    <field name="mc_ficha_faltantes" nolabel="1" readonly="1" class="oe_inline"/>
                </div>
                <field name="mc_ficha_completa" invisible="1"/>

                <notebook name="notebook_ficha_rov">

                    <page string="Especificaciones" name="page_especificaciones" invisible="not es_un_rov">
                        <group name="group_especificaciones">
                            <!-- Ningún campo lleva `required`, ni acá ni en el modelo.

                                 En el modelo nunca lo llevó: la orden de fabricación crea el
                                 número de serie por código, antes de que nadie llene la
                                 ficha, y los lotes de componentes no tienen ninguno de estos
                                 datos — un NOT NULL en la base rompería las dos cosas.

                                 En la vista salió en 19.0.15.2.1, por lo anotado arriba en el
                                 aviso. Lo que marca una ficha a medio llenar es
                                 `mc_ficha_completa`: un solo mecanismo, que funciona igual
                                 para lo que se teclea y para lo que se importa. -->
                            <group name="group_especificaciones_left">
                                <field name="mc_chasis" widget="radio" options="{&quot;horizontal&quot;:true}"/>
                                <field name="mc_modelo_motores" widget="selection" placeholder="Seleccione modelo de motor"/>
                                <field name="mc_n_motores"/>
                                <field name="mc_posicion_motores" widget="radio" options="{&quot;horizontal&quot;:true}"/>
                                <label for="mc_peso_consola" string="Peso Consola"/>
                                <div class="o_row">
                                    <field name="mc_peso_consola" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>kg</span>
                                </div>
                                <label for="mc_peso_rov" string="Peso ROV"/>
                                <div class="o_row">
                                    <field name="mc_peso_rov" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>kg</span>
                                </div>
                                <field name="mc_sensor_presion" widget="radio" options="{&quot;horizontal&quot;:true}"/>
                                <!-- Vive aquí y no en Periféricos porque es un conteo de
                                     componentes del equipo, como N° de motores, y no un
                                     accesorio. Con esto la regla de obligatoriedad se
                                     vuelve enunciable: es todo Especificaciones y nada
                                     más. La ficha de reparación compara contra este
                                     número el conteo de luces de la prueba. -->
                                <field name="mc_cantidad_luces"/>
                            </group>
                            <!-- Estos cinco viajan en los dos sentidos con la prueba de rendimiento: la
                                 prueba nace con lo que aquí esté declarado, y al confirmarse devuelve lo que
                                 se encontró. Por eso da igual qué se llene primero y no hace falta pedirle a
                                 nadie que deje campos en blanco. -->
                            <group name="group_especificaciones_right">
                                <field name="mc_tarjeta_comunicacion_rov" widget="radio" options="{&quot;horizontal&quot;:true}"/>
                                <field name="mc_tarjeta_comunicacion_consola" widget="radio" options="{&quot;size&quot;:&quot;md&quot;,&quot;horizontal&quot;:true}"/>
                                <field name="mc_software_superficie" widget="radio" options="{&quot;horizontal&quot;:true}"/>
                                <field name="mc_version_software" placeholder="0.0.0"/>
                                <field name="mc_controlador_vuelo" widget="radio" options="{&quot;horizontal&quot;:true}"/>
                                <field name="mc_version_controlador" placeholder="0.0.0"/>
                                <field name="mc_version_ardusub" placeholder="0.0.0"/>
                                <!-- Selection de Sí/No y no casilla: un booleano nunca está
                                     vacío, así que un "no" no se distinguiría de un "nadie
                                     lo revisó". De este dato depende sobre qué parte de la
                                     flota se puede medir confiabilidad por horas de uso en
                                     vez de por calendario. -->
                                <field name="mc_tiene_horometro" widget="radio" options="{&quot;horizontal&quot;:true}"/>
                            </group>
                        </group>

                        <!-- Configuración del equipo, no resultado de una prueba: por eso
                             sobrevivieron al retiro de 19.0.17.0.0 y viven acá. La prueba de
                             rendimiento y la de terreno los miden; la revisión de reparación los
                             muestra desde aquí para ver si cambiaron. -->
                        <separator string="Parámetros de trabajo"/>
                        <group name="group_parametros">
                            <group>
                                <label for="mc_limitacion_pilot_gain"/>
                                <div class="o_row">
                                    <field name="mc_limitacion_pilot_gain" nolabel="1"
                                           class="o_field_number" style="max-width: 80px;"/>
                                    <span>%</span>
                                </div>
                            </group>
                            <group>
                                <label for="mc_ganancia_luz"/>
                                <div class="o_row">
                                    <field name="mc_ganancia_luz" nolabel="1"
                                           class="o_field_number" style="max-width: 80px;"/>
                                    <span>%</span>
                                </div>
                            </group>
                        </group>

                        <!-- Periféricos y Umbilical fueron pestañas propias hasta 19.0.18.1.0.
                             Eran cuatro campos cada una: demasiado poco para gastar una pestaña,
                             y repartir la ficha en tres obligaba a pasearse por ellas para
                             contestar una sola pregunta —qué es este equipo—. Entran como
                             secciones, que es lo que siempre fueron. -->
                        <separator string="Periféricos"/>
                        <group name="group_perifericos">
                            <group name="group_perifericos_left">
                                <field name="mc_salida_brazo"/>
                                <field name="mc_brazo"/>
                            </group>
                            <group name="group_perifericos_right">
                                <field name="mc_dispositivos_extra"/>
                            </group>
                        </group>

                        <separator string="Umbilical"/>
                        <group name="group_umbilical">
                            <group name="group_umbilical_left">
                                <field name="mc_n_serie_umbilical"/>
                                <label for="mc_longitud" string="Longitud"/>
                                <div class="o_row">
                                    <field name="mc_longitud" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>m</span>
                                </div>
                            </group>
                            <group name="group_umbilical_right">
                                <label for="mc_diametro" string="Diámetro"/>
                                <div class="o_row">
                                    <field name="mc_diametro" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>mm</span>
                                </div>
                                <label for="mc_peso_umbilical" string="Peso Umbilical"/>
                                <div class="o_row">
                                    <field name="mc_peso_umbilical" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>kg</span>
                                </div>
                            </group>
                        </group>
                        <!-- Se llamaba «PRUEBA DE RENDIMIENTO» hasta 19.0.16.0.1. Estas mediciones
                             son las de rendimiento, y desde 19.0.16.0.0 el tipo de revisión que las
                             recoge se llama así — la etiqueta se había quedado con la palabra
                             que se retiró. La sección entera desaparece en el bloque A2, cuando
                             la prueba de rendimiento reemplace estas columnas. -->
                        <!-- Aquí vivieron «PRUEBA DE RENDIMIENTO» y «PARÁMETROS DE TRABAJO»
                             hasta 19.0.17.0.0, dentro de una pestaña que solo nombraba la
                             primera de sus tres secciones. Venía de la época de Studio.

                             Las mediciones eran el resultado de un evento guardado como
                             ficha, y encima estaban duplicadas con la revisión: el mismo dato
                             se tecleaba dos veces sin ninguna señal de que sobraba. Ahora
                             viven en una prueba de rendimiento, que lleva historial.

                             Los dos parámetros de trabajo que sí son ficha —pilot gain y
                             ganancia luz— se movieron a Especificaciones, que es donde
                             corresponde: describen cómo está configurado el equipo, no cómo
                             salió una prueba. -->
                    </page>

                    <!-- La pestaña «Prueba en Terreno» se retiró en 19.0.16.0.0. Era el
                         resultado de un evento guardado como ficha, así que repetir la
                         prueba pisaba la anterior sin avisar. Ahora es una revisión de tipo
                         `terreno`, con historial y con su propia batería. -->

                    <!-- Historial de propiedad. Solo lectura: lo escribe el override de
                         write de stock.lot al cambiar el propietario, no una persona. -->
                    <page string="Pruebas" name="page_revisiones" invisible="not es_un_rov">
                        <!-- El botón que reemplaza al menú de revisiones de
                             fabricación: manufactura las crea desde aquí, que es donde ya
                             trabaja. Va en su propio div y no en un group, porque un botón
                             dentro de un group ocupa una celda suelta y desincroniza los
                             pares etiqueta/campo de todo lo que venga después (PR #10). -->
                        <div class="mb-3">
                            <button name="action_nueva_revision_rendimiento" type="object"
                                    string="Nueva prueba de rendimiento"
                                    class="btn-primary"/>
                            <!-- La prueba en terreno vivía como pestaña de este mismo
                                 formulario hasta 19.0.16.0.0, donde se retiró porque guardaba
                                 el resultado de un evento como si fuera ficha. Su casa nueva
                                 es una revisión, y sin este botón se había quedado sin puerta
                                 desde el número de serie. -->
                            <button name="action_nueva_revision_terreno" type="object"
                                    string="Nueva prueba en terreno"
                                    class="btn-secondary ms-2"/>
                        </div>
                        <!-- Ya no es `readonly`: una prueba a medio llenar hay que poder volver a
                             abrirla y terminarla. No se crean desde aquí —para eso están los dos
                             botones de arriba, que fijan el tipo— pero sí se borran, porque el
                             botón crea al primer clic y hace falta deshacer un clic equivocado.
                             Una revisión confirmada no se deja borrar: eso lo impide el modelo. -->
                        <field name="revision_ids">
                            <list create="0">
                                <field name="name"/>
                                <field name="fecha"/>
                                <field name="tipo"/>
                                <field name="responsable_id"/>
                                <field name="horas_operacion" optional="show"/>
                                <field name="resultado"
                                       decoration-danger="resultado == 'rechazado'"
                                       decoration-warning="resultado == 'aprobado_con_observaciones'"
                                       decoration-success="resultado == 'aprobado'"/>
                                <field name="estado"/>
                            </list>
                        </field>
                    </page>

                    <!-- Las notas de Odoo se traen acá dentro. Sueltas en el sheet dejaban
                         un hueco enorme entre los campos y las pestañas cada vez que
                         estaban vacías, que es casi siempre.

                         Esta página no se oculta para los no-ROV: es el único lugar donde
                         vive el campo, y esconderlo lo volvería inalcanzable en los lotes
                         de componentes. -->
                    <page string="Propietarios" name="page_propietarios" invisible="not es_un_rov">
                        <field name="mc_propietario_historial_ids" readonly="1">
                            <list>
                                <field name="fecha_desde"/>
                                <field name="fecha_hasta"/>
                                <field name="partner_id"/>
                                <field name="repair_id"/>
                            </list>
                        </field>
                    </page>

                    <!-- El historial de pruebas del equipo, y va **antes** de propietarios y
                         alertas: las tres primeras pestañas dicen qué ES el equipo, ésta dice
                         qué le PASÓ, y lo demás es accesorio.

                         Se llamaba «Revisiones» hasta 19.0.16.1.0, que es el nombre del modelo
                         y de la familia. Se cambió por descubrimiento y no por taxonomía: la
                         etiqueta de una pestaña es el único cartel que el usuario ve, y
                         «Revisiones» no dice que ahí se prueba el equipo. Cada fila sigue
                         diciendo de qué clase es —Prueba de rendimiento, Prueba en terreno,
                         Reparación—, así que nadie confunde una reparación con una prueba.

                         Va como pestaña y no como botón
                         inteligente porque el formulario de lote no declara un
                         oe_button_box con nombre estable al que anclarse, y adivinar
                         internos de una vista heredada es lo que causó los defectos de
                         19.0.5.0.1 y 19.0.5.1.0.

                         Esta es la serie de tiempo del equipo: dos revisiones separadas por
                         un año son lo que deja ver que el ancho de banda cayó, o cuántas
                         horas voló entre visitas. -->
                    <!-- Las lecciones que tocaron a esta unidad. Va como pestaña por la
                         misma razón que la de Revisiones y que está escrita arriba: este
                         formulario no declara un oe_button_box con nombre estable, y
                         adivinar internos de una vista heredada ya costó dos defectos.

                         Es consulta de referencia, no el lugar principal: la lista que
                         importa es la de la orden de fabricación, porque es la única que
                         aparece sin que nadie la busque (fabricacion.md § 6.1.1). Ésta
                         contesta la otra pregunta — «¿a este equipo qué le pasó que fuera
                         del modelo y no suyo?». -->
                    <page string="Alertas de calidad"
                          name="page_alertas_calidad"
                          groups="quality.group_quality_user"
                          invisible="not mc_alerta_ids">
                        <field name="mc_alerta_ids" readonly="1" nolabel="1">
                            <list>
                                <field name="name" string="Referencia"/>
                                <field name="title"/>
                                <field name="reason_id"/>
                                <field name="stage_id"/>
                                <field name="mc_eco_id" optional="show"/>
                            </list>
                        </field>
                    </page>

                    <page string="Descripción" name="page_descripcion"/>

                </notebook>
            </xpath>

            <!-- El move va en su propia operación y no anidado dentro de la página de
                 arriba. Odoo solo lo ejecuta cuando es hijo directo de una operación de
                 posición: anidado más adentro se ignora en silencio, y el resultado es
                 una pestaña vacía con el editor de notas todavía sobre las pestañas. -->
            <xpath expr="//page[@name='page_descripcion']" position="inside">
                <xpath expr="//group[@name='description']" position="move"/>
            </xpath>

            <!-- El group movido trae su propio título "Descripción", que dentro de una
                 pestaña del mismo nombre se ve repetido. -->
            <xpath expr="//group[@name='description']" position="attributes">
                <attribute name="string"/>
            </xpath>

        </field>
    </record>
</odoo>
