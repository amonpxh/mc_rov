<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_form_mc_rov" model="ir.ui.view">
        <field name="name">stock.lot.form.mc.rov</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">

            <!-- Botón inteligente de reparaciones -->
            <div name="button_box" position="inside">
                <button name="action_ver_reparaciones"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-wrench">
                    <field name="repair_count" widget="statinfo" string="Reparaciones"/>
                </button>
            </div>

            <!-- Marca si el lote corresponde a un equipo ROV -->
            <field name="ref" position="after">
                <field name="es_un_rov"/>
                <field name="ultima_mantencion"
                       readonly="1"
                       invisible="not es_un_rov"/>
            </field>

        </field>
    </record>
</odoo>