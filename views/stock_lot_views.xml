<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_lot_form_mc_rov" model="ir.ui.view">
        <field name="name">stock.lot.form.mc.rov</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">

            <!-- El formulario de stock no trae header. Se agrega uno porque es donde el
                 usuario ya sabe buscar las acciones que cambian el estado de un registro,
                 sin que nadie se lo explique. -->
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="action_dar_de_baja"
                            type="object"
                            string="Dar de baja"
                            class="btn-secondary"
                            invisible="not es_un_rov or mc_fecha_baja"
                            confirm="El equipo quedará marcado como fuera de servicio con la fecha de hoy. Podrá corregir la fecha y revertir la baja después. ¿Continuar?"/>
                    <button name="action_reactivar"
                            type="object"
                            string="Reactivar equipo"
                            class="btn-secondary"
                            invisible="not mc_fecha_baja"/>
                </header>
            </xpath>

            <!-- Una cinta se ve al abrir la ficha; un campo de estado hay que ir a leerlo.
                 Un equipo de baja no debería poder confundirse con uno operativo. -->
            <xpath expr="//div[@class='oe_title']" position="before">
                <widget name="web_ribbon"
                        title="De baja"
                        bg_color="text-bg-danger"
                        invisible="not mc_fecha_baja"/>
            </xpath>

            <!-- Campos de identificación y estado ROV -->
            <!-- Anclado a product_id (campo requerido en stock.lot, más estable que ref) -->
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="es_un_rov"/>
                <field name="mc_propietario_id" invisible="not es_un_rov"/>
                <field name="mc_fecha_puesta_servicio" invisible="not es_un_rov"/>
                <field name="ultima_mantencion" readonly="1" invisible="not es_un_rov"/>
                <field name="proxima_mantencion" readonly="1" invisible="not es_un_rov"/>
                <field name="ultima_reparacion" readonly="1" invisible="not es_un_rov"/>
                <field name="mc_estado_comercial"
                       readonly="1"
                       invisible="not es_un_rov"
                       help="Se deriva del propietario, de los arriendos vigentes y de la fecha de baja."/>
                <field name="mc_estado_operativo"
                       invisible="not es_un_rov"
                       help="Indica si el equipo está siendo reparado, en mantención o está operativo."/>

                <!-- La baja solo se muestra cuando existe: un equipo vigente no tiene por
                     qué mostrar campos vacíos de un evento que no ocurrió. -->
                <field name="mc_fecha_baja" invisible="not mc_fecha_baja"/>
                <field name="mc_motivo_baja" invisible="not mc_fecha_baja"/>
            </xpath>

            <!-- Pestañas de ficha técnica ROV (ocultas si no es ROV) -->
            <!-- Anclado a //sheet para no depender de nombres internos de grupos de Odoo -->
            <xpath expr="//sheet" position="inside">
                <notebook name="notebook_ficha_rov">

                    <page string="Especificaciones" name="page_especificaciones" invisible="not es_un_rov">
                        <group name="group_especificaciones">
                            <group name="group_especificaciones_left">
                                <field name="mc_chasis" widget="radio" options="{&quot;horizontal&quot;:true}"/>
                                <field name="mc_modelo_motores" widget="selection" placeholder="Seleccione modelo de motor"/>
                                <field name="mc_n_motores"/>
                                <field name="mc_posicion_motores" widget="radio" options="{&quot;horizontal&quot;:true}"/>
                                <label for="mc_peso_consola" string="Peso Consola"/>
                                <div class="o_row">
                                    <field name="mc_peso_consola" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>kg</span>
                                </div>
                                <label for="mc_peso_rov" string="Peso ROV"/>
                                <div class="o_row">
                                    <field name="mc_peso_rov" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>kg</span>
                                </div>
                                <field name="mc_sensor_presion" widget="radio" options="{&quot;horizontal&quot;:true}"/>
                            </group>
                            <group name="group_especificaciones_right">
                                <field name="mc_tarjeta_comunicacion_rov" widget="radio" options="{&quot;horizontal&quot;:true}"/>
                                <field name="mc_tarjeta_comunicacion_consola" widget="radio" options="{&quot;size&quot;:&quot;md&quot;,&quot;horizontal&quot;:true}"/>
                                <field name="mc_version_qground" placeholder="0.0.0"/>
                                <field name="mc_controlador_vuelo" widget="radio" options="{&quot;horizontal&quot;:true}"/>
                                <field name="mc_version_px4" placeholder="0.0.0"/>
                                <field name="mc_version_navigator" placeholder="0.0.0"/>
                                <field name="mc_version_ardusub" placeholder="0.0.0"/>
                            </group>
                        </group>
                    </page>

                    <page string="Periféricos" name="page_perifericos" invisible="not es_un_rov">
                        <group name="group_perifericos">
                            <group name="group_perifericos_left">
                                <field name="mc_salida_brazo"/>
                                <field name="mc_brazo"/>
                            </group>
                            <group name="group_perifericos_right">
                                <field name="mc_cantidad_luces"/>
                                <field name="mc_dispositivos_extra"/>
                            </group>
                        </group>
                    </page>

                    <page string="Umbilical" name="page_umbilical" invisible="not es_un_rov">
                        <separator string="Especificaciones Umbilical"/>
                        <group name="group_umbilical">
                            <group name="group_umbilical_left">
                                <field name="mc_n_serie_umbilical"/>
                                <label for="mc_longitud" string="Longitud"/>
                                <div class="o_row">
                                    <field name="mc_longitud" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>m</span>
                                </div>
                            </group>
                            <group name="group_umbilical_right">
                                <label for="mc_diametro" string="Diámetro"/>
                                <div class="o_row">
                                    <field name="mc_diametro" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>mm</span>
                                </div>
                                <label for="mc_peso_umbilical" string="Peso Umbilical"/>
                                <div class="o_row">
                                    <field name="mc_peso_umbilical" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>kg</span>
                                </div>
                            </group>
                        </group>
                        <separator string="PRUEBA DE RENDIMIENTO"/>
                        <group name="group_rendimiento">
                            <group name="group_rendimiento_left">
                                <field name="mc_modelo_fuente"/>
                                <field name="mc_fuente_energia" widget="radio" options="{&quot;horizontal&quot;:true}"/>
                                <label for="mc_tension_salida" string="Tensión de salida"/>
                                <div class="o_row">
                                    <field name="mc_tension_salida" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>V</span>
                                </div>
                            </group>
                            <group name="group_rendimiento_right">
                                <field name="mc_consumo_corriente" readonly="1" force_save="1"/>
                                <label for="mc_en_reposo" string="En reposo"/>
                                <div class="o_row">
                                    <field name="mc_en_reposo" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>kWh</span>
                                </div>
                                <label for="mc_esfuerzo" string="Esfuerzo"/>
                                <div class="o_row">
                                    <field name="mc_esfuerzo" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>kWh</span>
                                </div>
                            </group>
                        </group>
                        <separator string="PARÁMETROS DE TRABAJO"/>
                        <group name="group_parametros">
                            <group name="group_parametros_left">
                                <label for="mc_limitacion_pilot_gain" string="Limitación pilot gain"/>
                                <div class="o_row">
                                    <field name="mc_limitacion_pilot_gain" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>%</span>
                                </div>
                                <label for="mc_ganancia_luz" string="Ganancia Luz"/>
                                <div class="o_row">
                                    <field name="mc_ganancia_luz" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>%</span>
                                </div>
                                <label for="mc_tiempo_prueba_lab" string="Tiempo de Prueba"/>
                                <div class="o_row">
                                    <field name="mc_tiempo_prueba_lab" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>h</span>
                                </div>
                                <field name="mc_prueba_leak"/>
                            </group>
                            <group name="group_parametros_right">
                                <field name="mc_ancho_banda" readonly="1" force_save="1"/>
                                <label for="mc_subida" string="Subida"/>
                                <div class="o_row">
                                    <field name="mc_subida" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>Mbps</span>
                                </div>
                                <label for="mc_bajada" string="Bajada"/>
                                <div class="o_row">
                                    <field name="mc_bajada" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>Mbps</span>
                                </div>
                                <label for="mc_temperatura_interior_lab" string="Temperatura interior"/>
                                <div class="o_row">
                                    <field name="mc_temperatura_interior_lab" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>°C</span>
                                </div>
                                <label for="mc_temperatura_exterior_lab" string="Temperatura exterior"/>
                                <div class="o_row">
                                    <field name="mc_temperatura_exterior_lab" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>°C</span>
                                </div>
                            </group>
                        </group>
                    </page>

                    <page string="Prueba en Terreno" name="page_prueba_terreno" invisible="not es_un_rov">
                        <group name="group_terreno">
                            <group name="group_terreno_left">
                                <field name="mc_fecha_prueba"/>
                                <field name="mc_lugar"/>
                                <label for="mc_profundidad" string="Profundidad"/>
                                <div class="o_row">
                                    <field name="mc_profundidad" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>m</span>
                                </div>
                                <label for="mc_velocidad_corriente" string="Velocidad de la corriente"/>
                                <div class="o_row">
                                    <field name="mc_velocidad_corriente" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>Knots</span>
                                </div>
                                <field name="mc_alimentacion" widget="radio" options="{&quot;horizontal&quot;:true}"/>
                            </group>
                            <group name="group_terreno_right">
                                <label for="mc_tiempo_prueba_terreno" string="Tiempo de prueba"/>
                                <div class="o_row">
                                    <field name="mc_tiempo_prueba_terreno" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>h</span>
                                </div>
                                <label for="mc_temperatura_interior_terreno" string="Temperatura interior (Prueba)"/>
                                <div class="o_row">
                                    <field name="mc_temperatura_interior_terreno" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>°C</span>
                                </div>
                                <label for="mc_temperatura_exterior_terreno" string="Temperatura exterior (Prueba)"/>
                                <div class="o_row">
                                    <field name="mc_temperatura_exterior_terreno" nolabel="1" class="o_field_number" style="max-width: 80px;"/>
                                    <span>°C</span>
                                </div>
                                <field name="mc_observacion"/>
                            </group>
                        </group>
                    </page>

                    <!-- Historial de propiedad. Solo lectura: lo escribe el override de
                         write de stock.lot al cambiar el propietario, no una persona. -->
                    <page string="Propietarios" name="page_propietarios" invisible="not es_un_rov">
                        <field name="mc_propietario_historial_ids" readonly="1">
                            <list>
                                <field name="fecha_desde"/>
                                <field name="fecha_hasta"/>
                                <field name="partner_id"/>
                                <field name="repair_id"/>
                            </list>
                        </field>
                    </page>

                    <!-- Las notas de Odoo se traen acá dentro. Sueltas en el sheet dejaban
                         un hueco enorme entre los campos y las pestañas cada vez que
                         estaban vacías, que es casi siempre.

                         Esta página no se oculta para los no-ROV: es el único lugar donde
                         vive el campo, y esconderlo lo volvería inalcanzable en los lotes
                         de componentes. -->
                    <page string="Descripción" name="page_descripcion">
                        <xpath expr="//group[@name='description']" position="move"/>
                    </page>

                </notebook>
            </xpath>

            <!-- El group movido trae su propio título "Descripción", que dentro de una
                 pestaña del mismo nombre se ve repetido. -->
            <xpath expr="//group[@name='description']" position="attributes">
                <attribute name="string"/>
            </xpath>

        </field>
    </record>
</odoo>
