<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_return_wizard" model="ir.ui.view">
        <field name="name">mc.rov.repair.return.wizard.form</field>
        <field name="model">mc.rov.repair.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Retorno de reparación">
                <group>
                    <field name="return_id"/>
                    <field name="decide" invisible="1"/>
                    <field name="lot_id" invisible="1"/>
                    <field name="company_id" invisible="1"/>
                    <field name="original_id" invisible="decide" required="not decide"
                           domain="[('id', '!=', return_id), ('lot_id', '=', lot_id), ('company_id', '=', company_id), ('state', '!=', 'cancel')]"
                           options="{'no_create': True}"/>
                    <field name="relation" invisible="not decide" required="decide"/>
                    <field name="reason" invisible="not decide" required="decide"/>
                </group>
                <footer>
                    <button name="action_link" type="object" string="Vincular retorno" class="btn-primary" invisible="decide"/>
                    <button name="action_decide" type="object" string="Registrar dictamen" class="btn-primary"
                            groups="mc_rov.group_repair_return_supervisor" invisible="not decide"/>
                    <button special="cancel" string="Cerrar" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_repair_order_return" model="ir.ui.view">
        <field name="name">repair.order.form.mc.return</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="mc_rov.view_repair_order_arrival"/>
        <field name="arch" type="xml">
            <header position="inside">
                <field name="mc_return_relation" invisible="1"/>
                <button name="action_mc_link_return" type="object" string="Vincular retorno"
                        groups="stock.group_stock_user" invisible="not lot_id or not mc_arrived_at or state == 'cancel' or mc_return_relation"/>
                <button name="action_mc_decide_return" type="object" string="Dictaminar retorno"
                        groups="mc_rov.group_repair_return_supervisor" invisible="state == 'cancel' or mc_return_relation != 'pending'"/>
            </header>
            <xpath expr="//sheet/notebook" position="inside">
                <page name="mc_repair_return" string="Retorno" invisible="not mc_return_relation">
                    <group>
                        <field name="mc_return_original_id"/>
                        <field name="mc_return_relation"/>
                        <field name="mc_return_reason" invisible="mc_return_relation == 'pending'"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
