<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="customer_dispatch_wizard_form" model="ir.ui.view">
        <field name="name">mc.rov.customer.dispatch.wizard.form</field>
        <field name="model">mc.rov.customer.dispatch.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="kind" invisible="1"/>
                <group>
                    <field name="picking_id" options="{'no_open': True}"/>
                    <field name="mode" invisible="kind == 'invalidated'" required="kind != 'invalidated'"/>
                    <field name="precision" invisible="kind == 'invalidated'" required="kind != 'invalidated'"/>
                    <field name="effective_date" invisible="kind == 'invalidated' or precision != 'date'"
                           required="kind != 'invalidated' and precision == 'date'"/>
                    <field name="effective_at" invisible="kind == 'invalidated' or precision != 'datetime'"
                           required="kind != 'invalidated' and precision == 'datetime'"/>
                    <field name="attachment_id" invisible="kind == 'invalidated'" required="kind != 'invalidated'"
                           domain="[('res_model', '=', 'stock.picking'), ('res_id', '=', picking_id),
                                    '|', ('res_field', '=', False), ('res_field', '=', 'signature')]"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="repair_candidate_ids" invisible="1"/>
                    <field name="repair_ids" invisible="kind == 'invalidated' or (not repair_candidate_ids and not repair_ids)"
                           domain="[('id', 'in', repair_candidate_ids)]" widget="many2many_tags"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="reason" invisible="kind == 'confirmed'" required="kind != 'confirmed'"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Guardar constancia" class="btn-primary"
                            invisible="kind == 'invalidated'"/>
                    <button name="action_apply" type="object" string="Invalidar constancia" class="btn-primary"
                            invisible="kind != 'invalidated'"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="stock_picking_customer_dispatch_form" model="ir.ui.view">
        <field name="name">stock.picking.customer.dispatch.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="mc_customer_dispatch" string="Constancia de salida" invisible="not mc_dispatch_visible">
                    <field name="mc_dispatch_visible" invisible="1"/>
                    <field name="mc_dispatch_can_capture" invisible="1"/>
                    <field name="mc_dispatch_can_invalidate" invisible="1"/>
                    <button name="action_open_customer_dispatch" type="object" string="Registrar o corregir constancia"
                            invisible="not mc_dispatch_can_capture" groups="mc_rov.group_customer_commitment_supervisor"
                            class="btn-secondary"/>
                    <button name="action_open_customer_dispatch_invalidation" type="object" string="Invalidar constancia"
                            invisible="not mc_dispatch_can_invalidate" groups="mc_rov.group_customer_commitment_supervisor"
                            class="btn-secondary"/>
                    <field name="mc_dispatch_history" nolabel="1" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
