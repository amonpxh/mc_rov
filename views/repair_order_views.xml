<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_order_form_mc_rov" model="ir.ui.view">
        <field name="name">repair.order.form.mc.rov</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">

            <!-- Tipo de intervención después de "Bajo garantía" -->
            <field name="under_warranty" position="after">
                <field name="tipo_intervencion_ids" widget="many2many_tags"/>
            </field>

            <!-- Ítems adicionales después del número de serie -->
            <field name="lot_id" position="after">
                <field name="mc_propietario_lot_id" readonly="1" invisible="not lot_id"/>
                <field name="mc_propietario_difiere" invisible="1"/>
                <field name="item_2"/>
                <field name="item_3"/>
                <field name="item_4"/>
                <field name="item_5"/>
            </field>

            <!-- Aviso de reventa. Nadie nos avisa cuando un cliente revende su ROV; el
                 síntoma es que el equipo vuelve al taller a nombre de otro contacto. -->
            <notebook position="before">
                <div class="alert alert-warning" role="alert" invisible="not mc_propietario_difiere">
                    <strong>El equipo está registrado a nombre de otro contacto.</strong>
                    Si el ROV cambió de dueño, traspáselo. Si es un tercero quien paga esta
                    reparación —un seguro, un distribuidor— deje el propietario como está.
                    <button name="action_actualizar_propietario_lote"
                            type="object"
                            string="Traspasar al cliente de la orden"
                            class="btn-link"
                            confirm="El equipo quedará a nombre del cliente de esta orden y se cerrará el período del propietario anterior en el historial. ¿Continuar?"/>
                </div>
            </notebook>

            <!-- Falla reportada después de fecha programada -->
            <field name="schedule_date" position="after">
                <field name="falla_reportada"/>
            </field>

            <!-- Pestaña nueva de trabajos realizados -->
            <notebook position="inside">
                <page string="Trabajos realizados" name="trabajos_realizados">
                    <field name="linea_falla_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="componente_id"/>
                            <field name="subtipo_id" domain="[('componente_id', '=', componente_id)]"/>
                            <field name="accion_id"/>
                            <field name="fecha"/>
                            <field name="horas" class="text-start"/>
                            <field name="detalle"/>
                        </list>
                    </field>
                    <group>
                        <group>
                            <field name="mc_total_horas" readonly="True"/>
                        </group>
                        <group/>
                    </group>
                </page>
                <page string="Resultado" name="resultado">
                    <group>
                        <group>
                            <field name="causa_raiz"/>
                            <field name="fecha_entrega_real"/>
                        </group>
                        <group/>
                    </group>
                    <field name="observaciones_salida"/>
                </page>
            </notebook>

            <!-- Reordenamiento al flujo real del taller: se registra lo que se hizo,
                 después lo que se consumió, después el cierre, y las notas al final.

                 El orden anterior no era una decisión: el notebook position="inside" de
                 arriba pega al final, así que las dos páginas de Odoo quedaban delante
                 por omisión. El efecto era que "Notas de reparación" se metía entre
                 Trabajos realizados y Piezas, que son justamente las dos que hay que
                 llenar de forma consistente entre sí — una línea de "cambio" exige el
                 repuesto correspondiente.

                 Cada move va en su propia operación de nivel superior. Odoo solo ejecuta
                 position="move" cuando es hijo directo de una operación de posición;
                 anidado más adentro lo ignora en silencio (ver PR #12). -->
            <xpath expr="//page[@name='parts']" position="before">
                <xpath expr="//page[@name='trabajos_realizados']" position="move"/>
            </xpath>

            <xpath expr="//page[@name='resultado']" position="after">
                <xpath expr="//page[@name='repair_notes']" position="move"/>
            </xpath>

        </field>
    </record>

    <record id="view_repair_order_list_mc_rov" model="ir.ui.view">
        <field name="name">repair.order.list.mc.rov</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="tipo_intervencion_ids" widget="many2many_tags"/>
                <field name="mc_total_horas"/>
            </field>
        </field>
    </record>

</odoo>
