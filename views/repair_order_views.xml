<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_repair_order_form_mc_rov" model="ir.ui.view">
        <field name="name">repair.order.form.mc.rov</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">

            <!-- Tipo de intervención después de "Bajo garantía" -->
            <field name="under_warranty" position="after">
                <field name="tipo_intervencion_ids" widget="many2many_tags"/>
            </field>

            <!-- El propietario y lo que llegó junto al equipo, anclados ANTES de "Bajo
                 garantía" y no después del número de serie. En el arch base lot_id va
                 dentro de un div, así que un position="after" sobre el campo metía estos
                 dos adentro del mismo div: salían en línea, sin etiqueta y pegados al
                 número de serie, donde se leían como una repetición de él. Anclar en un
                 campo que sí es hijo directo del group les devuelve su propia fila. -->
            <field name="under_warranty" position="before">
                <field name="mc_propietario_lot_id" readonly="1" invisible="not lot_id"/>
                <field name="mc_propietario_difiere" invisible="1"/>
            </field>

            <!-- Las etiquetas nativas de repair se esconden: tipo_intervencion_ids ya
                 clasifica la orden y es lo que leen los reportes. Dos campos de tags
                 idénticos uno al lado del otro solo consiguen que se llene el equivocado,
                 y lo que caiga en este no lo mira nadie. -->
            <field name="tag_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <!-- "Piezas" no dice de qué: la pestaña admite tanto lo que se le pone al
                 equipo como lo que se le retira. -->
            <xpath expr="//page[@name='parts']" position="attributes">
                <attribute name="string">Repuestos</attribute>
            </xpath>

            <!-- Aviso de reventa. Nadie nos avisa cuando un cliente revende su ROV; el
                 síntoma es que el equipo vuelve al taller a nombre de otro contacto. -->
            <notebook position="before">
                <div class="alert alert-warning" role="alert" invisible="not mc_propietario_difiere">
                    <strong>El equipo está registrado a nombre de otro contacto.</strong>
                    Si el ROV cambió de dueño, traspáselo. Si es un tercero quien paga esta
                    reparación —un seguro, un distribuidor— deje el propietario como está.
                    <button name="action_actualizar_propietario_lote"
                            type="object"
                            string="Traspasar al cliente de la orden"
                            class="btn-link"
                            confirm="El equipo quedará a nombre del cliente de esta orden y se cerrará el período del propietario anterior en el historial. ¿Continuar?"/>
                </div>
            </notebook>

            <!-- Las pestañas son los cuatro momentos del trabajo, en orden, y se leen de
                 izquierda a derecha: Recepción · Diagnóstico · Reparación · Repuestos ·
                 Cierre. Antes tres de los cuatro eran pestañas y el primero vivía suelto en
                 la cabecera, repartido entre las dos columnas y mezclado con los campos
                 nativos de Odoo — así que la barra de pestañas no contaba el proceso. -->
            <notebook position="inside">
                <page string="Recepción" name="recepcion">
                    <!-- Es la única ventana en que hay a quién preguntarle: el cliente se va
                         y no vuelve. Los dos catálogos van con no_create porque en el mesón,
                         con el cliente esperando, es donde aparecen cuatro maneras de
                         escribir "no enciende" y el conteo se muere. Si falta una entrada se
                         agrega desde Configuración, que es una decisión y no un apuro. -->
                    <group>
                        <group string="Lo que dice el cliente">
                            <field name="falla_reportada"
                                   placeholder="Sus palabras, tal como las dijo."/>
                            <field name="sintoma_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="Lo que vio: no enciende, sin imagen, se apaga solo…"/>
                            <field name="componente_sospechado_ids"
                                   widget="many2many_tags"
                                   options="{'no_create': True}"
                                   placeholder="De qué sospecha, aunque no lo haya visto"/>
                        </group>
                        <group string="Lo que llegó">
                            <field name="mc_items_recibidos_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </page>
                <page string="Trabajos realizados" name="trabajos_realizados">
                    <!-- causa_raiz y responsable bajaron de la orden a la línea: una visita
                         puede tener tres causas distintas —umbilical cortado por accidente
                         y motor gastado por uso— y dos técnicos pueden trabajar la misma
                         orden. hallazgo_origen_id es lo que cierra el circuito con el
                         revisión de recepción. -->
                    <field name="linea_falla_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="componente_id"/>
                            <field name="subtipo_id" domain="[('componente_id', '=', componente_id)]"/>
                            <field name="accion_id"/>
                            <field name="hallazgo_origen_id"
                                   domain="[('lot_id', '=', parent.lot_id)]"
                                   optional="show"/>
                            <field name="origen" optional="show"/>
                            <field name="responsable_id" optional="show"/>
                            <field name="fecha"/>
                            <field name="horas" class="text-start" sum="Total HH."/>
                            <field name="detalle"/>
                            <!-- Solo de lectura: qué lección alimentó este trabajo.
                                 **Aquí hubo un botón para levantarla, y se retiró en
                                 19.0.15.5.0.** No por ruido sino porque hacía daño: la cola
                                 de Lecciones pendientes muestra los trabajos con
                                 `mc_alerta_id` vacío, así que un clic distraído del técnico
                                 le escondía la evidencia al supervisor, en silencio.

                                 Y sobraba igual: quien cierra una reparación no es quien
                                 puede decir qué se cambia para todos los equipos del
                                 modelo. Esa decisión se toma en la cola, con varios
                                 trabajos a la vista. -->
                            <field name="mc_alerta_id" optional="hide" readonly="1"/>
                        </list>
                    </field>
                </page>
                <page string="Revisiones" name="revisiones">
                    <!-- El historial completo del equipo, que esta pestaña no muestra: aquí
                         viven las revisiones de ESTA visita. La comparación que el diseño
                         pide —contra la visita anterior— necesitaba salir a buscar el número
                         de serie a mano. -->
                    <div class="mb-2">
                        <button name="action_ver_revisiones_del_equipo" type="object"
                                string="Ver todas las revisiones del equipo"
                                class="btn-link" icon="fa-history"
                                invisible="not lot_id"/>
                    </div>
                    <!-- Se llamó "Diagnóstico" un rato, para que la barra de pestañas se
                         leyera como el proceso. Se revirtió porque dejaba dos nombres para
                         una misma cosa: la pestaña decía Diagnóstico y adentro cada registro
                         decía REV/00006 — Revisión técnica.
                         Y "revisión" es además el nombre preciso: la de fabricación no
                         diagnostica nada, y la segunda de una visita comprueba en vez de
                         diagnosticar. Lo que nombra el paso es la línea de abajo. -->
                    <div class="text-muted mb-2">
                        Acá se diagnostica el equipo: se corre la batería completa y se anota
                        lo que se encuentra. Una segunda revisión sirve para comprobar que la
                        reparación funcionó, o para comparar con otro umbilical.
                    </div>
                    <!-- La revisión de esta visita. Normalmente una sola, y se abre sola al
                         confirmar la orden; el botón es para el segundo pase, cuando el
                         equipo se prueba, se arregla y se vuelve a probar.

                         El botón va en su propio div y no dentro de un group: un group es
                         una tabla de pares etiqueta/campo, y un botón ocupa una celda
                         suelta que desincroniza todo lo que venga después (ver PR #10). -->
                    <!-- Sin número de serie no hay a qué equipo asociarle la revisión, y el
                         botón se esconde. Sin este aviso la pestaña se ve vacía y parece
                         rota. -->
                    <div class="alert alert-info" role="alert" invisible="lot_id">
                        Elija el producto y el número de serie para poder crear una revisión.
                    </div>
                    <div class="mb-3">
                        <button name="action_nueva_revision" type="object"
                                string="Nueva revisión" class="btn-primary"
                                invisible="not lot_id"/>
                    </div>
                    <!-- El campo queda readonly para que no se creen ni borren revisiones
                         desde aquí, y el botón «Abrir» lleva a cada una a su propio
                         formulario, con su cabecera, sus cuatro pestañas y su chatter.

                         **Antes decía `open_form_view` y este comentario afirmaba que eso
                         agregaba el enlace, dándolo por validado en producción. Nació falso.**
                         El fuente de Odoo 19 lo ignora si la lista no es `editable` y lo
                         evalúa a `false` en silencio —ver
                         `web/static/src/views/list/list_arch_parser.js`— y esta lista nunca lo
                         fue. Lo comprobó Paulo en pantalla el 2026-08-25. -->
                    <field name="revision_ids" readonly="1">
                        <list>
                            <field name="name"/>
                            <field name="tipo"/>
                            <field name="numero_en_visita" optional="show"/>
                            <field name="fecha"/>
                            <field name="responsable_id"/>
                            <field name="resultado"
                                   decoration-danger="resultado == 'rechazado'"
                                   decoration-warning="resultado == 'aprobado_con_observaciones'"
                                   decoration-success="resultado == 'aprobado'"/>
                            <field name="estado"/>
                            <button name="action_abrir" type="object" string="Abrir"
                                    class="btn-link"/>
                        </list>
                    </field>
                </page>
                <page string="Cierre" name="resultado">
                    <group>
                        <group>
                            <field name="fecha_entrega_real"/>
                        </group>
                        <group/>
                    </group>

                    <!-- El origen y su análisis se contestan acá y no en "Trabajos
                         realizados", aunque el campo viva en la misma línea. Dos razones:
                         esa pestaña es donde se anota MIENTRAS se trabaja —y ahí el origen
                         todavía es especulación—, y su lista ya lleva diez columnas, así que
                         un campo de texto como columna doce no lo llena nadie.

                         create="0" delete="0": de la pantalla de cierre no se crean ni se
                         borran trabajos. Eso además garantiza que las dos listas sobre la
                         misma relación nunca emitan comandos en conflicto en un guardado.

                         El aviso explica por qué la lista puede estar vacía: una visita de
                         diagnóstico puro no registra trabajos, y esa orden se cierra igual. -->
                    <separator string="Por qué pasó"/>
                    <div class="text-muted mb-2">
                        El origen es lo que decide si la reparación la paga la empresa o el
                        cliente, y sin él la orden no se cierra. «No determinado» es una
                        respuesta válida.
                    </div>
                    <field name="linea_falla_cierre_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="componente_id" readonly="1"/>
                            <field name="accion_id" readonly="1"/>
                            <field name="origen"/>
                            <field name="analisis_causa"
                                   placeholder="Por qué pasó. Dos frases si es evidente; la cadena completa si no lo es."/>
                        </list>
                    </field>
                    <!-- Este campo es lo que se le informa al cliente en la entrega, y es
                         lo que sale impreso. Los hallazgos internos no van aquí: viven
                         estructurados en la revisión. -->
                    <field name="observaciones_salida"
                           placeholder="Lo que se le informa al cliente en la entrega."/>
                </page>
            </notebook>

            <!-- Reordenamiento al flujo real del taller: se registra lo que se hizo,
                 después lo que se consumió, después el cierre, y las notas al final.

                 El orden anterior no era una decisión: el notebook position="inside" de
                 arriba pega al final, así que las dos páginas de Odoo quedaban delante
                 por omisión. El efecto era que "Notas de reparación" se metía entre
                 Trabajos realizados y Piezas, que son justamente las dos que hay que
                 llenar de forma consistente entre sí — una línea de "cambio" exige el
                 repuesto correspondiente.

                 Cada move va en su propia operación de nivel superior. Odoo solo ejecuta
                 position="move" cuando es hijo directo de una operación de posición;
                 anidado más adentro lo ignora en silencio (ver PR #12). -->
            <xpath expr="//page[@name='parts']" position="before">
                <xpath expr="//page[@name='trabajos_realizados']" position="move"/>
            </xpath>

            <xpath expr="//page[@name='trabajos_realizados']" position="before">
                <xpath expr="//page[@name='revisiones']" position="move"/>
            </xpath>

            <!-- Y Recepción antes que Diagnóstico, que es el orden real: primero llega el
                 equipo y se registra lo que el cliente cuenta, después se abre y se prueba.
                 Hasta 19.0.14.0.0 el paso 1 no era una pestaña, así que la barra empezaba
                 por el 2 y el proceso no se leía. -->
            <xpath expr="//page[@name='revisiones']" position="before">
                <xpath expr="//page[@name='recepcion']" position="move"/>
            </xpath>

            <xpath expr="//page[@name='resultado']" position="after">
                <xpath expr="//page[@name='repair_notes']" position="move"/>
            </xpath>

        </field>
    </record>

    <record id="view_repair_order_list_mc_rov" model="ir.ui.view">
        <field name="name">repair.order.list.mc.rov</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="tipo_intervencion_ids" widget="many2many_tags"/>
                <!-- El sum al pie: la columna existía desde 19.0.5.2.0 y el campo se
                     almacenó justamente para poder agregarlo, pero el total nunca se puso. -->
                <field name="mc_total_horas" sum="Total HH."/>
            </field>
        </field>
    </record>

    <!-- El módulo no tenía vista de búsqueda propia sobre repair.order. La base se llama
         `repair.view_repair_order_form_filter`. -->
    <record id="view_repair_order_search_mc_rov" model="ir.ui.view">
        <field name="name">repair.order.search.mc.rov</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form_filter"/>
        <field name="arch" type="xml">

            <!-- Todo va anclado en la raíz `<search>` y no después de un campo o un filtro
                 concreto de la vista base. No es pereza: el único dato que tenemos
                 confirmado del arch base es el nombre del último filtro de agrupaciones
                 (`group_by_repair_properties`), y adivinar el nombre de un elemento del arch
                 de un módulo estándar ya rompió este módulo una vez. Odoo reparte los ítems
                 entre "Filtros" y "Agrupar por" según lo que cada uno es —dominio o
                 group_by— y no según dónde estén escritos, así que anclar en la raíz no
                 cambia dónde salen. -->
            <search position="inside">
                <field name="tipo_intervencion_ids"/>
                <field name="sintoma_ids"/>
                <field name="componente_sospechado_ids"/>

                <!-- El síntoma es opcional a propósito —obligarlo produciría inventos— y el
                     precio es que el análisis de "reportado vs real" puede quedarse sin datos
                     sin que nadie se entere. Este filtro es lo que lo hace visible, igual que
                     "Ficha incompleta" en los números de serie.

                     Acotado a órdenes abiertas, y esa parte no es cosmética: una serie
                     incompleta se puede completar cualquier día, pero una orden cerrada hace
                     un año no —el cliente ya no está—. Sin el acote el filtro arrastraría
                     todo el histórico para siempre, nunca llegaría a cero, y un filtro que
                     nunca llega a cero se deja de mirar. -->
                <separator/>
                <filter name="filtro_sin_sintoma"
                        string="Sin síntoma registrado"
                        domain="[('sintoma_ids', '=', False), ('state', 'not in', ['done', 'cancel'])]"
                        help="Órdenes todavía abiertas en las que no se registró qué dijo el cliente."/>
                <!-- La revisión a medio llenar se muestra en vez de bloquear el cierre. A
                     diferencia del filtro de arriba, este SÍ puede llegar a cero: la revisión
                     se confirma cualquier día, el equipo no se fue a ninguna parte. Si con el
                     tiempo acumula una pila, esa es la evidencia para pasar a bloquear. -->
                <filter name="filtro_revision_pendiente"
                        string="Revisión sin confirmar"
                        domain="[('mc_revision_pendiente', '=', True)]"
                        help="Visitas con alguna revisión técnica todavía en borrador."/>

                <!-- No hay "agrupar por origen", aunque estaba anotado como pendiente: desde
                     19.0.8.0.0 el origen vive en la línea de trabajo y no en la orden. Una
                     orden con tres trabajos tiene tres orígenes, y agruparla por uno exigiría
                     el campo derivado que elegiría uno y botaría los otros dos en silencio. -->
                <filter name="agrupar_tipo_intervencion"
                        string="Tipo de intervención"
                        context="{'group_by': 'tipo_intervencion_ids'}"/>
            </search>

        </field>
    </record>

</odoo>
