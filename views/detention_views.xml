<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_detention_wizard" model="ir.ui.view">
        <field name="name">mc.rov.detention.wizard.form</field>
        <field name="model">mc.rov.detention.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="decision" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <p invisible="decision != 'start'">Registre una detención solo si el trabajo no puede avanzar.</p>
                <group>
                    <field name="repair_id" invisible="not repair_id" force_save="1"/>
                    <field name="production_id" invisible="not production_id" force_save="1"/>
                    <field name="cause" invisible="decision != 'start'" required="decision == 'start'"/>
                    <field name="responsible_employee_id" invisible="decision != 'start'" required="decision == 'start'"
                           domain="[('company_id', '=', company_id)]"
                           options="{'no_create': True, 'no_open': True}"/>
                    <field name="option_ids" invisible="1"/>
                    <field name="option_id" invisible="decision != 'finish'" required="decision == 'finish'"
                           domain="[('id', 'in', option_ids)]" options="{'no_create': True, 'no_open': True}"/>
                    <field name="explanation" required="decision == 'start' and cause == 'other'"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Registrar detención" class="btn-primary"
                            invisible="decision != 'start'"/>
                    <button name="action_apply" type="object" string="Registrar reanudación" class="btn-primary"
                            invisible="decision != 'finish'"/>
                    <button special="cancel" string="Volver"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="view_repair_detentions" model="ir.ui.view">
        <field name="name">repair.order.detentions</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="mc_detentions" string="Detenciones" groups="base.group_user">
                    <field name="mc_detention_can_start" invisible="1"/>
                    <field name="mc_detention_can_finish" invisible="1"/>
                    <button name="action_open_detention_start" type="object" string="Registrar detención"
                            invisible="not mc_detention_can_start" class="btn-secondary"/>
                    <button name="action_open_detention_finish" type="object" string="Registrar reanudación"
                            invisible="not mc_detention_can_finish" class="btn-secondary"/>
                    <field name="mc_detention_history_html" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_production_detentions" model="ir.ui.view">
        <field name="name">mrp.production.detentions</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="inside">
                <page name="mc_detentions" string="Detenciones" groups="base.group_user">
                    <field name="mc_detention_can_start" invisible="1"/>
                    <field name="mc_detention_can_finish" invisible="1"/>
                    <button name="action_open_detention_start" type="object" string="Registrar detención"
                            invisible="not mc_detention_can_start" class="btn-secondary"/>
                    <button name="action_open_detention_finish" type="object" string="Registrar reanudación"
                            invisible="not mc_detention_can_finish" class="btn-secondary"/>
                    <field name="mc_detention_history_html" nolabel="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
