<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mc_rov_descarte_wizard_form" model="ir.ui.view">
        <field name="name">mc.rov.descarte.wizard.form</field>
        <field name="model">mc.rov.descarte.wizard</field>
        <field name="arch" type="xml">
            <form string="Descartar candidatas a lección">
                <!-- El asistente se abre encima de la lista y tapa justamente las filas que
                     hay que mirar, así que las repite. Sin esto hay que cerrarlo para
                     comprobar qué se marcó. -->
                <div class="alert alert-info" role="alert">
                    Estos trabajos salen de la cola de lecciones. Siguen en su orden de
                    reparación: lo que se descarta es la idea de convertirlos en una lección
                    del modelo, no el trabajo.
                </div>
                <group>
                    <field name="linea_ids" invisible="1"/>
                    <field name="resumen" nolabel="1" readonly="1"/>
                </group>
                <group>
                    <field name="motivo"
                           placeholder="Ej.: fue un accidente puntual, no un problema del modelo"/>
                </group>
                <footer>
                    <button name="action_descartar" type="object"
                            string="Descartar" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
