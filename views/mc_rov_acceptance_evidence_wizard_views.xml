<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_acceptance_evidence_wizard_form" model="ir.ui.view">
        <field name="name">mc.rov.acceptance.evidence.wizard.form</field>
        <field name="model">mc.rov.acceptance.evidence.wizard</field>
        <field name="arch" type="xml">
            <form string="Pruebas de aceptación">
                <group col="2">
                    <field name="lot_id" readonly="1" options="{'no_create': True}"/>
                </group>
                <div class="text-muted mb-3">
                    <field name="summary" nolabel="1"/>
                </div>
                <group col="2">
                    <label for="rnd_id"/>
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-sm">
                            <field name="rnd_id" nolabel="1" options="{'no_create': True}" domain="[('lot_id', '=', lot_id), ('tipo', '=', 'rendimiento'), ('repair_id', '=', False)]"/>
                        </div>
                        <div class="col-12 col-sm-auto">
                            <button name="action_new_performance" type="object" string="Nueva prueba de rendimiento" class="btn-secondary"/>
                        </div>
                    </div>
                    <label for="trn_id"/>
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-sm">
                            <field name="trn_id" nolabel="1" options="{'no_create': True}" domain="[('lot_id', '=', lot_id), ('tipo', '=', 'terreno'), ('repair_id', '=', False)]"/>
                        </div>
                        <div class="col-12 col-sm-auto">
                            <button name="action_new_field" type="object" string="Nueva prueba en terreno" class="btn-secondary"/>
                        </div>
                    </div>
                    <field name="reason" placeholder="Explique el reemplazo o retiro de una prueba"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Guardar selección" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
