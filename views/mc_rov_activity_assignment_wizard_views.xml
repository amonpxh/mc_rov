<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_activity_assignment_wizard" model="ir.ui.view">
        <field name="name">mc.rov.activity.assignment.wizard.form</field>
        <field name="model">mc.rov.activity.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Repartir actividades">
                <p>Marque únicamente los campos que quiere cambiar. Los demás conservan su valor.</p>
                <group>
                    <field name="activity_ids" widget="many2many_tags" readonly="1"/>
                    <field name="apply_user"/>
                    <field name="user_id" invisible="not apply_user" required="apply_user" options="{'no_create': True}"/>
                    <field name="apply_employee"/>
                    <field name="employee_id" invisible="not apply_employee" options="{'no_create': True, 'no_open': True}"/>
                    <field name="apply_deadline"/>
                    <field name="date_deadline" invisible="not apply_deadline" required="apply_deadline"/>
                    <field name="reason" placeholder="Explique la reasignación o reprogramación"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Aplicar cambios" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_repartir_actividades" model="ir.actions.server">
        <field name="name">Repartir actividades</field>
        <field name="model_id" ref="mail.model_mail_activity"/>
        <field name="binding_model_id" ref="mail.model_mail_activity"/>
        <field name="binding_view_types">list,form</field>
        <field name="group_ids" eval="[Command.link(ref('group_work_assignment_coordinate'))]"/>
        <field name="state">code</field>
        <field name="code">action = env['mc.rov.work.assignment'].action_assign(records.ids)</field>
    </record>
</odoo>
