<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Una sola entrada en Configuración en vez de cinco sueltas. Para el uso diario no
         hace falta entrar aquí: si el técnico necesita un hallazgo que no existe, escribe
         el nombre en el campo y Odoo le ofrece crearlo ahí mismo. Este menú es para
         mantener el catálogo —reordenar, desactivar ROVControl cuando llegue Crabby— no
         para usarlo. -->
    <menuitem
        id="menu_mc_rov_catalogos"
        name="Catálogos ROV"
        parent="repair.repair_menu_config"
        sequence="20"/>

    <menuitem
        id="menu_mc_rov_componentes"
        name="Componentes ROV"
        parent="menu_mc_rov_catalogos"
        action="action_mc_rov_componente"
        sequence="20"/>
    <menuitem
        id="menu_mc_rov_acciones"
        name="Acciones ROV"
        parent="menu_mc_rov_catalogos"
        action="action_mc_rov_accion"
        sequence="21"/>
    <menuitem
        id="menu_mc_rov_tipos_intervencion"
        name="Tipos de intervención ROV"
        parent="menu_mc_rov_catalogos"
        action="action_mc_rov_tipo_intervencion"
        sequence="22"/>
    <menuitem
        id="menu_mc_rov_chequeos"
        name="Pasos de testeo ROV"
        parent="menu_mc_rov_catalogos"
        action="action_mc_rov_chequeo"
        sequence="23"/>
    <menuitem
        id="menu_mc_rov_hallazgos"
        name="Hallazgos ROV"
        parent="menu_mc_rov_catalogos"
        action="action_mc_rov_hallazgo"
        sequence="24"/>

    <!-- Estos dos son vocabulario de la ficha de FABRICACIÓN, que vive en el número de
         serie. Colgarlos de Reparaciones obligaba a manufactura a entrar al módulo
         equivocado para agregar un software. -->
    <menuitem
        id="menu_mc_rov_software_superficie"
        name="Software de superficie ROV"
        parent="stock.menu_stock_config_settings"
        action="action_mc_rov_software_superficie"
        sequence="25"/>
    <menuitem
        id="menu_mc_rov_controlador_vuelo"
        name="Controladores de vuelo ROV"
        parent="stock.menu_stock_config_settings"
        action="action_mc_rov_controlador_vuelo"
        sequence="26"/>

    <!-- Las revisiones van al menú principal de Reparaciones y no a Configuración: son
         registros de trabajo diario, no catálogo. Entre Órdenes y Reporting, que ocupa la
         secuencia 15.

         Las de fabricación no tienen menú propio: se crean con un botón desde el número
         de serie, que es donde manufactura ya trabaja. Un menú global solo serviría para
         verlas todas juntas, y esa pregunta no la tiene nadie. -->
    <menuitem
        id="menu_mc_rov_revisiones"
        name="Revisiones técnicas"
        parent="repair.menu_repair_order"
        action="action_mc_rov_revision"
        sequence="12"/>
</odoo>
