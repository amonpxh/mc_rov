<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Una sola entrada en Configuración en vez de cinco sueltas. Este menú es para
         mantener los catálogos: reordenar, desactivar ROVControl cuando llegue Crabby,
         agregar una entrada que faltaba.

         **No todos los catálogos se comportan igual, y conviene saber cuál es cuál.** En
         hallazgos y componentes el técnico todavía puede crear una entrada escribiendo el
         nombre en el campo; en síntomas y en la sospecha del cliente no, porque esos se
         llenan en el mesón con el cliente esperando y ahí es donde aparecen cuatro formas de
         escribir "no enciende". Cerrar los otros dos es una decisión aparte, todavía no
         tomada (ver `docs/designs/diagnostico-de-fallas.md` § 7.4). -->
    <menuitem
        id="menu_mc_rov_catalogos"
        name="Catálogos ROV"
        parent="repair.repair_menu_config"
        sequence="20"/>

    <menuitem
        id="menu_mc_rov_componentes"
        name="Componentes ROV"
        parent="menu_mc_rov_catalogos"
        action="action_mc_rov_componente"
        sequence="20"/>
    <menuitem
        id="menu_mc_rov_acciones"
        name="Acciones ROV"
        parent="menu_mc_rov_catalogos"
        action="action_mc_rov_accion"
        sequence="21"/>
    <menuitem
        id="menu_mc_rov_tipos_intervencion"
        name="Tipos de intervención ROV"
        parent="menu_mc_rov_catalogos"
        action="action_mc_rov_tipo_intervencion"
        sequence="22"/>
    <menuitem
        id="menu_mc_rov_chequeos"
        name="Pasos de testeo ROV"
        parent="menu_mc_rov_catalogos"
        action="action_mc_rov_chequeo"
        sequence="23"/>
    <menuitem
        id="menu_mc_rov_hallazgos"
        name="Hallazgos ROV"
        parent="menu_mc_rov_catalogos"
        action="action_mc_rov_hallazgo"
        sequence="24"/>
    <!-- Los síntomas van al lado de los hallazgos porque son su contraparte: lo que el
         cliente dice contra lo que el taller comprueba. A diferencia de los hallazgos, este
         catálogo SÍ hay que mantenerlo desde acá — el campo de la orden va con `no_create`,
         para que en el mesón nadie invente una cuarta forma de escribir "no enciende". -->
    <menuitem
        id="menu_mc_rov_sintomas"
        name="Síntomas ROV"
        parent="menu_mc_rov_catalogos"
        action="action_mc_rov_sintoma"
        sequence="25"/>

    <!-- Estos dos son vocabulario de la ficha de FABRICACIÓN, que vive en el número de
         serie. Colgarlos de Reparaciones obligaba a manufactura a entrar al módulo
         equivocado para agregar un software.

         Van bajo su propio "Catálogos ROV", igual que los de Reparaciones: sueltos entre
         las opciones de Inventario se leían como configuración de Odoo y no como listas
         nuestras. -->
    <menuitem
        id="menu_mc_rov_catalogos_stock"
        name="Catálogos ROV"
        parent="stock.menu_stock_config_settings"
        sequence="25"/>

    <menuitem
        id="menu_mc_rov_software_superficie"
        name="Software de superficie ROV"
        parent="menu_mc_rov_catalogos_stock"
        action="action_mc_rov_software_superficie"
        sequence="10"/>
    <menuitem
        id="menu_mc_rov_controlador_vuelo"
        name="Controladores de vuelo ROV"
        parent="menu_mc_rov_catalogos_stock"
        action="action_mc_rov_controlador_vuelo"
        sequence="20"/>

    <!-- Van al menú principal y no a Configuración: son registros de trabajo diario, no
         catálogo. Entre Órdenes y Reporting, que ocupa la secuencia 15.

         **Dos menús, dos nombres y dos alcances, desde 19.0.22.1.0.** Las pruebas cuelgan del
         número de serie y los números de serie viven en Inventario, así que pedirle a
         manufactura que entre por Reparaciones para ver las pruebas de un equipo nuevo es
         mandarla al módulo equivocado. Pero tampoco es la misma lista dos veces: desde
         Reparaciones la pregunta es qué pasó en las visitas al taller y las de rendimiento
         sobran; desde Inventario la pregunta es qué se le ha hecho al equipo y entran las
         tres. Un solo nombre para las dos habría sido una lista llamada de dos formas.

         En Reparaciones el nombre se queda como estaba: ahí el vocabulario es «revisión»
         desde que existe el módulo, y cambiarlo por cambiarlo le rompe la memoria a quien ya
         sabe dónde entrar. -->
    <menuitem
        id="menu_mc_rov_revisiones"
        name="Revisiones técnicas"
        parent="repair.menu_repair_order"
        action="action_mc_rov_revision"
        sequence="12"/>

    <menuitem
        id="menu_mc_rov_revisiones_inventario"
        name="Pruebas realizadas"
        parent="stock.menu_stock_inventory_control"
        action="action_mc_rov_prueba_realizada"
        sequence="12"/>
</odoo>
