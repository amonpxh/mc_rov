<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mc_rov_revision_form" model="ir.ui.view">
        <field name="name">mc.rov.revision.form</field>
        <field name="model">mc.rov.revision</field>
        <field name="arch" type="xml">
            <form string="Revisión técnica">
                <header>
                    <button name="action_confirmar" type="object" string="Confirmar"
                            class="btn-primary" invisible="estado != 'borrador'"/>
                    <button name="action_volver_a_borrador" type="object"
                            string="Volver a borrador"
                            invisible="estado != 'confirmado'"/>
                    <!-- Para las fichas que se abrieron antes de que el catálogo cambiara:
                         el checklist se copia al crear la revisión, y la revisión se crea
                         cuando el equipo entra al taller. Sin este botón, un chequeo nuevo
                         solo alcanza a los equipos que lleguen después. -->
                    <button name="action_actualizar_checklist" type="object"
                            string="Actualizar checklist"
                            invisible="estado != 'borrador'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,confirmado"/>
                </header>
                <sheet>
                    <!-- El resultado es lo primero que alguien quiere saber al abrir una
                         ficha, y es derivado: se lee, no se decide. -->
                    <widget name="web_ribbon" title="Rechazado" bg_color="text-bg-danger"
                            invisible="resultado != 'rechazado'"/>
                    <widget name="web_ribbon" title="Con observaciones" bg_color="text-bg-warning"
                            invisible="resultado != 'aprobado_con_observaciones'"/>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group>
                            <field name="lot_id" readonly="estado == 'confirmado'"/>
                            <field name="es_un_rov" invisible="1"/>
                            <field name="product_id"/>
                            <field name="propietario_id"/>
                            <field name="partner_id" invisible="not repair_id"/>
                        </group>
                        <group>
                            <field name="tipo" readonly="estado == 'confirmado'"/>
                            <field name="fecha" readonly="estado == 'confirmado'"/>
                            <field name="responsable_id" required="1"
                                   readonly="estado == 'confirmado'"/>
                            <field name="repair_id" readonly="estado == 'confirmado'"/>
                            <field name="horas_operacion" readonly="estado == 'confirmado'"/>
                            <field name="resultado" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Corridas" name="page_corridas">
                            <!-- Normalmente una; dos cuando se usa el umbilical de prueba
                                 como muestra de control. La comparación entre ambas es lo
                                 que aísla el cable como fuente de falla. -->
                            <field name="corrida_ids" readonly="estado == 'confirmado'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="umbilical"/>
                                    <field name="largo"/>
                                    <field name="alimentacion"/>
                                    <field name="tension_salida"/>
                                    <field name="esfuerzo_duracion"/>
                                    <field name="esfuerzo_resultado"/>
                                    <field name="subida"/>
                                    <field name="bajada"/>
                                </list>
                            </field>
                        </page>

                        <page string="Sellos" name="page_sellos"
                              invisible="tipo != 'reparacion'">
                            <!-- Una fila por componente sellado, y siempre el estado con
                                 que LLEGÓ el equipo. Antes eso lo garantizaba tener una
                                 revisión de recepción aparte; ahora que la visita lleva una
                                 sola ficha, lo garantizan el nombre del campo y este aviso.
                                 Es la diferencia entre registrar manipulación de terceros y
                                 registrar el trabajo propio como si lo fuera. -->
                            <div class="alert alert-info" role="alert">
                                Anote el estado en que <strong>llegó</strong> cada sello, antes
                                de tocar el equipo. Un sello roto o ausente al recibir
                                significa que alguien más lo abrió: los sellos que rompe el
                                taller se rompen después, durante el trabajo, y no van aquí.
                            </div>
                            <field name="inspeccion_ids" readonly="estado == 'confirmado'">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="componente_id" readonly="1"/>
                                    <field name="estado_sello" widget="radio"
                                           options="{&quot;horizontal&quot;: true}"/>
                                    <field name="observacion"/>
                                    <field name="manipulacion_externa" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="Pruebas" name="page_chequeos">
                            <!-- Un bloque por sección, como la hoja de papel: "Prueba de
                                 video" con cámara y tilt, "Prueba de navegación" con las
                                 hélices y los dos movimientos. Son siete vistas de las
                                 mismas líneas de chequeo_ids, separadas por dominio.

                                 Ni crear ni borrar: la batería la genera el sistema. Si el
                                 técnico pudiera agregar filas, la ausencia de una fila
                                 dejaría de significar algo, y distinguir "revisado y
                                 limpio" de "no se me ocurrió mirarlo" es todo el punto de
                                 un checklist. Los pasos se administran en Reparaciones →
                                 Configuración → Catálogos ROV → Pasos de testeo ROV.

                                 Cada bloque se esconde cuando su sección no trae chequeos
                                 para este tipo de revisión: un título con una lista vacía
                                 debajo se lee como algo roto.

                                 El colspan="2" no es decorativo: un group es una tabla de
                                 dos columnas, así que sin él la lista ocupa media página y
                                 el nombre del chequeo sale cortado ("Estanqueid..."), con
                                 un ancho distinto en cada sección porque cada tabla se
                                 dimensiona sola. -->
                            <group string="Inspección física"
                                   invisible="not chequeo_inspeccion_fisica_ids">
                                <field name="chequeo_inspeccion_fisica_ids" nolabel="1" class="mc_rov_pruebas"
                                       colspan="2" readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <field name="componente_id" readonly="1"
                                               optional="show"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                            </group>

                            <group string="Prueba de presión" invisible="not chequeo_presion_ids">
                                <field name="chequeo_presion_ids" nolabel="1" class="mc_rov_pruebas"
                                       colspan="2" readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                            </group>

                            <group string="Prueba de leak" invisible="not chequeo_leak_ids">
                                <field name="chequeo_leak_ids" nolabel="1" class="mc_rov_pruebas"
                                       colspan="2" readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                            </group>

                            <group string="Prueba de navegación"
                                   invisible="not chequeo_navegacion_ids">
                                <field name="chequeo_navegacion_ids" nolabel="1" class="mc_rov_pruebas"
                                       colspan="2" readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                            </group>

                            <group string="Prueba de video" invisible="not chequeo_video_ids">
                                <field name="chequeo_video_ids" nolabel="1" class="mc_rov_pruebas"
                                       colspan="2" readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                            </group>

                            <!-- La prueba de luces es un conteo y no un OK / No OK: se
                                 cuentan las que encienden. El total sale solo y se compara
                                 contra la ficha del equipo. -->
                            <group string="Prueba de luces">
                                <group>
                                    <field name="luces_internas" readonly="estado == 'confirmado'"/>
                                    <field name="luces_externas" readonly="estado == 'confirmado'"/>
                                </group>
                                <group>
                                    <field name="luces_total"/>
                                    <field name="luces_ficha"/>
                                    <field name="luces_difieren" invisible="1"/>
                                </group>
                                <field name="chequeo_luces_ids" nolabel="1" class="mc_rov_pruebas" colspan="2"
                                       invisible="not chequeo_luces_ids"
                                       readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                            </group>
                            <div class="alert alert-warning" role="alert"
                                 invisible="not luces_difieren">
                                El conteo de luces de la prueba no coincide con la ficha del
                                equipo. O el equipo perdió luces, o la ficha está mal.
                            </div>

                            <group string="Otras pruebas" invisible="not chequeo_otro_ids">
                                <field name="chequeo_otro_ids" nolabel="1" class="mc_rov_pruebas"
                                       colspan="2" readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <field name="componente_id" readonly="1"
                                               optional="hide"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <page string="Hallazgos" name="page_hallazgos">
                            <field name="hallazgo_ids" readonly="estado == 'confirmado'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="componente_id"/>
                                    <field name="subtipo_id"
                                           domain="[('componente_id', '=', componente_id)]"/>
                                    <field name="hallazgo_id"/>
                                    <field name="severidad"/>
                                    <field name="chequeo_origen_id"
                                           domain="[('revision_id', '=', parent.id)]"
                                           optional="show"/>
                                    <field name="detalle"/>
                                </list>
                            </field>
                        </page>

                        <!-- Las condiciones en que se corrió la batería, no sus resultados.
                             El conteo de luces se fue a Pruebas, con el resto de la hoja. -->
                        <page string="Condiciones" name="page_mediciones">
                            <group>
                                <group string="Temperatura">
                                    <field name="temperatura_interior" readonly="estado == 'confirmado'"/>
                                    <field name="temperatura_exterior" readonly="estado == 'confirmado'"/>
                                </group>
                                <group/>
                            </group>
                            <group string="Prueba en terreno" invisible="tipo != 'terreno'">
                                <group>
                                    <field name="lugar" readonly="estado == 'confirmado'"/>
                                    <field name="profundidad" readonly="estado == 'confirmado'"/>
                                </group>
                                <group>
                                    <field name="velocidad_corriente" readonly="estado == 'confirmado'"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_mc_rov_revision_list" model="ir.ui.view">
        <field name="name">mc.rov.revision.list</field>
        <field name="model">mc.rov.revision</field>
        <field name="arch" type="xml">
            <list string="Revisiones técnicas">
                <field name="name"/>
                <field name="fecha"/>
                <field name="lot_id"/>
                <field name="product_id" optional="show"/>
                <field name="tipo"/>
                <field name="responsable_id" optional="show"/>
                <field name="repair_id" optional="hide"/>
                <field name="horas_operacion" optional="hide"/>
                <field name="resultado"
                       decoration-danger="resultado == 'rechazado'"
                       decoration-warning="resultado == 'aprobado_con_observaciones'"
                       decoration-success="resultado == 'aprobado'"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="view_mc_rov_revision_search" model="ir.ui.view">
        <field name="name">mc.rov.revision.search</field>
        <field name="model">mc.rov.revision</field>
        <field name="arch" type="xml">
            <search string="Buscar revisiones">
                <field name="name"/>
                <field name="lot_id"/>
                <field name="responsable_id"/>
                <filter name="filtro_borrador" string="Borradores"
                        domain="[('estado', '=', 'borrador')]"/>
                <filter name="filtro_rechazados" string="Rechazados"
                        domain="[('resultado', '=', 'rechazado')]"/>
                <separator/>
                <filter name="filtro_reparacion" string="Reparación"
                        domain="[('tipo', '=', 'reparacion')]"/>
                <filter name="filtro_terreno" string="Prueba en terreno"
                        domain="[('tipo', '=', 'terreno')]"/>
                <filter name="filtro_fabricacion" string="Fabricación"
                        domain="[('tipo', '=', 'fabricacion')]"/>
                <!-- El group va pelado: el schema de vistas de búsqueda de Odoo 19 rechaza
                     expand y string en este elemento. Misma forma que el arch base de
                     repair.view_repair_order_form_filter. -->
                <group>
                    <filter name="group_equipo" string="Equipo"
                            context="{'group_by': 'lot_id'}"/>
                    <filter name="group_tipo" string="Tipo"
                            context="{'group_by': 'tipo'}"/>
                    <filter name="group_resultado" string="Resultado"
                            context="{'group_by': 'resultado'}"/>
                    <filter name="group_responsable" string="Responsable"
                            context="{'group_by': 'responsable_id'}"/>
                    <filter name="group_fecha" string="Fecha" context="{'group_by': 'fecha'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Dos acciones y no una: el taller no tiene por qué mirar las revisiones de
         fabricación, ni manufactura los de reparación. -->
    <record id="action_mc_rov_revision" model="ir.actions.act_window">
        <field name="name">Revisiones técnicas</field>
        <field name="res_model">mc.rov.revision</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('tipo', '!=', 'fabricacion')]</field>
        <field name="context">{'default_tipo': 'reparacion'}</field>
    </record>

    <record id="action_mc_rov_revision_fabricacion" model="ir.actions.act_window">
        <field name="name">Revisiones de fabricación</field>
        <field name="res_model">mc.rov.revision</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('tipo', '=', 'fabricacion')]</field>
        <field name="context">{'default_tipo': 'fabricacion'}</field>
    </record>

    <!-- ================= Catálogos ================= -->

    <record id="view_mc_rov_chequeo_list" model="ir.ui.view">
        <field name="name">mc.rov.chequeo.list</field>
        <field name="model">mc.rov.chequeo</field>
        <field name="arch" type="xml">
            <list string="Pasos de testeo" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="seccion"/>
                <field name="name"/>
                <field name="por_componente" optional="hide"/>
                <field name="aplica_fabricacion"/>
                <field name="aplica_reparacion"/>
                <field name="aplica_terreno"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_mc_rov_chequeo" model="ir.actions.act_window">
        <field name="name">Pasos de testeo ROV</field>
        <field name="res_model">mc.rov.chequeo</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_mc_rov_hallazgo_list" model="ir.ui.view">
        <field name="name">mc.rov.hallazgo.list</field>
        <field name="model">mc.rov.hallazgo</field>
        <field name="arch" type="xml">
            <list string="Hallazgos" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="familia"/>
                <field name="name"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_mc_rov_hallazgo" model="ir.actions.act_window">
        <field name="name">Hallazgos ROV</field>
        <field name="res_model">mc.rov.hallazgo</field>
        <field name="view_mode">list</field>
    </record>

    <!-- ================= Catálogos de la ficha técnica ================= -->

    <record id="view_mc_rov_software_superficie_list" model="ir.ui.view">
        <field name="name">mc.rov.software.superficie.list</field>
        <field name="model">mc.rov.software.superficie</field>
        <field name="arch" type="xml">
            <list string="Software de superficie" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_mc_rov_software_superficie" model="ir.actions.act_window">
        <field name="name">Software de superficie ROV</field>
        <field name="res_model">mc.rov.software.superficie</field>
        <field name="view_mode">list</field>
    </record>

    <record id="view_mc_rov_controlador_vuelo_list" model="ir.ui.view">
        <field name="name">mc.rov.controlador.vuelo.list</field>
        <field name="model">mc.rov.controlador.vuelo</field>
        <field name="arch" type="xml">
            <list string="Controladores de vuelo" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_mc_rov_controlador_vuelo" model="ir.actions.act_window">
        <field name="name">Controladores de vuelo ROV</field>
        <field name="res_model">mc.rov.controlador.vuelo</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
