<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mc_rov_revision_form" model="ir.ui.view">
        <field name="name">mc.rov.revision.form</field>
        <field name="model">mc.rov.revision</field>
        <field name="arch" type="xml">
            <form string="Revisión técnica">
                <header>
                    <button name="action_confirmar" type="object" string="Confirmar"
                            class="btn-primary" invisible="estado != 'borrador'"/>
                    <button name="action_volver_a_borrador" type="object"
                            string="Volver a borrador"
                            invisible="estado != 'confirmado'"/>
                    <!-- Para las fichas que se abrieron antes de que el catálogo cambiara:
                         el checklist se copia al crear la revisión, y la revisión se crea
                         cuando el equipo entra al taller. Sin este botón, un chequeo nuevo
                         solo alcanza a los equipos que lleguen después. -->
                    <button name="action_actualizar_checklist" type="object"
                            string="Actualizar checklist"
                            invisible="estado != 'borrador'"/>
                    <field name="estado" widget="statusbar" statusbar_visible="borrador,confirmado"/>
                </header>
                <sheet>
                    <!-- El resultado es lo primero que alguien quiere saber al abrir una
                         ficha, y es derivado: se lee, no se decide. -->
                    <widget name="web_ribbon" title="Rechazado" bg_color="text-bg-danger"
                            invisible="resultado != 'rechazado'"/>
                    <widget name="web_ribbon" title="Con observaciones" bg_color="text-bg-warning"
                            invisible="resultado != 'aprobado_con_observaciones'"/>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <!-- Dos bloques con título, y `repair_id` a la izquierda desde
                         19.0.15.2.2. La cabecera quedaba en cuatro contra siete y se leía
                         como descuido; el corte real no es por cantidad sino por qué
                         describe cada columna —de qué equipo y de qué visita estamos
                         hablando, contra qué es esta revisión en particular—. La orden de
                         reparación es la visita, así que va junto al cliente de la orden y
                         de paso empareja los bloques en cinco y seis.

                         Mismo criterio que se aplicó a «Con qué se probó» / «Qué dio» en
                         19.0.15.1.0: dos columnas desparejas se leen como una decisión
                         cuando cada una dice qué contiene. -->
                    <group>
                        <group string="Equipo y visita">
                            <field name="lot_id" readonly="estado == 'confirmado'"/>
                            <field name="es_un_rov" invisible="1"/>
                            <field name="product_id"/>
                            <field name="propietario_id"/>
                            <field name="repair_id" readonly="estado == 'confirmado'"/>
                            <field name="partner_id" invisible="not repair_id"/>
                        </group>
                        <group string="Esta revisión">
                            <field name="tipo" readonly="estado == 'confirmado'"/>
                            <field name="fecha" readonly="estado == 'confirmado'"/>
                            <field name="responsable_id" required="1"
                                   readonly="estado == 'confirmado'"/>
                            <!-- Solo cuando hay visita: en una revisión de fabricación no
                                 hay reparación que comprobar ni cable que comparar. La
                                 primera de la visita trae "primer diagnóstico" por defecto;
                                 la que abre el botón nace vacía, para forzar la elección
                                 justo donde importa. -->
                            <field name="motivo" readonly="estado == 'confirmado'"
                                   invisible="not repair_id" required="repair_id"/>
                            <field name="horas_operacion" readonly="estado == 'confirmado'"/>
                            <field name="resultado" readonly="1"/>
                        </group>
                    </group>

                    <!-- Tres pestañas, en el orden en que ocurren las cosas: se miran los
                         sellos antes de tocar nada, se prueba, y se anota lo que se encontró.

                         Eran cinco hasta 19.0.14.0.0: "Corridas" se fusionó en Pruebas
                         —la corrida no es una prueba sino la condición bajo la cual se probó, y
                         ocurre en la misma sesión— y "Condiciones" desapareció con ella. -->
                    <notebook>
                        <page string="Sellos" name="page_sellos"
                              invisible="tipo != 'reparacion'">
                            <!-- Una fila por componente sellado, y siempre el estado con
                                 que LLEGÓ el equipo. Antes eso lo garantizaba tener una
                                 revisión de recepción aparte; ahora que la visita lleva una
                                 sola ficha, lo garantizan el nombre del campo y este aviso.
                                 Es la diferencia entre registrar manipulación de terceros y
                                 registrar el trabajo propio como si lo fuera. -->
                            <div class="alert alert-info" role="alert">
                                Anote el estado en que <strong>llegó</strong> cada sello, antes
                                de tocar el equipo. Un sello roto o ausente al recibir
                                significa que alguien más lo abrió: los sellos que rompe el
                                taller se rompen después, durante el trabajo, y no van aquí.
                            </div>
                            <field name="inspeccion_ids" readonly="estado == 'confirmado'">
                                <list editable="bottom" create="0" delete="0">
                                    <field name="componente_id" readonly="1"/>
                                    <field name="estado_sello" widget="radio"
                                           options="{&quot;horizontal&quot;: true}"/>
                                    <field name="detalle"/>
                                    <field name="manipulacion_externa" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="Pruebas" name="page_chequeos">
                            <!-- La corrida abre la pestaña porque es la CONDICIÓN de todo lo
                                 que viene abajo: con qué cable, con qué alimentación, y cuánto
                                 aguantó el funcionamiento continuo.

                                 Es una sola por revisión desde 19.0.15.0.0. Antes eran una
                                 lista, para poder comparar dos cables dentro de la misma
                                 ficha — pero las dos corridas compartían un solo juego de
                                 respuestas, así que cualquier chequeo que cambiara entre
                                 cables se perdía en silencio. Comparar dos cables son dos
                                 revisiones, cada una con su batería completa.

                                 Las temperaturas son dato interno y no salen impresas. -->
                            <!-- Dos bloques con título en vez de dos columnas parejas: que
                                 una tenga cuatro filas y la otra seis se lee como una decisión
                                 cuando cada una dice qué contiene, y como descuido cuando no.

                                 Los Selection van con radio horizontal: son de dos y tres
                                 valores, y un desplegable para elegir entre dos esconde la
                                 mitad de la respuesta detrás de un clic.

                                 Las unidades van al lado de la caja y no entre paréntesis en
                                 la etiqueta, que es el patrón nativo de Odoo. -->
                            <group>
                                <group string="Con qué se probó">
                                    <field name="umbilical" widget="radio"
                                           options="{&quot;horizontal&quot;: true}"
                                           readonly="estado == 'confirmado'"/>
                                    <!-- Solo para el cable del taller: el del equipo ya
                                         declara su largo en la ficha. -->
                                    <label for="largo" invisible="umbilical != 'prueba'"/>
                                    <div class="o_row" invisible="umbilical != 'prueba'">
                                        <field name="largo" readonly="estado == 'confirmado'"/>
                                        <span>m</span>
                                    </div>
                                    <field name="alimentacion" widget="radio"
                                           options="{&quot;horizontal&quot;: true}"
                                           readonly="estado == 'confirmado'"/>
                                    <label for="tension_salida"/>
                                    <div class="o_row">
                                        <field name="tension_salida" readonly="estado == 'confirmado'"/>
                                        <span>V</span>
                                    </div>
                                    <field name="modelo_fuente" readonly="estado == 'confirmado'"/>
                                    <!-- Cuánto duró la prueba entera, que no es la corrida de
                                         funcionamiento continuo de al lado: una prueba en
                                         terreno de tres horas puede no llevar corrida. -->
                                    <label for="duracion"/>
                                    <div class="o_row">
                                        <field name="duracion" readonly="estado == 'confirmado'"/>
                                        <span>h</span>
                                    </div>
                                </group>
                                <group string="Qué dio">
                                    <field name="funcionamiento_continuo_resultado" widget="radio"
                                           options="{&quot;horizontal&quot;: true}"
                                           readonly="estado == 'confirmado'"/>
                                    <label for="funcionamiento_continuo_duracion"/>
                                    <div class="o_row">
                                        <field name="funcionamiento_continuo_duracion" readonly="estado == 'confirmado'"/>
                                        <span>h</span>
                                    </div>
                                    <label for="subida"/>
                                    <div class="o_row">
                                        <field name="subida" readonly="estado == 'confirmado'"/>
                                        <span>Mbps</span>
                                    </div>
                                    <label for="bajada"/>
                                    <div class="o_row">
                                        <field name="bajada" readonly="estado == 'confirmado'"/>
                                        <span>Mbps</span>
                                    </div>
                                    <label for="temperatura_interior"/>
                                    <div class="o_row">
                                        <field name="temperatura_interior" readonly="estado == 'confirmado'"/>
                                        <span>°C</span>
                                    </div>
                                    <label for="temperatura_exterior"/>
                                    <div class="o_row">
                                        <field name="temperatura_exterior" readonly="estado == 'confirmado'"/>
                                        <span>°C</span>
                                    </div>
                                </group>
                            </group>

                            <group>
                                <!-- La medición al lado del chequeo, no en su lugar: quien
                                     dice si la estanqueidad aprobó es «Estanqueidad bajo
                                     presión», que responde OK / No OK / No aplica. Estos dos
                                     números lo acompañan y no opinan — sin umbral, porque los
                                     técnicos saben a cuánto va cada equipo (§ 5.6).

                                     En terreno no aplica: ahí la verificación de presión es la
                                     profundidad alcanzada, la misma pregunta por otro medio. -->
                                <group string="Estanqueidad" invisible="tipo == 'terreno'">
                                    <label for="presion_bar"/>
                                    <div class="o_row">
                                        <field name="presion_bar" readonly="estado == 'confirmado'"/>
                                        <span>bar</span>
                                    </div>
                                    <label for="presion_tiempo"/>
                                    <div class="o_row">
                                        <field name="presion_tiempo" readonly="estado == 'confirmado'"/>
                                        <span>h</span>
                                    </div>
                                </group>
                                <!-- Las tres juntas porque se leen juntas: una fuga alta con
                                     consumos normales dice algo distinto de una fuga alta con
                                     el consumo disparado. En terreno no hay instrumento. -->
                                <group string="Eléctrico" invisible="tipo == 'terreno'">
                                    <label for="fuga_corriente"/>
                                    <div class="o_row">
                                        <field name="fuga_corriente" readonly="estado == 'confirmado'"/>
                                        <span>A</span>
                                    </div>
                                    <label for="consumo_reposo"/>
                                    <div class="o_row">
                                        <field name="consumo_reposo" readonly="estado == 'confirmado'"/>
                                        <span>kWh</span>
                                    </div>
                                    <label for="consumo_carga"/>
                                    <div class="o_row">
                                        <field name="consumo_carga" readonly="estado == 'confirmado'"/>
                                        <span>kWh</span>
                                    </div>
                                </group>
                            </group>

                            <group>
                                <!-- Se miden donde se pueden ajustar. En reparación no se
                                     vuelven a medir: se muestran desde la ficha para ver si
                                     cambiaron, igual que las versiones de software. -->
                                <group string="Parámetros de trabajo" invisible="tipo == 'reparacion'">
                                    <field name="limitacion_pilot_gain" readonly="estado == 'confirmado'"/>
                                    <field name="ganancia_luz" readonly="estado == 'confirmado'"/>
                                </group>
                                <group string="Parámetros según la ficha" invisible="tipo != 'reparacion'">
                                    <field name="limitacion_pilot_gain_ficha"/>
                                    <field name="ganancia_luz_ficha"/>
                                </group>
                            </group>

                            <!-- En la prueba de banco el software va al revés que en
                                 reparación: no se compara contra la ficha, se anota lo que se
                                 instaló y la ficha lo recibe al confirmar. El equipo acaba de
                                 nacer y no hay contra qué comparar. -->
                            <group string="Software instalado" invisible="tipo != 'banco'">
                                <group>
                                    <field name="software_instalado_id" readonly="estado == 'confirmado'"/>
                                    <field name="version_software_instalada" readonly="estado == 'confirmado'"/>
                                    <field name="version_ardusub_instalada" readonly="estado == 'confirmado'"/>
                                </group>
                                <group>
                                    <field name="controlador_instalado_id" readonly="estado == 'confirmado'"/>
                                    <field name="version_controlador_instalada" readonly="estado == 'confirmado'"/>
                                </group>
                            </group>

                            <!-- Las condiciones del terreno van junto a las de la prueba
                                 por lo mismo: describen bajo qué se probó, no qué resultó.
                                 Solo aparecen cuando la revisión es de terreno. -->
                            <group string="Condiciones del terreno" invisible="tipo != 'terreno'">
                                <group>
                                    <field name="lugar" readonly="estado == 'confirmado'"/>
                                    <field name="profundidad" readonly="estado == 'confirmado'"/>
                                </group>
                                <group>
                                    <field name="velocidad_corriente" readonly="estado == 'confirmado'"/>
                                </group>
                            </group>

                            <!-- «Condiciones y notas» y no «Observaciones», a propósito: esa
                                 palabra invita a escribir aquí los hallazgos, y eso mataría el
                                 catálogo que costó dos versiones construir (§ 4.7). -->
                            <field name="condiciones_notas" readonly="estado == 'confirmado'"
                                   placeholder="La marea, que el cliente pidió cortar antes, que el generador andaba justo. Los hallazgos van en su pestaña."/>

                            <!-- Un bloque por sección, como la hoja de papel: "Prueba de
                                 video" con cámara y tilt, "Prueba de navegación" con las
                                 hélices y los dos movimientos. Son siete vistas de las
                                 mismas líneas de chequeo_ids, separadas por dominio.

                                 Ni crear ni borrar: la batería la genera el sistema. Si el
                                 técnico pudiera agregar filas, la ausencia de una fila
                                 dejaría de significar algo, y distinguir "revisado y
                                 limpio" de "no se me ocurrió mirarlo" es todo el punto de
                                 un checklist. Los pasos se administran en Reparaciones →
                                 Configuración → Catálogos ROV → Pasos de testeo ROV.

                                 Cada bloque se esconde cuando su sección no trae chequeos
                                 para este tipo de revisión: un título con una lista vacía
                                 debajo se lee como algo roto.

                                 El colspan="2" no es decorativo: un group es una tabla de
                                 dos columnas, así que sin él la lista ocupa media página y
                                 el nombre del chequeo sale cortado ("Estanqueid..."), con
                                 un ancho distinto en cada sección porque cada tabla se
                                 dimensiona sola. -->
                            <group string="Inspección física"
                                   invisible="not chequeo_inspeccion_fisica_ids">
                                <field name="chequeo_inspeccion_fisica_ids" nolabel="1" class="mc_rov_pruebas"
                                       colspan="2" readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <!-- Oculta como en las demás secciones desde
                                             19.0.15.2.1. Ningún chequeo del catálogo es
                                             `por_componente` —hay un test que lo fija— así
                                             que la columna está garantizadamente vacía, y
                                             mostrarla le robaba ancho a las otras tres solo
                                             en este bloque: era la sección que se veía
                                             distinta de las nueve. Sigue disponible desde
                                             el ⚙ si algún día vuelve un chequeo por
                                             componente. -->
                                        <field name="componente_id" readonly="1"
                                               optional="hide"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                            </group>

                            <!-- Energía y comunicación entran en 19.0.14.1.0: un ROV que no
                                 enciende o que pierde conexión no tenía ninguna prueba que lo
                                 verificara, aunque las dos cosas son familias enteras del
                                 catálogo de síntomas. Los chequeos de comunicación dependen
                                 del cable, y desde 19.0.15.0.0 eso no necesita convención: la
                                 revisión tiene un solo umbilical, así que estas respuestas son
                                 de ese cable y de ningún otro. -->
                            <group string="Prueba de energía" invisible="not chequeo_energia_ids">
                                <field name="chequeo_energia_ids" nolabel="1" class="mc_rov_pruebas"
                                       colspan="2" readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <field name="componente_id" readonly="1" optional="hide"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                            </group>

                            <group string="Prueba de presión" invisible="not chequeo_presion_ids">
                                <field name="chequeo_presion_ids" nolabel="1" class="mc_rov_pruebas"
                                       colspan="2" readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                            </group>

                            <group string="Prueba de leak" invisible="not chequeo_leak_ids">
                                <field name="chequeo_leak_ids" nolabel="1" class="mc_rov_pruebas"
                                       colspan="2" readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                            </group>

                            <group string="Prueba de comunicación"
                                   invisible="not chequeo_comunicacion_ids">
                                <field name="chequeo_comunicacion_ids" nolabel="1" class="mc_rov_pruebas"
                                       colspan="2" readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <field name="componente_id" readonly="1" optional="hide"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                            </group>

                            <!-- La ficha, al lado del chequeo que la usa. "El software
                                 instalado corresponde a la ficha" se responde comparando, y
                                 si comparar obliga a abrir el número de serie en otra
                                 pestaña, se responde "OK" sin mirar — un dato falso donde
                                 antes había un vacío honesto.

                                 Solo lectura: el dato vive en el número de serie. Si lo que
                                 está mal es la ficha, se corrige allá, y el chatter del lote
                                 registra el cambio porque las tres versiones llevan
                                 `tracking`.

                                 Se esconde cuando la ficha no declara nada —todos los equipos
                                 anteriores a Odoo— porque cinco etiquetas vacías se leen como
                                 algo roto y no como "esto todavía no se llenó". -->
                            <group string="Software según la ficha"
                                   invisible="not software_ficha_id and not version_ardusub_ficha
                                              and not controlador_ficha_id">
                                <group>
                                    <field name="software_ficha_id" readonly="1"/>
                                    <field name="version_software_ficha" readonly="1"/>
                                    <field name="version_ardusub_ficha" readonly="1"/>
                                </group>
                                <group>
                                    <field name="controlador_ficha_id" readonly="1"/>
                                    <field name="version_controlador_ficha" readonly="1"/>
                                </group>
                            </group>

                            <group string="Prueba de navegación"
                                   invisible="not chequeo_navegacion_ids">
                                <field name="chequeo_navegacion_ids" nolabel="1" class="mc_rov_pruebas"
                                       colspan="2" readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                            </group>

                            <group string="Prueba de video" invisible="not chequeo_video_ids">
                                <field name="chequeo_video_ids" nolabel="1" class="mc_rov_pruebas"
                                       colspan="2" readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                            </group>

                            <!-- La prueba de luces es un conteo y no un OK / No OK: se
                                 cuentan las que encienden. El total sale solo y se compara
                                 contra la ficha del equipo. -->
                            <!-- Manipulador y sonar los lleva una minoría de los equipos, y
                                 por eso se preguntan igual: "No aplica" afirma que el equipo
                                 no lo tiene, que es distinto de no haberlo mirado. -->
                            <group string="Prueba de accesorios" invisible="not chequeo_accesorios_ids">
                                <field name="chequeo_accesorios_ids" nolabel="1" class="mc_rov_pruebas"
                                       colspan="2" readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <field name="componente_id" readonly="1" optional="hide"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                            </group>

                            <!-- Luces va al final y con el checklist ARRIBA de los contadores.
                                 Es la única sección que además pide números, así que es la
                                 única con una forma distinta; puesta última y empezando como
                                 todas —una lista— esa diferencia deja de interrumpir el ritmo
                                 de las otras ocho.

                                 El conteo se queda acá y no sube con las condiciones de la
                                 prueba porque el técnico hace las tres cosas en el mismo
                                 momento: prende las luces, cuenta cuántas encienden y prueba
                                 que respondan. -->
                            <group string="Prueba de luces">
                                <field name="chequeo_luces_ids" nolabel="1" class="mc_rov_pruebas" colspan="2"
                                       invisible="not chequeo_luces_ids"
                                       readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                                <group>
                                    <field name="luces_internas" readonly="estado == 'confirmado'"/>
                                    <field name="luces_externas" readonly="estado == 'confirmado'"/>
                                </group>
                                <group>
                                    <field name="luces_total"/>
                                    <field name="luces_ficha"/>
                                    <field name="luces_difieren" invisible="1"/>
                                </group>
                            </group>
                            <div class="alert alert-warning" role="alert"
                                 invisible="not luces_difieren">
                                El conteo de luces de la prueba no coincide con la ficha del
                                equipo. O el equipo perdió luces, o la ficha está mal.
                            </div>

                            <group string="Otras pruebas" invisible="not chequeo_otro_ids">
                                <field name="chequeo_otro_ids" nolabel="1" class="mc_rov_pruebas"
                                       colspan="2" readonly="estado == 'confirmado'">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="chequeo_id" readonly="1"/>
                                        <field name="componente_id" readonly="1"
                                               optional="hide"/>
                                        <field name="resultado" widget="radio"
                                               options="{&quot;horizontal&quot;: true}"/>
                                        <field name="detalle"/>
                                    </list>
                                </field>
                            </group>
                        </page>

                        <page string="Hallazgos" name="page_hallazgos">
                            <field name="hallazgo_ids" readonly="estado == 'confirmado'">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="componente_id"/>
                                    <field name="subtipo_id"
                                           domain="[('componente_id', '=', componente_id)]"/>
                                    <field name="hallazgo_id"/>
                                    <field name="severidad"/>
                                    <field name="chequeo_origen_id"
                                           domain="[('revision_id', '=', parent.id)]"
                                           optional="show"/>
                                    <field name="detalle"/>
                                </list>
                            </field>
                        </page>

                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Estas dos listas existen solo para el diálogo «Buscar más» de los dos campos de
         enlace: sin una lista declarada, Odoo genera una por defecto que en un modelo sin
         campo `name` muestra únicamente la columna ID. La pantalla resultante era una lista
         de números y nada más, o sea imposible de usar para lo único que sirve —elegir cuál
         prueba destapó el hallazgo, o cuál hallazgo resuelve el trabajo—. -->
    <record id="view_mc_rov_revision_chequeo_list" model="ir.ui.view">
        <field name="name">mc.rov.revision.chequeo.list</field>
        <field name="model">mc.rov.revision.chequeo</field>
        <field name="arch" type="xml">
            <list string="Pruebas de la revisión" create="0">
                <field name="chequeo_id"/>
                <field name="componente_id" optional="show"/>
                <field name="seccion"/>
                <field name="resultado"/>
                <field name="detalle" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mc_rov_revision_hallazgo_list" model="ir.ui.view">
        <field name="name">mc.rov.revision.hallazgo.list</field>
        <field name="model">mc.rov.revision.hallazgo</field>
        <field name="arch" type="xml">
            <list string="Hallazgos" create="0">
                <field name="componente_id"/>
                <field name="subtipo_id" optional="show"/>
                <field name="hallazgo_id"/>
                <field name="severidad"/>
                <field name="revision_id" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_mc_rov_revision_list" model="ir.ui.view">
        <field name="name">mc.rov.revision.list</field>
        <field name="model">mc.rov.revision</field>
        <field name="arch" type="xml">
            <list string="Revisiones técnicas">
                <field name="name"/>
                <field name="fecha"/>
                <field name="lot_id"/>
                <field name="product_id" optional="show"/>
                <field name="tipo"/>
                <field name="responsable_id" optional="show"/>
                <field name="repair_id" optional="hide"/>
                <field name="horas_operacion" optional="hide"/>
                <field name="resultado"
                       decoration-danger="resultado == 'rechazado'"
                       decoration-warning="resultado == 'aprobado_con_observaciones'"
                       decoration-success="resultado == 'aprobado'"/>
                <field name="estado"/>
            </list>
        </field>
    </record>

    <record id="view_mc_rov_revision_search" model="ir.ui.view">
        <field name="name">mc.rov.revision.search</field>
        <field name="model">mc.rov.revision</field>
        <field name="arch" type="xml">
            <search string="Buscar revisiones">
                <field name="name"/>
                <field name="lot_id"/>
                <field name="responsable_id"/>
                <filter name="filtro_borrador" string="Borradores"
                        domain="[('estado', '=', 'borrador')]"/>
                <filter name="filtro_rechazados" string="Rechazados"
                        domain="[('resultado', '=', 'rechazado')]"/>
                <separator/>
                <filter name="filtro_reparacion" string="Reparación"
                        domain="[('tipo', '=', 'reparacion')]"/>
                <filter name="filtro_terreno" string="Prueba en terreno"
                        domain="[('tipo', '=', 'terreno')]"/>
                <filter name="filtro_banco" string="Prueba de banco"
                        domain="[('tipo', '=', 'banco')]"/>
                <!-- El group va pelado: el schema de vistas de búsqueda de Odoo 19 rechaza
                     expand y string en este elemento. Misma forma que el arch base de
                     repair.view_repair_order_form_filter. -->
                <group>
                    <filter name="group_equipo" string="Equipo"
                            context="{'group_by': 'lot_id'}"/>
                    <filter name="group_tipo" string="Tipo"
                            context="{'group_by': 'tipo'}"/>
                    <filter name="group_resultado" string="Resultado"
                            context="{'group_by': 'resultado'}"/>
                    <filter name="group_responsable" string="Responsable"
                            context="{'group_by': 'responsable_id'}"/>
                    <filter name="group_fecha" string="Fecha" context="{'group_by': 'fecha'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- El taller no tiene por qué mirar las pruebas de banco. Las de terreno sí entran:
         una prueba en terreno puede pedirse dentro de una reparación —el cliente quiere
         comprobar que el equipo sigue respetando su profundidad— y en ese caso pertenece a
         la visita. Ver `designs/fabricacion.md` § 4.2. -->
    <record id="action_mc_rov_revision" model="ir.actions.act_window">
        <field name="name">Revisiones técnicas</field>
        <field name="res_model">mc.rov.revision</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('tipo', '!=', 'banco')]</field>
        <field name="context">{'default_tipo': 'reparacion'}</field>
    </record>

    <!-- Aquí hubo una acción «Revisiones de fabricación», retirada en 19.0.16.0.0. No la
         referenciaba ningún menú —las pruebas de banco se crean desde el botón del número de
         serie, que es donde manufactura ya trabaja— así que era un registro muerto, y con
         el renombre su dominio habría dejado de encontrar nada. -->

