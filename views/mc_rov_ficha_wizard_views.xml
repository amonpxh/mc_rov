<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mc_rov_ficha_wizard_form" model="ir.ui.view">
        <field name="name">mc.rov.ficha.wizard.form</field>
        <field name="model">mc.rov.ficha.wizard</field>
        <field name="arch" type="xml">
            <form string="Imprimir ficha para el cliente">
                <group>
                    <field name="repair_id" invisible="1"/>
                    <field name="revision_id" readonly="not repair_id"
                           domain="[('tipo', '=', 'reparacion'), ('repair_id', '=', repair_id)]"/>
                    <field name="tipo" invisible="1"/>
                    <field name="mostrar_firmas"/>
                    <field name="mostrar_sellos" invisible="tipo != 'reparacion'"/>
                    <field name="mostrar_hallazgos" invisible="tipo != 'reparacion'"/>
                    <field name="mostrar_diferencias" invisible="tipo != 'reparacion'"/>
                </group>
                <footer>
                    <button name="action_imprimir" string="Descargar PDF" type="object" class="btn-primary"/>
                    <button string="Cancelar" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_ficha_wizard" model="ir.actions.act_window">
        <field name="name">Imprimir ficha</field>
        <field name="res_model">mc.rov.ficha.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_revision_id': active_id}</field>
    </record>
    <record id="view_revision_ficha_button" model="ir.ui.view">
        <field name="name">mc.rov.revision.ficha.button</field>
        <field name="model">mc.rov.revision</field>
        <field name="inherit_id" ref="mc_rov.view_mc_rov_revision_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(action_ficha_wizard)d" type="action" string="Imprimir ficha"
                        invisible="tipo != 'reparacion'"/>
            </xpath>
        </field>
    </record>
</odoo>
