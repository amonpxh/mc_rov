<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_mc_rov_protocolo" model="ir.sequence">
        <field name="name">Protocolo de pruebas ROV</field>
        <field name="code">mc.rov.protocolo</field>
        <field name="prefix">PROT/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Componentes que entran en la inspección física.
         El "cilindro fuente" solo existe en los equipos con dos e-pods, y no todos los ROV
         llevan joystick: por eso la línea correspondiente se responde "No lo tiene" en vez
         de no generarse. La ausencia de una fila no distinguiría "no lo tiene" de "nadie
         lo miró". -->
    <record id="comp_epod" model="mc.rov.componente">
        <field name="name">E-pod</field>
        <field name="es_inspeccionable" eval="True"/>
    </record>
    <record id="comp_cilindro_fuente" model="mc.rov.componente">
        <field name="name">Cilindro fuente</field>
        <field name="es_inspeccionable" eval="True"/>
    </record>
    <record id="comp_joystick" model="mc.rov.componente">
        <field name="name">Joystick</field>
        <field name="es_inspeccionable" eval="True"/>
    </record>

    <!-- Los dos que ya existían y también se inspeccionan -->
    <record id="comp_motor" model="mc.rov.componente">
        <field name="es_inspeccionable" eval="True"/>
    </record>
    <record id="comp_consola" model="mc.rov.componente">
        <field name="es_inspeccionable" eval="True"/>
    </record>

    <!-- ================= Pasos de testeo estándar =================
         La inspección física solo aplica a recepción: existe para detectar si alguien más
         intervino el equipo, y en un ROV recién fabricado eso no significa nada. -->

    <!-- Las marcas de plumón se quedan en el catálogo y no en el modelo de inspección:
         puede que dejen de usarse y pasen a solo sellos. Como chequeo se retiran
         desmarcando `active`; como campo del modelo exigirían un despliegue. Es la
         distinción que ordena las dos cosas: lo que tiene continuidad y estados necesita
         modelo, lo que es un sí/no que puede desaparecer vive en el catálogo. -->
    <record id="chequeo_plumon" model="mc.rov.chequeo">
        <field name="name">Marcas de plumón</field>
        <field name="seccion">inspeccion_fisica</field>
        <field name="sequence">10</field>
        <field name="por_componente" eval="True"/>
        <field name="aplica_recepcion" eval="True"/>
    </record>

    <!-- El resto de la batería se corre en los cuatro tipos de protocolo -->

    <record id="chequeo_estanqueidad" model="mc.rov.chequeo">
        <field name="name">Estanqueidad bajo presión</field>
        <field name="seccion">presion</field>
        <field name="sequence">40</field>
        <field name="aplica_fabricacion" eval="True"/>
        <field name="aplica_recepcion" eval="True"/>
        <field name="aplica_entrega" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>

    <record id="chequeo_sensor_leak" model="mc.rov.chequeo">
        <field name="name">El sensor de leak responde</field>
        <field name="seccion">leak</field>
        <field name="sequence">50</field>
        <field name="aplica_fabricacion" eval="True"/>
        <field name="aplica_recepcion" eval="True"/>
        <field name="aplica_entrega" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>

    <record id="chequeo_helices" model="mc.rov.chequeo">
        <field name="name">Hélices en posición correcta</field>
        <field name="seccion">navegacion</field>
        <field name="sequence">60</field>
        <field name="aplica_fabricacion" eval="True"/>
        <field name="aplica_recepcion" eval="True"/>
        <field name="aplica_entrega" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>
    <record id="chequeo_mov_vertical" model="mc.rov.chequeo">
        <field name="name">Movimiento vertical</field>
        <field name="seccion">navegacion</field>
        <field name="sequence">70</field>
        <field name="aplica_fabricacion" eval="True"/>
        <field name="aplica_recepcion" eval="True"/>
        <field name="aplica_entrega" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>
    <record id="chequeo_mov_horizontal" model="mc.rov.chequeo">
        <field name="name">Movimiento horizontal</field>
        <field name="seccion">navegacion</field>
        <field name="sequence">80</field>
        <field name="aplica_fabricacion" eval="True"/>
        <field name="aplica_recepcion" eval="True"/>
        <field name="aplica_entrega" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>

    <record id="chequeo_camara" model="mc.rov.chequeo">
        <field name="name">Imagen de cámara</field>
        <field name="seccion">video</field>
        <field name="sequence">90</field>
        <field name="aplica_fabricacion" eval="True"/>
        <field name="aplica_recepcion" eval="True"/>
        <field name="aplica_entrega" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>
    <record id="chequeo_tilt" model="mc.rov.chequeo">
        <field name="name">Tilt</field>
        <field name="seccion">video</field>
        <field name="sequence">100</field>
        <field name="aplica_fabricacion" eval="True"/>
        <field name="aplica_recepcion" eval="True"/>
        <field name="aplica_entrega" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>

    <!-- ================= Catálogo de hallazgos =================
         No hay un hallazgo "Sin hallazgos": un protocolo sin líneas ya lo dice, y los
         chequeos respondidos son la prueba de que se miró. Tener las dos formas de decirlo
         permitiría registros que se contradicen. -->

    <record id="hallazgo_marca_plumon" model="mc.rov.hallazgo">
        <field name="name">Marca de plumón</field>
        <field name="familia">terceros</field>
        <field name="sequence">10</field>
    </record>
    <record id="hallazgo_sello_no_original" model="mc.rov.hallazgo">
        <field name="name">Sello no original</field>
        <field name="familia">terceros</field>
        <field name="sequence">20</field>
    </record>
    <record id="hallazgo_torniller_cambiada" model="mc.rov.hallazgo">
        <field name="name">Tornillería cambiada</field>
        <field name="familia">terceros</field>
        <field name="sequence">30</field>
    </record>
    <record id="hallazgo_componente_no_original" model="mc.rov.hallazgo">
        <field name="name">Componente no original</field>
        <field name="familia">terceros</field>
        <field name="sequence">40</field>
    </record>

    <record id="hallazgo_filtracion" model="mc.rov.hallazgo">
        <field name="name">Filtración</field>
        <field name="familia">estanqueidad</field>
        <field name="sequence">50</field>
    </record>
    <record id="hallazgo_sello_vencido" model="mc.rov.hallazgo">
        <field name="name">Sello vencido</field>
        <field name="familia">estanqueidad</field>
        <field name="sequence">60</field>
    </record>
    <record id="hallazgo_oring_danado" model="mc.rov.hallazgo">
        <field name="name">O-ring dañado</field>
        <field name="familia">estanqueidad</field>
        <field name="sequence">70</field>
    </record>
    <record id="hallazgo_penetrador_suelto" model="mc.rov.hallazgo">
        <field name="name">Penetrador suelto</field>
        <field name="familia">estanqueidad</field>
        <field name="sequence">80</field>
    </record>

    <record id="hallazgo_corrosion" model="mc.rov.hallazgo">
        <field name="name">Corrosión</field>
        <field name="familia">estructura</field>
        <field name="sequence">90</field>
    </record>
    <record id="hallazgo_trizadura" model="mc.rov.hallazgo">
        <field name="name">Trizadura</field>
        <field name="familia">estructura</field>
        <field name="sequence">100</field>
    </record>
    <record id="hallazgo_deformacion" model="mc.rov.hallazgo">
        <field name="name">Deformación</field>
        <field name="familia">estructura</field>
        <field name="sequence">110</field>
    </record>
    <record id="hallazgo_soldadura_rota" model="mc.rov.hallazgo">
        <field name="name">Soldadura rota</field>
        <field name="familia">estructura</field>
        <field name="sequence">120</field>
    </record>

    <record id="hallazgo_cable_pellizcado" model="mc.rov.hallazgo">
        <field name="name">Cable pellizcado</field>
        <field name="familia">electrico</field>
        <field name="sequence">130</field>
    </record>
    <record id="hallazgo_conector_danado" model="mc.rov.hallazgo">
        <field name="name">Conector dañado</field>
        <field name="familia">electrico</field>
        <field name="sequence">140</field>
    </record>
    <record id="hallazgo_aislacion_deteriorada" model="mc.rov.hallazgo">
        <field name="name">Aislación deteriorada</field>
        <field name="familia">electrico</field>
        <field name="sequence">150</field>
    </record>
    <record id="hallazgo_falso_contacto" model="mc.rov.hallazgo">
        <field name="name">Falso contacto</field>
        <field name="familia">electrico</field>
        <field name="sequence">160</field>
    </record>

    <record id="hallazgo_no_responde" model="mc.rov.hallazgo">
        <field name="name">No responde</field>
        <field name="familia">funcional</field>
        <field name="sequence">170</field>
    </record>
    <record id="hallazgo_intermitente" model="mc.rov.hallazgo">
        <field name="name">Intermitente</field>
        <field name="familia">funcional</field>
        <field name="sequence">180</field>
    </record>
    <record id="hallazgo_fuera_de_rango" model="mc.rov.hallazgo">
        <field name="name">Fuera de rango</field>
        <field name="familia">funcional</field>
        <field name="sequence">190</field>
    </record>
    <record id="hallazgo_ruido_anormal" model="mc.rov.hallazgo">
        <field name="name">Ruido anormal</field>
        <field name="familia">funcional</field>
        <field name="sequence">200</field>
    </record>

</odoo>
