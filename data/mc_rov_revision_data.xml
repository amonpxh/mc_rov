<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_mc_rov_revision" model="ir.sequence">
        <field name="name">Revisión técnica ROV</field>
        <field name="code">mc.rov.revision</field>
        <field name="prefix">REV/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Componentes que entran en la inspección física.
         El "cilindro fuente" solo existe en los equipos con dos e-pods, y no todos los ROV
         llevan joystick: por eso la línea correspondiente se responde "No aplica" en vez
         de no generarse. La ausencia de una fila no distinguiría "no lo tiene" de "nadie
         lo miró". -->
    <record id="comp_epod" model="mc.rov.componente">
        <field name="name">E-pod</field>
        <field name="es_inspeccionable" eval="True"/>
    </record>
    <record id="comp_cilindro_fuente" model="mc.rov.componente">
        <field name="name">Cilindro fuente</field>
        <field name="es_inspeccionable" eval="True"/>
    </record>
    <record id="comp_joystick" model="mc.rov.componente">
        <field name="name">Joystick</field>
        <field name="es_inspeccionable" eval="True"/>
    </record>

    <!-- Los dos que ya existían y también se inspeccionan -->
    <record id="comp_motor" model="mc.rov.componente">
        <field name="es_inspeccionable" eval="True"/>
    </record>
    <record id="comp_consola" model="mc.rov.componente">
        <field name="es_inspeccionable" eval="True"/>
    </record>

    <!-- ================= Pasos de testeo estándar =================
         Los nombres y el agrupamiento por sección salen de la hoja de papel del taller, que
         es el documento que la gente ya sabe llenar. La sección "Inspección física" queda
         sin chequeos: lo que había ahí eran las marcas de plumón, que salieron de la
         batería en 19.0.12.0.0 —preguntarlas en cinco componentes de toda revisión costaba
         cinco respuestas por ficha y casi nunca decía nada—. Ver una marca sigue siendo un
         hallazgo registrable, y para eso está `hallazgo_marca_plumon` más abajo. -->

    <record id="chequeo_estanqueidad" model="mc.rov.chequeo">
        <field name="name">Estanqueidad bajo presión</field>
        <field name="seccion">presion</field>
        <field name="sequence">40</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>

    <record id="chequeo_sensor_leak" model="mc.rov.chequeo">
        <field name="name">El sensor de leak responde</field>
        <field name="seccion">leak</field>
        <field name="sequence">50</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>

    <record id="chequeo_helices" model="mc.rov.chequeo">
        <field name="name">Hélices en posición correcta</field>
        <field name="seccion">navegacion</field>
        <field name="sequence">60</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>
    <record id="chequeo_mov_vertical" model="mc.rov.chequeo">
        <field name="name">Movimiento vertical</field>
        <field name="seccion">navegacion</field>
        <field name="sequence">64</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>
    <record id="chequeo_mov_horizontal" model="mc.rov.chequeo">
        <field name="name">Movimiento horizontal</field>
        <field name="seccion">navegacion</field>
        <field name="sequence">66</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>

    <record id="chequeo_camara" model="mc.rov.chequeo">
        <field name="name">Imagen de cámara</field>
        <field name="seccion">video</field>
        <field name="sequence">90</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>
    <record id="chequeo_tilt" model="mc.rov.chequeo">
        <field name="name">Tilt</field>
        <field name="seccion">video</field>
        <field name="sequence">100</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>

    <!-- ========== Ampliación de la batería, 19.0.14.1.0 ==========
         Los siete chequeos de arriba salieron de la hoja de papel. Estos nueve salieron de
         contar esa batería contra el catálogo de síntomas, y de ahí salió el hueco: un ROV
         que no enciende, que pierde conexión o al que no le responde una luz no tenía
         ninguna prueba que lo verificara. El técnico lo iba a encontrar mirando, y el
         hallazgo quedaría sin «Prueba que lo detectó» — o sea marcado como si a la batería
         le faltara un chequeo, que es exactamente lo que le faltaba.

         Lo que NO se agrega, y conviene que quede dicho: nada que la corrida ya mida. Que se
         apague solo lo dice `esfuerzo_resultado` con su duración, que se caliente lo dicen
         las temperaturas, y el ancho de banda son `subida` y `bajada`. Registrar el mismo
         hecho como número y como casilla deja dos versiones y ninguna confiable. -->

    <!-- Energía -->
    <record id="chequeo_enciende" model="mc.rov.chequeo">
        <field name="name">Enciende y arranca correctamente</field>
        <field name="seccion">energia</field>
        <field name="sequence">15</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>

    <!-- Inspección física. La sección quedó sin chequeos en 19.0.12.0.0 al salir las marcas
         de plumón, y sin nada adentro no se miraba nada al recibir de forma registrable. -->
    <record id="chequeo_chasis" model="mc.rov.chequeo">
        <field name="name">Chasis y estructura sin daño visible</field>
        <field name="seccion">inspeccion_fisica</field>
        <field name="sequence">20</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>
    <record id="chequeo_penetradores" model="mc.rov.chequeo">
        <field name="name">Penetradores y conectores sin daño</field>
        <field name="seccion">inspeccion_fisica</field>
        <field name="sequence">25</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>
    <record id="chequeo_helices_dano" model="mc.rov.chequeo">
        <field name="name">Hélices sin daño ni desgaste</field>
        <field name="seccion">inspeccion_fisica</field>
        <field name="sequence">30</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>

    <!-- Comunicación. "Responde a comandos" no es lo mismo que tener ancho de banda: el
         síntoma "conectado pero no responde" existe justamente porque son dos fallas
         distintas.

         El ancho de banda se contesta a mano y no se deriva de `subida`/`bajada`: decir si 8
         Mbps está bien exige un umbral que hoy nadie definió, y un umbral inventado en el
         código marcaría "No OK" según un número que no significa nada. El técnico sabe qué da
         su modelo. El día que la ficha técnica declare el valor esperado, esto puede pasar a
         derivarse solo, igual que ya lo hace `luces_difieren` contra la cantidad de luces. -->
    <record id="chequeo_responde_comandos" model="mc.rov.chequeo">
        <field name="name">Responde a comandos desde superficie</field>
        <field name="seccion">comunicacion</field>
        <field name="sequence">55</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>
    <record id="chequeo_ancho_banda" model="mc.rov.chequeo">
        <field name="name">El ancho de banda es el esperado para este equipo y este cable</field>
        <field name="seccion">comunicacion</field>
        <field name="sequence">57</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>

    <!-- Software, en 19.0.15.2.0. Había un síntoma —"El software de superficie falla"— y
         ninguna prueba que lo verificara, así que el técnico lo encontraba mirando y el
         hallazgo quedaba sin chequeo de origen.

         Van en `comunicacion` y no en una sección propia porque el catálogo de síntomas ya
         clasificó ahí esa falla. Una sección nueva habría costado un valor de Selection, un
         one2many filtrado y un bloque de vista para dos preguntas.

         **El segundo caza una falla concreta y observada:** el equipo se autoformatea y vuelve
         al software instalado de fábrica —normalmente ROVControl vuelve a QGroundControl, o
         QGroundControl baja a una versión más vieja—. Se responde comparando contra la ficha,
         que ya guarda las tres versiones con `tracking`, y por eso la pantalla las muestra al
         lado: un chequeo que obliga a salir a otra vista para contestarlo se contesta "OK".

         **Deliberadamente NO se estructura más que esto.** Cuál software revierte y con qué
         frecuencia no se sabe todavía, y `detalle` acepta cualquier combinación sin
         casilleros. Cuando estas líneas muestren un patrón —qué ranura, cada cuánto— se puede
         decidir si vale un modelo con comparación automática. Estructurarlo ahora sería
         inventar la forma del dato antes de tener el dato.

         Solo `aplica_reparacion`. Encender las otras dos por costumbre es exactamente la
         omisión que dejó la batería de fabricación sin definir (ver docs/pendientes.md): en
         fabricación el software lo instala uno mismo, así que compararlo contra la ficha no
         significa lo mismo. -->
    <record id="chequeo_software_opera" model="mc.rov.chequeo">
        <field name="name">El software de superficie inicia y opera</field>
        <field name="seccion">comunicacion</field>
        <field name="sequence">58</field>
        <field name="aplica_rendimiento" eval="False"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="False"/>
    </record>
    <record id="chequeo_software_ficha" model="mc.rov.chequeo">
        <field name="name">El software instalado corresponde a la ficha</field>
        <field name="seccion">comunicacion</field>
        <field name="sequence">59</field>
        <field name="aplica_rendimiento" eval="False"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="False"/>
    </record>

    <!-- Navegación. Depth hold y stabilize van separados por la misma razón que están
         separados como síntomas: apuntan a lugares distintos —el sensor de presión y el IMU o
         el compás— y de tenerlos separados sale una deducción que no existe de otro modo: si
         depth hold falla pero stabilize funciona, el problema es el sensor de profundidad,
         porque uno depende del otro. Hasta ahora esa deducción se podía reportar como síntoma
         pero no comprobar, porque no había prueba que la midiera.

         Por eso tampoco hace falta una sección "Sensores": el sensor de profundidad se
         verifica probando depth hold. -->
    <record id="chequeo_depth_hold" model="mc.rov.chequeo">
        <field name="name">Mantiene profundidad (depth hold)</field>
        <field name="seccion">navegacion</field>
        <field name="sequence">77</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>
    <record id="chequeo_stabilize" model="mc.rov.chequeo">
        <field name="name">Se estabiliza (stabilize)</field>
        <field name="seccion">navegacion</field>
        <field name="sequence">75</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>

    <!-- Luces. Contar cuántas encienden —que es lo que ya hacen `luces_internas` y
         `luces_externas`— no es lo mismo que verificar que se controlan desde superficie. -->
    <record id="chequeo_luces_control" model="mc.rov.chequeo">
        <field name="name">Las luces responden al control desde superficie</field>
        <field name="seccion">luces</field>
        <field name="sequence">120</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>

    <!-- ========== Segunda pasada, 19.0.14.2.0 ==========
         La primera ampliación cerró los huecos por familia de síntoma. Esta cierra los que
         quedaron adentro de familias que ya tenían alguna prueba, que son los que no se ven
         contando familias. -->

    <!-- Movimiento. "Un motor no gira" es de los síntomas que más se reportan y no tenía
         ninguna prueba: "Hélices en posición correcta" mira la posición, no que giren.

         Y acro va aparte de stabilize por el mismo criterio que separó depth hold: acro
         mantiene la velocidad angular con el giróscopo, stabilize nivela con acelerómetro y
         compás. Si acro responde y stabilize no, el giro está sano y el problema es la parte
         que nivela. No todos los equipos lo tienen, y para eso está "No aplica". -->
    <record id="chequeo_thrusters" model="mc.rov.chequeo">
        <field name="name">Todos los thrusters responden</field>
        <field name="seccion">navegacion</field>
        <field name="sequence">62</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>
    <record id="chequeo_acro" model="mc.rov.chequeo">
        <field name="name">Responde en modo acrobático (acro)</field>
        <field name="seccion">navegacion</field>
        <field name="sequence">73</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>
    <!-- Se observa con el equipo andando, por eso va en navegación y no en la inspección. -->
    <record id="chequeo_ruido_vibracion" model="mc.rov.chequeo">
        <field name="name">Sin ruido ni vibración anormal</field>
        <field name="seccion">navegacion</field>
        <field name="sequence">79</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>

    <!-- El umbilical es el componente del que más se sospecha y la inspección no lo miraba:
         se revisaban chasis, penetradores y hélices, o sea el vehículo, no el cable. -->
    <record id="chequeo_umbilical_estado" model="mc.rov.chequeo">
        <field name="name">Umbilical sin cortes ni aplastamientos</field>
        <field name="seccion">inspeccion_fisica</field>
        <field name="sequence">27</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>

    <!-- Accesorios -->
    <record id="chequeo_manipulador" model="mc.rov.chequeo">
        <field name="name">Manipulador responde</field>
        <field name="seccion">accesorios</field>
        <field name="sequence">110</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>
    <record id="chequeo_sonar" model="mc.rov.chequeo">
        <field name="name">Sonar funciona</field>
        <field name="seccion">accesorios</field>
        <field name="sequence">115</field>
        <field name="aplica_rendimiento" eval="True"/>
        <field name="aplica_reparacion" eval="True"/>
        <field name="aplica_terreno" eval="True"/>
    </record>

    <!-- La sección "luces" no lleva chequeos de OK / No OK: la prueba de luces es contar
         cuántas encienden, y eso ya son los tres campos de la revisión —internas, externas
         y el total, que se compara solo contra la ficha del equipo—. Un chequeo
         "¿encienden?" al lado de un conteo sería la misma respuesta pedida dos veces.
         La sección existe igual porque en pantalla es un bloque con título, como en la
         hoja de papel, y porque el catálogo queda abierto por si mañana se agrega algo
         que un número no contesta. -->

    <!-- ================= Catálogo de hallazgos =================
         No hay un hallazgo "Sin hallazgos": una revisión sin líneas ya lo dice, y los
         chequeos respondidos son la prueba de que se miró. Tener las dos formas de decirlo
         permitiría registros que se contradicen. -->

    <record id="hallazgo_marca_plumon" model="mc.rov.hallazgo">
        <field name="name">Marca de plumón</field>
        <field name="familia">terceros</field>
        <field name="sequence">10</field>
    </record>
    <record id="hallazgo_sello_no_original" model="mc.rov.hallazgo">
        <field name="name">Sello no original</field>
        <field name="familia">terceros</field>
        <field name="sequence">20</field>
    </record>
    <record id="hallazgo_torniller_cambiada" model="mc.rov.hallazgo">
        <field name="name">Tornillería cambiada</field>
        <field name="familia">terceros</field>
        <field name="sequence">30</field>
    </record>
    <record id="hallazgo_componente_no_original" model="mc.rov.hallazgo">
        <field name="name">Componente no original</field>
        <field name="familia">terceros</field>
        <field name="sequence">40</field>
    </record>

    <record id="hallazgo_filtracion" model="mc.rov.hallazgo">
        <field name="name">Filtración</field>
        <field name="familia">estanqueidad</field>
        <field name="sequence">50</field>
    </record>
    <record id="hallazgo_sello_vencido" model="mc.rov.hallazgo">
        <field name="name">Sello vencido</field>
        <field name="familia">estanqueidad</field>
        <field name="sequence">60</field>
    </record>
    <record id="hallazgo_oring_danado" model="mc.rov.hallazgo">
        <field name="name">O-ring dañado</field>
        <field name="familia">estanqueidad</field>
        <field name="sequence">70</field>
    </record>
    <record id="hallazgo_penetrador_suelto" model="mc.rov.hallazgo">
        <field name="name">Penetrador suelto</field>
        <field name="familia">estanqueidad</field>
        <field name="sequence">80</field>
    </record>

    <record id="hallazgo_corrosion" model="mc.rov.hallazgo">
        <field name="name">Corrosión</field>
        <field name="familia">estructura</field>
        <field name="sequence">90</field>
    </record>
    <record id="hallazgo_trizadura" model="mc.rov.hallazgo">
        <field name="name">Trizadura</field>
        <field name="familia">estructura</field>
        <field name="sequence">100</field>
    </record>
    <record id="hallazgo_deformacion" model="mc.rov.hallazgo">
        <field name="name">Deformación</field>
        <field name="familia">estructura</field>
        <field name="sequence">110</field>
    </record>
    <record id="hallazgo_soldadura_rota" model="mc.rov.hallazgo">
        <field name="name">Soldadura rota</field>
        <field name="familia">estructura</field>
        <field name="sequence">120</field>
    </record>

    <record id="hallazgo_cable_pellizcado" model="mc.rov.hallazgo">
        <field name="name">Cable pellizcado</field>
        <field name="familia">electrico</field>
        <field name="sequence">130</field>
    </record>
    <record id="hallazgo_conector_danado" model="mc.rov.hallazgo">
        <field name="name">Conector dañado</field>
        <field name="familia">electrico</field>
        <field name="sequence">140</field>
    </record>
    <record id="hallazgo_aislacion_deteriorada" model="mc.rov.hallazgo">
        <field name="name">Aislación deteriorada</field>
        <field name="familia">electrico</field>
        <field name="sequence">150</field>
    </record>
    <record id="hallazgo_falso_contacto" model="mc.rov.hallazgo">
        <field name="name">Falso contacto</field>
        <field name="familia">electrico</field>
        <field name="sequence">160</field>
    </record>

    <record id="hallazgo_no_responde" model="mc.rov.hallazgo">
        <field name="name">No responde</field>
        <field name="familia">funcional</field>
        <field name="sequence">170</field>
    </record>
    <record id="hallazgo_intermitente" model="mc.rov.hallazgo">
        <field name="name">Intermitente</field>
        <field name="familia">funcional</field>
        <field name="sequence">180</field>
    </record>
    <record id="hallazgo_fuera_de_rango" model="mc.rov.hallazgo">
        <field name="name">Fuera de rango</field>
        <field name="familia">funcional</field>
        <field name="sequence">190</field>
    </record>
    <record id="hallazgo_ruido_anormal" model="mc.rov.hallazgo">
        <field name="name">Ruido anormal</field>
        <field name="familia">funcional</field>
        <field name="sequence">200</field>
    </record>

</odoo>
