    </record>
    <record id="sub_umb_neutrik" model="mc.rov.subtipo">
        <field name="name">Neutrik</field>
        <field name="componente_id" ref="comp_umbilical"/>
    </record>

    <!-- Subtipos Electrónica -->
    <record id="sub_elec_microsd" model="mc.rov.subtipo">
        <field name="name">Micro SD</field>
        <field name="componente_id" ref="comp_electronica"/>
    </record>
    <record id="sub_elec_fuente" model="mc.rov.subtipo">
        <field name="name">Fuente de poder</field>
        <field name="componente_id" ref="comp_electronica"/>
    </record>
    <record id="sub_elec_esc" model="mc.rov.subtipo">
        <field name="name">ESC electrónico</field>
        <field name="componente_id" ref="comp_electronica"/>
    </record>
    <record id="sub_elec_tarjeta" model="mc.rov.subtipo">
        <field name="name">Tarjeta de comunicación</field>
        <field name="componente_id" ref="comp_electronica"/>
    </record>
    <record id="sub_elec_raspberry" model="mc.rov.subtipo">
