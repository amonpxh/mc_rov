<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tipos de intervención.
         es_mantencion marca los que reinician el ciclo de mantención del equipo:
         el cálculo lee esta casilla en vez de comparar nombres, para que agregar un
         tipo nuevo no exija tocar código. -->
    <record id="tipo_diagnostico" model="mc.rov.tipo.intervencion">
        <field name="name">Diagnóstico</field>
        <field name="sequence">10</field>
    </record>
    <record id="tipo_reparacion_correctiva" model="mc.rov.tipo.intervencion">
        <field name="name">Reparación correctiva</field>
        <field name="sequence">20</field>
    </record>
    <record id="tipo_mantencion_preventiva" model="mc.rov.tipo.intervencion">
        <field name="name">Mantención preventiva</field>
        <field name="sequence">30</field>
        <field name="es_mantencion" eval="True"/>
    </record>
    <record id="tipo_conversion" model="mc.rov.tipo.intervencion">
        <field name="name">Conversión / Upgrade</field>
        <field name="sequence">40</field>
    </record>

    <!-- Acciones -->
    <record id="accion_cambio_completo" model="mc.rov.accion">
        <field name="name">Cambio completo</field>
    </record>
    <record id="accion_cambio_componente" model="mc.rov.accion">
        <field name="name">Cambio de componente</field>
    </record>
    <record id="accion_reparacion" model="mc.rov.accion">
        <field name="name">Reparación</field>
    </record>
    <record id="accion_mantencion_preventiva" model="mc.rov.accion">
        <field name="name">Mantención preventiva</field>
    </record>
    <record id="accion_limpieza" model="mc.rov.accion">
        <field name="name">Limpieza</field>
    </record>
    <record id="accion_calibracion" model="mc.rov.accion">
        <field name="name">Calibración</field>
    </record>
    <record id="accion_configuracion" model="mc.rov.accion">
        <field name="name">Configuración / Software</field>
    </record>
    <record id="accion_soldadura" model="mc.rov.accion">
        <field name="name">Soldadura</field>
    </record>
    <record id="accion_sin_solucion" model="mc.rov.accion">
        <field name="name">Sin solución</field>
    </record>
    <record id="accion_derivado" model="mc.rov.accion">
        <field name="name">Derivado a fabricante</field>
    </record>

    <!-- Componentes -->
    <record id="comp_motor" model="mc.rov.componente">
        <field name="name">Motor</field>
    </record>
    <record id="comp_umbilical" model="mc.rov.componente">
        <field name="name">Umbilical</field>
    </record>
    <record id="comp_electronica" model="mc.rov.componente">
        <field name="name">Electrónica / Software</field>
    </record>
    <record id="comp_estructura" model="mc.rov.componente">
        <field name="name">Estructura / Chasis</field>
    </record>
    <record id="comp_consola" model="mc.rov.componente">
        <field name="name">Consola</field>
    </record>
    <record id="comp_camara" model="mc.rov.componente">
        <field name="name">Cámara</field>
    </record>
    <record id="comp_sensor" model="mc.rov.componente">
        <field name="name">Sensor</field>
    </record>
    <record id="comp_otro" model="mc.rov.componente">
        <field name="name">Otro</field>
    </record>

    <!-- Subtipos Motor -->
    <record id="sub_motor_rotor" model="mc.rov.subtipo">
        <field name="name">Rotor</field>
        <field name="componente_id" ref="comp_motor"/>
    </record>
    <record id="sub_motor_bobina" model="mc.rov.subtipo">
        <field name="name">Bobina / Núcleo</field>
        <field name="componente_id" ref="comp_motor"/>
    </record>
    <record id="sub_motor_helice" model="mc.rov.subtipo">
        <field name="name">Hélice</field>
        <field name="componente_id" ref="comp_motor"/>
    </record>
    <record id="sub_motor_tobera" model="mc.rov.subtipo">
        <field name="name">Tobera</field>
        <field name="componente_id" ref="comp_motor"/>
    </record>
    <record id="sub_motor_buje" model="mc.rov.subtipo">
        <field name="name">Buje</field>
        <field name="componente_id" ref="comp_motor"/>
    </record>
    <record id="sub_motor_esc" model="mc.rov.subtipo">
        <field name="name">ESC</field>
        <field name="componente_id" ref="comp_motor"/>
    </record>
    <record id="sub_motor_cable" model="mc.rov.subtipo">
        <field name="name">Cable de motor</field>
        <field name="componente_id" ref="comp_motor"/>
    </record>
    <record id="sub_motor_completo" model="mc.rov.subtipo">
        <field name="name">Motor completo</field>
        <field name="componente_id" ref="comp_motor"/>
    </record>

    <!-- Subtipos Umbilical -->
    <record id="sub_umb_conector_sub" model="mc.rov.subtipo">
        <field name="name">Conector submarino</field>
        <field name="componente_id" ref="comp_umbilical"/>
