<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_ficha_equipo_nuevo" model="ir.actions.report">
        <field name="name">Ficha de equipo nuevo</field>
        <field name="model">mc.rov.ficha.equipo.nuevo</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mc_rov.report_ficha_equipo_nuevo</field>
        <field name="report_file">mc_rov.report_ficha_equipo_nuevo</field>
        <field name="paperformat_id" ref="mc_rov.paperformat_ficha_carta"/>
        <field name="binding_model_id" ref="model_mc_rov_ficha_equipo_nuevo"/>
        <field name="binding_type">report</field>
        <field name="attachment_use" eval="True"/>
        <field name="attachment">'Ficha Equipo Nuevo - %s.pdf' % object.name.replace('/', '-') if object.estado == 'emitida' else False</field>
        <field name="print_report_name">'Ficha Equipo Nuevo - %s' % object.name.replace('/', '-')</field>
    </record>

    <template id="report_ficha_equipo_nuevo">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="mc_rov.report_ficha_equipo_nuevo_document"/>
            </t>
        </t>
    </template>

    <template id="report_ficha_equipo_nuevo_document">
        <div class="article fen-sheet" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
            <style>
                html, body, .fen-sheet.article { margin:0 !important; padding:0 !important; }
                .fen-sheet { width:100% !important; color:#243444; background:#fff; font-family:'DejaVu Sans',Arial,sans-serif; font-size:7.2pt; line-height:1.22; }
                .fen-sheet * { box-sizing:border-box; }
                .fen-page { position:relative; width:100%; min-height:792pt; padding:0 8.6pt 74pt; }
                .fen-header { position:relative; height:61pt; margin:0 -8.6pt 8pt; padding:7pt 13pt 5pt; background:#00569a; color:#fff; }
                .fen-logo { width:104pt; height:auto; display:block; }
                .fen-title { position:absolute; top:38pt; left:13pt; margin:0; color:#fff; font-family:Georgia,serif; font-size:14.5pt; line-height:1; font-weight:bold; }
                .fen-badge { position:absolute; right:14pt; top:16pt; padding:5.5pt 9pt 5pt; border-radius:3pt; background:#fff; color:#005aa0; font-family:'DejaVu Sans Mono','Courier New',monospace; font-size:7.5pt; font-weight:bold; }
                .fen-watermark { position:absolute; top:92pt; left:95pt; color:#dce4ea; font-size:43pt; font-weight:bold; transform:rotate(-17deg); z-index:0; }
                .fen-identity { width:100%; margin-bottom:6pt; border-collapse:separate; border-spacing:3pt 0; table-layout:fixed; }
                .fen-identity td { width:20%; padding:5pt 5.5pt 4pt; height:38pt; vertical-align:top; border:1px solid #d3e1ec; border-radius:4pt; background:#edf2f5; overflow-wrap:break-word; }
                .fen-label { display:block; color:#526b80; font-family:'DejaVu Sans Mono','Courier New',monospace; font-weight:bold; font-size:6.18pt; text-transform:uppercase; letter-spacing:.035em; line-height:1.05; }
                .fen-id-value { display:block; margin-top:4pt; font-family:'DejaVu Sans Mono','Courier New',monospace; font-size:7.95pt; line-height:1.1; }
                .fen-card { position:relative; margin:0 0 5pt; padding:7.5pt 8.5pt; border:1px solid #d3e1ec; border-radius:5pt; background:#fff; page-break-inside:avoid; }
                .fen-section-title { margin:0 0 6pt; color:#005aa0; font-size:7.6pt; line-height:1.08; font-weight:bold; letter-spacing:.04em; text-transform:uppercase; }
                .fen-config-table { width:100%; border-collapse:separate; border-spacing:5pt 0; table-layout:fixed; }
                .fen-config-col { width:50%; vertical-align:top; padding:0; }
                .fen-config-group { margin-bottom:5pt; padding:5pt 6pt 4pt; border:1px solid #d3e1ec; border-radius:4pt; background:#edf3f8; }
                .fen-config-group:last-child { margin-bottom:0; }
                .fen-subtitle { margin:0 0 4.5pt; color:#005aa0; font-size:6.35pt; line-height:1.08; font-weight:bold; }
                .fen-row { display:table; width:100%; padding:1.7pt 0; border-top:1px solid #e2ebf1; font-size:6.85pt; line-height:1.2; }
                .fen-row:first-of-type { border-top:0; }
                .fen-key, .fen-value { display:table-cell; vertical-align:top; overflow-wrap:break-word; }
                .fen-key { width:47%; color:#526b80; }
                .fen-value { width:53%; text-align:right; font-family:'DejaVu Sans Mono','Courier New',monospace; font-size:6.7pt; }
                .fen-validation { margin:0 0 5pt; padding-bottom:6pt; }
                .fen-val-table { width:100%; margin-top:5pt; border-collapse:separate; border-spacing:0; table-layout:fixed; border:1px solid #d3e1ec; border-radius:4pt; background:#edf3f8; }
                .fen-val-table + .fen-val-table { margin-top:5.5pt; }
                .fen-val-head, .fen-val-mid, .fen-val-side { height:174pt; vertical-align:top; padding-top:3.1pt; padding-bottom:5pt; }
                .fen-val-head { width:82pt; padding-left:6pt; padding-right:5pt; border-right:1px solid #d3e1ec; background:#f4f7f9; }
                .fen-val-mid { padding-left:5pt; padding-right:5pt; }
                .fen-val-side { width:250pt; padding-left:6pt; padding-right:6pt; border-left:1px solid #d3e1ec; background:#f4f7f9; }
                .fen-revision-name { color:#005aa0; font-family:'DejaVu Sans Mono','Courier New',monospace; font-size:8pt; font-weight:bold; }
                .fen-revision-meta { margin-top:5pt; color:#526b80; font-size:5.8pt; line-height:1.3; overflow-wrap:break-word; }
                .fen-status { display:inline-block; margin-top:6pt; padding:3pt 4pt; border-radius:3pt; font-size:5.7pt; line-height:1.18; font-weight:bold; }
                .fen-status-ok { background:#e3f4e9; color:#007b4b; }
                .fen-status-warning { background:#fff0d4; color:#92600d; }
                .fen-status-fail { background:#fce6e4; color:#b42318; }
                .fen-status-pending { background:#e9edf0; color:#667a89; }
                .fen-vr-title { margin:0 0 3pt; color:#005aa0; font-size:6.3pt; font-weight:bold; text-transform:uppercase; letter-spacing:.04em; }
                .fen-vr-section + .fen-vr-section { margin-top:4pt; padding-top:4pt; border-top:1px solid #d3e1ec; }
                .fen-vr-pair { width:100%; border-collapse:separate; border-spacing:3pt 0; table-layout:fixed; }
                .fen-vr-pair td { width:50%; padding:0; vertical-align:top; }
                .fen-vr-group-title { margin:1pt 0 3pt; color:#005aa0; font-size:5.9pt; font-weight:bold; }
                .fen-vr-line { display:table; width:100%; margin:1.3pt 0; font-size:5.85pt; line-height:1.16; }
                .fen-vr-line span, .fen-vr-line strong { display:table-cell; vertical-align:top; }
                .fen-vr-line span { width:44%; color:#526b80; }
                .fen-vr-line strong { width:56%; text-align:right; font-family:'DejaVu Sans Mono','Courier New',monospace; font-weight:normal; overflow-wrap:break-word; }
                .fen-vr-line .fen-ok { color:#007b4b; }
                .fen-vr-line .fen-arrow { font-weight:normal; }
                .fen-check-legend { margin:0 0 4pt; color:#667a89; font-size:5.4pt; }
                .fen-check-legend .ok { color:#007b4b; }
                .fen-check-legend .fail { color:#b42318; }
                .fen-check-legend .na { font-style:italic; }
                .fen-check-grid { width:100%; font-size:0; }
                .fen-check-item { display:inline-block; width:48%; margin:0 1% 3pt; padding:2.2pt 3pt; vertical-align:top; border:1px solid #dbe6ed; border-radius:3pt; background:#fff; font-size:6pt; line-height:1.18; page-break-inside:avoid; }
                .fen-check-head { display:table; width:100%; margin-bottom:1.2pt; }
                .fen-check-name, .fen-check-score { display:table-cell; font-weight:bold; }
                .fen-check-name { color:#334b5b; }
                .fen-check-score { text-align:right; font-family:'DejaVu Sans Mono','Courier New',monospace; white-space:nowrap; }
                .fen-check-score.ok, .fen-check-line.ok { color:#007b4b; }
                .fen-check-score.fail, .fen-check-line.fail { color:#b42318; }
                .fen-check-score.na, .fen-check-line.na { color:#667a89; font-style:italic; }
                .fen-check-score.pending, .fen-check-line.pending { color:#667a89; }
                .fen-check-detail { color:#4a6070; font-size:5.7pt; line-height:1.2; overflow-wrap:break-word; }
                .fen-check-separator { color:#96a8b5; }
                .fen-observations { min-height:58pt; }
                .fen-observation-text { font-family:'DejaVu Serif',Georgia,serif; font-size:8.1pt; line-height:1.35; font-style:italic; white-space:pre-line; }
                .fen-amber-note { margin-top:6pt; padding:5pt 6pt; border-left:2pt solid #c48b36; background:#fff4dd; color:#725119; font-size:6.8pt; line-height:1.25; }
                .fen-signatures { position:absolute; left:14pt; right:14pt; bottom:40pt; width:calc(100% - 28pt); border-collapse:separate; border-spacing:12pt 0; table-layout:fixed; }
                .fen-signatures td { width:25%; padding:0; vertical-align:bottom; }
                .fen-sign-line { height:1pt; background:#738695; }
                .fen-sign-label { padding-top:3pt; color:#536779; font-family:'DejaVu Sans Mono','Courier New',monospace; font-size:6.8pt; text-transform:uppercase; white-space:nowrap; }
                .fen-footer { position:absolute; left:14pt; right:14pt; bottom:8pt; padding-top:4.8pt; border-top:1px solid #d3e1ec; color:#596d7e; font-size:6.92pt; line-height:1.08; text-align:center; white-space:nowrap; }
            </style>
            <div class="page fen-page">
                <div class="fen-header">
                    <img class="fen-logo" t-att-src="o._ficha_logo_blanco_uri()" alt="Marine Connection"/>
                    <h1 class="fen-title">Ficha de equipo nuevo</h1>
                    <span class="fen-badge" t-esc="o.name"/>
                </div>
                <div t-if="o.estado == 'borrador'" class="fen-watermark">BORRADOR</div>
                <table class="fen-identity"><tr>
                    <td><span class="fen-label">Fecha</span><span class="fen-id-value" t-esc="o.fecha_emision.strftime('%d-%m-%Y')"/></td>
                    <td><span class="fen-label">Equipo / modelo</span><span class="fen-id-value" t-esc="o.lot_id.product_id.display_name"/></td>
                    <td><span class="fen-label">N° de serie</span><span class="fen-id-value" t-esc="o.lot_id.name"/></td>
                    <td><span class="fen-label">Cliente</span><span class="fen-id-value" t-esc="o.cliente_nombre or 'Pendiente'"/></td>
                    <td><span class="fen-label">Responsable</span><span class="fen-id-value" t-esc="o.responsable_id.name or 'Pendiente'"/></td>
                </tr></table>

                <div class="fen-card">
                    <h2 class="fen-section-title">Configuración del equipo</h2>
                    <table class="fen-config-table"><tr>
                        <td class="fen-config-col">
                            <div class="fen-config-group"><h3 class="fen-subtitle">Estructura y propulsión</h3>
                                <div class="fen-row"><span class="fen-key">Chasis</span><span class="fen-value" t-esc="o._ficha_etiqueta(o.lot_id, 'mc_chasis')"/></div>
                                <div class="fen-row"><span class="fen-key">Motores</span><span class="fen-value"><t t-esc="o.lot_id.mc_n_motores"/> × <t t-esc="o._ficha_etiqueta(o.lot_id, 'mc_modelo_motores')"/> · <t t-esc="o._ficha_etiqueta(o.lot_id, 'mc_posicion_motores')"/></span></div>
                                <div class="fen-row"><span class="fen-key">Pesos</span><span class="fen-value">ROV <t t-esc="o._ficha_decimal(o.lot_id.mc_peso_rov)"/> kg · Consola <t t-esc="o._ficha_decimal(o.lot_id.mc_peso_consola)"/> kg</span></div>
                            </div>
                            <div class="fen-config-group"><h3 class="fen-subtitle">Umbilical</h3>
                                <div class="fen-row"><span class="fen-key">N° serie</span><span class="fen-value" t-esc="o.lot_id.mc_n_serie_umbilical or 'Pendiente'"/></div>
                                <div class="fen-row"><span class="fen-key">Longitud</span><span class="fen-value"><t t-esc="o._ficha_decimal(o.lot_id.mc_longitud)"/> m</span></div>
                                <div class="fen-row"><span class="fen-key">Diámetro</span><span class="fen-value"><t t-esc="o._ficha_decimal(o.lot_id.mc_diametro)"/> mm</span></div>
                                <div class="fen-row"><span class="fen-key">Peso</span><span class="fen-value"><t t-esc="o._ficha_decimal(o.lot_id.mc_peso_umbilical)"/> kg</span></div>
                            </div>
                            <div class="fen-config-group"><h3 class="fen-subtitle">Parámetros de trabajo</h3>
                                <div class="fen-row"><span class="fen-key">Pilot gain</span><span class="fen-value"><t t-esc="o.lot_id.mc_limitacion_pilot_gain"/> %</span></div>
                                <div class="fen-row"><span class="fen-key">Ganancia luz</span><span class="fen-value"><t t-esc="o.lot_id.mc_ganancia_luz"/> %</span></div>
                            </div>
                        </td>
                        <td class="fen-config-col">
                            <div class="fen-config-group"><h3 class="fen-subtitle">Periféricos</h3>
                                <div class="fen-row"><span class="fen-key">Luces</span><span class="fen-value"><t t-esc="o.lot_id.mc_cantidad_luces"/> en el equipo</span></div>
                                <div class="fen-row"><span class="fen-key">Brazo / salida</span><span class="fen-value"><t t-esc="o.lot_id.mc_brazo or 'Sin brazo'"/> · <t t-esc="'instalada' if o.lot_id.mc_salida_brazo else 'sin salida'"/></span></div>
                                <div class="fen-row"><span class="fen-key">Dispositivos extra</span><span class="fen-value" t-esc="o.lot_id.mc_dispositivos_extra or 'Ninguno registrado'"/></div>
                            </div>
                            <div class="fen-config-group"><h3 class="fen-subtitle">Sensores e instrumentos</h3>
                                <div class="fen-row"><span class="fen-key">Sensor de presión</span><span class="fen-value" t-esc="o._ficha_etiqueta(o.lot_id, 'mc_sensor_presion')"/></div>
                                <div class="fen-row"><span class="fen-key">Tiene horómetro</span><span class="fen-value" t-esc="o._ficha_etiqueta(o.lot_id, 'mc_tiene_horometro')"/></div>
                            </div>
                            <div class="fen-config-group"><h3 class="fen-subtitle">Comunicación, software y control</h3>
                                <div class="fen-row"><span class="fen-key">Tarjetas de comunicación</span><span class="fen-value">ROV <t t-esc="o._ficha_etiqueta(o.lot_id, 'mc_tarjeta_comunicacion_rov')"/> · Consola <t t-esc="o._ficha_etiqueta(o.lot_id, 'mc_tarjeta_comunicacion_consola')"/></span></div>
                                <div class="fen-row"><span class="fen-key">Software de superficie</span><span class="fen-value"><t t-esc="o.lot_id.mc_software_superficie.name or 'Pendiente'"/> <t t-esc="o.lot_id.mc_version_software or ''"/></span></div>
                                <div class="fen-row"><span class="fen-key">Firmware</span><span class="fen-value">ArduSub <t t-esc="o.lot_id.mc_version_ardusub or 'Pendiente'"/></span></div>
                                <div class="fen-row"><span class="fen-key">Controlador de vuelo</span><span class="fen-value"><t t-esc="o.lot_id.mc_controlador_vuelo.name or 'Pendiente'"/> <t t-esc="o.lot_id.mc_version_controlador or ''"/></span></div>
                            </div>
                        </td>
                    </tr></table>
                </div>

                <div class="fen-card fen-validation">
                    <h2 class="fen-section-title">Validaciones de aceptación</h2>
                    <t t-foreach="[o.rnd_id, o.trn_id]" t-as="revision">
                        <table class="fen-val-table" data-fen-validation="1"><tr>
                            <td class="fen-val-head">
                                <div class="fen-revision-name" t-esc="revision.name if revision else ('RND pendiente' if revision_index == 0 else 'TRN pendiente')"/>
                                <t t-if="revision">
                                    <div class="fen-revision-meta"><t t-esc="revision.fecha.strftime('%d-%m-%Y')"/><br/><t t-esc="revision.responsable_id.name or 'Pendiente'"/></div>
                                    <span t-att-class="'fen-status fen-status-%s' % o._ficha_estado_css(revision)" t-esc="o._ficha_etiqueta(revision, 'resultado')"/>
                                </t>
                                <span t-else="" class="fen-status fen-status-pending">Pendiente</span>
                            </td>
                            <td class="fen-val-mid">
                                <t t-if="revision"><t t-call="mc_rov.ficha_equipo_nuevo_condiciones"/></t>
                                <div t-else="" class="fen-vr-title">Prueba pendiente</div>
                            </td>
                            <td class="fen-val-side">
                                <div class="fen-vr-title">Chequeos realizados</div>
                                <div class="fen-check-legend"><span class="ok">Conforme</span> · <span class="fail">No conforme</span> · <span class="na">No aplica</span> · Pendiente</div>
                                <div t-if="revision" class="fen-check-grid">
                                    <t t-foreach="o._ficha_grupos_chequeos(revision)" t-as="grupo">
                                        <div class="fen-check-item">
                                            <div class="fen-check-head"><span class="fen-check-name" t-esc="grupo['nombre']"/><span t-att-class="'fen-check-score %s' % grupo['estilo']"><t t-esc="grupo['conformes']"/> de <t t-esc="grupo['total']"/></span></div>
                                            <div class="fen-check-detail">
                                                <t t-foreach="grupo['lineas']" t-as="linea">
                                                    <span t-if="linea_index" class="fen-check-separator"> · </span><span t-att-class="'fen-check-line %s' % {'ok':'ok','no_ok':'fail','no_lo_tiene':'na','pendiente':'pending'}[linea['estado']]" t-esc="linea['nombre']"/>
                                                </t>
                                            </div>
                                        </div>
                                    </t>
                                </div>
                            </td>
                        </tr></table>
                    </t>
                </div>

                <div class="fen-card fen-observations">
                    <h2 class="fen-section-title">Observaciones / aceptación</h2>
                    <div t-if="o.observacion" class="fen-observation-text" t-esc="o.observacion"/>
                    <t t-foreach="[o.rnd_id, o.trn_id]" t-as="revision">
                        <t t-if="revision and revision.resultado == 'aprobado_con_observaciones' and revision.hallazgo_ids">
                            <div class="fen-amber-note"><strong t-esc="revision.hallazgo_ids[0].hallazgo_id.name"/> · Observación registrada en <t t-esc="revision.name"/>.</div>
                        </t>
                    </t>
                </div>

                <table class="fen-signatures"><tr>
                    <td><div class="fen-sign-line"/><div class="fen-sign-label">Responsable técnico</div></td>
                    <td><div class="fen-sign-line"/><div class="fen-sign-label">Jefe de taller</div></td>
                    <td><div class="fen-sign-line"/><div class="fen-sign-label">Gerente General</div></td>
                    <td><div class="fen-sign-line"/><div class="fen-sign-label">Aceptación del cliente</div></td>
                </tr></table>
                <div class="fen-footer">Ingeniería y Servicios Marine Connection SpA · RUT 76.957.685-1 · Pje. Chinquihue 136, Puerto Montt · +56 9 7646 3823 · marineconnection.cl</div>
            </div>
        </div>
    </template>

    <template id="ficha_equipo_nuevo_condiciones">
        <div class="fen-vr-section">
            <div class="fen-vr-title">Condiciones</div>
            <table class="fen-vr-pair"><tr>
                <td>
                    <t t-if="revision.tipo == 'rendimiento'">
                        <div class="fen-vr-group-title">Montaje de prueba</div>
                        <div class="fen-vr-line"><span>Umbilical</span><strong t-esc="o._ficha_etiqueta(revision, 'umbilical')"/></div>
                    </t>
                    <t t-else="">
                        <div class="fen-vr-group-title">Entorno de prueba</div>
                        <div class="fen-vr-line"><span>Lugar</span><strong t-esc="revision.lugar or 'Pendiente'"/></div>
                        <div class="fen-vr-line"><span>Profundidad</span><strong><t t-esc="revision.profundidad"/> m</strong></div>
                        <div class="fen-vr-line"><span>Corriente</span><strong><t t-esc="o._ficha_decimal(revision.velocidad_corriente)"/> kn</strong></div>
                    </t>
                </td>
                <td>
                    <div class="fen-vr-group-title">Alimentación</div>
                    <div class="fen-vr-line"><span>Fuente</span><strong t-esc="o._ficha_etiqueta(revision, 'alimentacion')"/></div>
                    <div class="fen-vr-line"><span>Tensión</span><strong><t t-esc="revision.tension_salida"/> V</strong></div>
                </td>
            </tr></table>
        </div>
        <div class="fen-vr-section">
            <div class="fen-vr-title">Resultados</div>
            <table class="fen-vr-pair"><tr>
                <td>
                    <div class="fen-vr-group-title">Funcionamiento continuo</div>
                    <div class="fen-vr-line"><span>Resultado</span><strong t-att-class="'fen-ok' if revision.funcionamiento_continuo_resultado == 'ok' else ''" t-esc="o._ficha_etiqueta(revision, 'funcionamiento_continuo_resultado')"/></div>
                    <div class="fen-vr-line"><span>Duración</span><strong><t t-esc="o._ficha_decimal(revision.funcionamiento_continuo_duracion)"/> h</strong></div>
                </td>
                <td>
                    <div class="fen-vr-group-title">Ancho de banda</div>
                    <div class="fen-vr-line"><span>Subida</span><strong><span class="fen-arrow">↑ </span><t t-esc="o._ficha_decimal(revision.subida)"/> Mbps</strong></div>
                    <div class="fen-vr-line"><span>Bajada</span><strong><span class="fen-arrow">↓ </span><t t-esc="o._ficha_decimal(revision.bajada)"/> Mbps</strong></div>
                </td>
            </tr></table>
            <table t-if="revision.tipo == 'rendimiento'" class="fen-vr-pair"><tr>
                <td>
                    <div class="fen-vr-group-title">Estanqueidad</div>
                    <div class="fen-vr-line"><span>Presión</span><strong><t t-esc="o._ficha_decimal(revision.presion_bar)"/> bar</strong></div>
                    <div class="fen-vr-line"><span>Tiempo</span><strong><t t-esc="o._ficha_decimal(revision.presion_tiempo)"/> h</strong></div>
                </td>
                <td>
                    <div class="fen-vr-group-title">Eléctrico</div>
                    <div class="fen-vr-line"><span>Fuga</span><strong><t t-esc="o._ficha_decimal(revision.fuga_corriente, 3)"/> A</strong></div>
                    <div class="fen-vr-line"><span>Reposo</span><strong><t t-esc="o._ficha_decimal(revision.consumo_reposo, 2)"/> kWh</strong></div>
