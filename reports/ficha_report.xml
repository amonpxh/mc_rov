<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_ficha_carta" model="report.paperformat">
        <field name="name">Ficha ROV - Carta</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_ficha" model="ir.actions.report">
        <field name="name">Ficha para el cliente</field>
        <field name="model">mc.rov.revision</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mc_rov.report_ficha</field>
        <field name="report_file">mc_rov.report_ficha</field>
        <field name="paperformat_id" ref="paperformat_ficha_carta"/>
        <field name="print_report_name">'Ficha - %s' % object.name.replace('/', '-')</field>
    </record>

    <!-- Los bloques tienen IDs estables para herencias Studio. El código base sigue
         actualizándose; una personalización debe ser una vista heredada, no sobrescribirlo. -->
    <template id="report_shared_header_metadata_styles">
        <style>.mc-report-head, .mc-report-head * { box-sizing:border-box; }
                .mc-report-head { color:#243444; font-family:'DejaVu Sans',Arial,sans-serif; }
                .mc-report-revision-gutter { margin:0 15.32px; }
                .mc-report-header { position:relative; display:block; height:79pt; min-height:79pt; margin:7.2pt -5pt 6.5pt; padding:6pt 12pt 5pt; overflow:hidden; border-radius:7pt; background:#00569a; color:#fff; }
                .mc-report-brand-lockup { position:relative; display:block; height:50pt; min-height:50pt; padding-right:150pt; }
                .mc-report-logo { position:absolute; top:4.8pt; left:0; display:block; width:133pt; height:auto; margin:0; }
                .mc-report-title-wrap { position:absolute; top:38pt; left:0; min-height:0; margin:0; padding:0; }
                .mc-report-header .mc-report-title { margin:0; padding:0; color:#fff; font-family:'DejaVu Sans',Arial,sans-serif; font-size:22pt; font-weight:700; letter-spacing:.003em; line-height:1; white-space:nowrap; }
                .mc-report-badge { position:absolute; top:27.5pt; right:12pt; margin:0; padding:6.1pt 9.5pt 5.7pt; border:1px solid #d3e1ec; border-radius:4.5pt; background:#fff; color:#00569a; font-family:'DejaVu Sans Mono','Courier New',monospace; font-size:10.6pt; font-weight:700; line-height:1; }
                /* En la tabla de wkhtmltopdf, height actúa como mínimo: la fila sigue creciendo si los values requieren más líneas. */
                .mc-report-head .mc-report-identity { width:calc(100% + 7.4pt); height:40pt; margin:0 -3.7pt 4.9pt; border-collapse:separate; border-spacing:3.7pt 0; table-layout:fixed; }
                .mc-report-head .mc-report-identity td { padding:0; vertical-align:top; }
                .mc-report-identity-cell:nth-child(1) { width:16.34%; }
                .mc-report-identity-cell:nth-child(2) { width:22.37%; }
                .mc-report-identity-cell:nth-child(3) { width:18.48%; }
                .mc-report-identity-cell:nth-child(4) { width:22.96%; }
                .mc-report-identity-cell:nth-child(5) { width:19.85%; }
                .mc-report-head .mc-report-identity td.mc-report-identity-cell { padding:6.45pt 6.8pt 3.8pt; border:1px solid #9fb4c3; border-radius:4pt; background:#e7eef3; overflow-wrap:break-word; }
                .mc-report-label { display:block; color:#526b80; font-family:'DejaVu Sans Mono','Courier New',monospace; font-size:7.8pt; font-weight:700; letter-spacing:.035em; line-height:1.05; text-transform:uppercase; white-space:nowrap; }
                .mc-report-value { display:block; margin-top:4pt; color:#243444; font-family:'DejaVu Sans Mono','Courier New',monospace; font-size:9.7pt; line-height:1.1; white-space:normal; overflow-wrap:break-word; word-wrap:break-word; }
                .mc-report-value--compact { font-size:8pt; line-height:1; }

        </style>
    </template>

    <template id="report_shared_metadata_value">
        <span t-attf-class="mc-report-value{{ ' mc-report-value--compact' if len(mc_report_metadata_value or '') &gt; mc_report_metadata_compact_limit else '' }}" t-out="mc_report_metadata_value"/>
    </template>

    <template id="report_shared_header_metadata">
        <div class="mc-report-head" data-mc-report-component="header-metadata">
            <div class="mc-report-header" data-mc-report-header="1">
                <div class="mc-report-brand-lockup">
                    <img t-if="o._ficha_logo_blanco_uri()" class="mc-report-logo" t-att-src="o._ficha_logo_blanco_uri()" alt="Marine Connection"/>
                    <div class="mc-report-title-wrap"><h1 class="mc-report-title" t-out="mc_report_title"/></div>
                </div>
                <div class="mc-report-badge" t-esc="o.name"/>
            </div>
            <table class="mc-report-identity" data-mc-report-identity="1" role="presentation">
                <tr><t t-out="0"/></tr>
            </table>
        </div>
    </template>

    <template id="report_ficha">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="mc_rov.report_ficha_document"/>
            </t>
        </t>
    </template>
    <template id="report_ficha_document">
        <t t-set="company" t-value="o.lot_id.company_id or res_company"/>
        <t t-set="options" t-value="o.env.context.get('rov_options', {})"/>
        <div class="article rov-ficha" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" t-att-data-oe-lang="o.env.lang">
            <style>html, body, .rov-ficha, .rov-ficha.article { margin: 0 !important; padding: 0 !important; }
                .rov-ficha, .rov-ficha.article { width: 100% !important; font-family: Arial, sans-serif; font-size: 12.38pt; color: #243444; }
                .rov-ficha h1 { font-family: Georgia, serif; font-size: 24.75pt; color: #00569a; margin: 5.89px 0 9.43px; }
                .rov-ficha h2 { font-size: 12.97pt; color: #00569a; margin: 11.79px 0 4.71px; page-break-after: avoid; }
                .rov-ficha table { width: 100%; border-collapse: collapse; table-layout: fixed; }
                .rov-ficha td, .rov-ficha th { padding: 4.71px 8.25px; vertical-align: top; overflow-wrap: break-word; word-wrap: break-word; }
                .rov-ficha th { text-align: left; font-weight: normal; }
                .rov-ficha .rov-value { font-family: 'Courier New', monospace; }
                .rov-ficha .rov-data tr { border-bottom: 1px solid #dbe3e9; }
                .rov-ficha .rov-data th { width: 45%; }
                .rov-ficha .rov-meta { background: #e7eef3; border: 1px solid #9fb4c3; }
                .rov-ficha .page { position: relative; margin: 0 !important; padding: 0 !important; }
                .rov-ficha .rov-report-body { padding: 0 15.32px 15.93px; }
                .rov-ficha .rov-card-pair { width: 100%; margin: 0 0 12.26px; border-collapse: separate; border-spacing: 0; }
                .rov-ficha .rov-card-pair-cell { width: 50%; padding: 0 5.89px 0 0; vertical-align: top; }
                .rov-ficha .rov-card-pair-cell + .rov-card-pair-cell { padding: 0 0 0 5.89px; }
                .rov-ficha .rov-report-card { min-height: 164.16px; box-sizing: border-box; padding: 12.26px 14.14px 11.03px; border: 1px solid #9fb4c3; border-radius: 7px; background: #fff; }
                .rov-ficha .rov-section-title { margin: 0 0 7.35px; color: #005aa0; font-family: Arial, sans-serif; font-size: 9.03pt; font-weight: bold; letter-spacing: .08em; line-height: 1.275; }
                .rov-ficha .rov-card-row { display: table; width: 100%; padding: 3.68px 0; border-bottom: 1px solid #f0f4f7; font-size: 10.4pt; line-height: 1.275; }
                .rov-ficha .rov-card-row:last-child { border-bottom: 0; }
                .rov-ficha .rov-card-label, .rov-ficha .rov-card-value { display: table-cell; vertical-align: top; }
                .rov-ficha .rov-card-label { color: #526b80; }
                .rov-ficha .rov-card-value, .rov-ficha .rov-measurement-value, .rov-ficha .rov-finding-value { font-weight: normal; }
                .rov-ficha .rov-card-value { width: 54%; text-align: right; font-family: 'Courier New', monospace; }
                .rov-ficha .rov-seal-ok { color: #007b4b; }
                .rov-ficha .rov-seal-fail { color: #b42318; }
                .rov-ficha .rov-seal-warning { color: #b36b00; }
                .rov-ficha .rov-seal-pending { color: #657585; }
                .rov-ficha .rov-measurements { margin: 0 0 12.26px; padding: 12.26px 12.97px 11.03px; border: 1px solid #9fb4c3; border-radius: 7px; background: #fff; }
                .rov-ficha .rov-measurement-grid { width: 100%; border-collapse: separate; border-spacing: 4.71px 4.9px; table-layout: fixed; }
                .rov-ficha .rov-measurement-grid td { width: 33.33%; padding: 0; vertical-align: top; }
                .rov-ficha .rov-measurement-grid td.rov-measurement-panel { padding: 7.35px 9.43px; border-radius: 6px; background: #e3ecf3; }
                .rov-ficha .rov-measurement-name { display: block; margin-bottom: 3.68px; color: #526b80; font-family: 'Courier New', monospace; font-size: 7.55pt; font-weight: bold; letter-spacing: .08em; text-transform: uppercase; }
                .rov-ficha .rov-measurement-row { display: table; width: 100%; padding: 1.23px 0; font-size: 10.02pt; line-height: 1.275; }
                .rov-ficha .rov-measurement-label, .rov-ficha .rov-measurement-value { display: table-cell; vertical-align: top; }
                .rov-ficha .rov-measurement-label { color: #526b80; }
                .rov-ficha .rov-measurement-value { width: 52%; text-align: right; font-family: 'Courier New', monospace; }
                .rov-ficha .rov-measurement-success { color: #007b4b; font-weight: bold; }
                .rov-ficha .rov-measurement-arrow { font-size: 11.14pt; font-weight: normal; line-height: .8; }
                .rov-ficha .rov-checks { margin: 0 0 12.26px; padding: 12.26px 12.97px 11.03px; border: 1px solid #9fb4c3; border-radius: 7px; background: #fff; }
                .rov-ficha .rov-checks-header { display: table; width: 100%; margin: 0 0 6.13px; }
                .rov-ficha .rov-checks-title, .rov-ficha .rov-checks-legend { display: table-cell; vertical-align: top; }
                .rov-ficha .rov-checks-legend { text-align: right; color: #657585; font-size: 8.66pt; }
                .rov-ficha .rov-check-grid { width: 100%; border-collapse: separate; border-spacing: 5.89px 4.9px; table-layout: fixed; }
                .rov-ficha .rov-check-grid td { width: 33.33%; padding: 0; vertical-align: top; }
                .rov-ficha .rov-check-section { padding: 2.45px 3.54px; border: 0; border-radius: 0; background: #fff; page-break-inside: auto !important; }
                .rov-ficha .rov-check-section-head { display: table; width: 100%; margin-bottom: 2.45px; }
                .rov-ficha .rov-check-section-name, .rov-ficha .rov-check-section-summary { display: table-cell; vertical-align: top; font-size: 8.66pt; font-weight: bold; }
                .rov-ficha .rov-check-section-summary { width: 31%; text-align: right; font-family: 'Courier New', monospace; }
                .rov-ficha .rov-check-summary-ok { color: #007b4b; }
                .rov-ficha .rov-check-summary-fail { color: #b42318; }
                .rov-ficha .rov-check-summary-pending { color: #657585; }
                .rov-ficha .rov-check-summary-na { color: #657585; font-style: italic; }
                .rov-ficha .rov-check-details { padding-left: 9.43px; color: #526b80; font-size: 8.66pt; line-height: 1.346; overflow-wrap: break-word; word-wrap: break-word; }
                .rov-ficha .rov-check-line { display: inline; }
                .rov-ficha .rov-check-separator { color: #9aa9b5; }
                .rov-ficha .rov-check-status { font-family: 'Courier New', monospace; font-size: 7.18pt; }
                .rov-ficha .rov-check-ok { color: #007b4b; }
                .rov-ficha .rov-check-details .rov-check-ok { color: #526b80; }
                .rov-ficha .rov-check-fail { color: #b42318; font-weight: 600; }
                .rov-ficha .rov-check-na { color: #657585; font-style: italic; }
                .rov-ficha .rov-check-pending { color: #657585; }
                /* Supera el margen inferior de Chequeos para que wkhtmltopdf conserve el aire antes del cierre. */
                .rov-ficha .rov-closing-grid { width: 100%; margin: 21.33px 0 12.26px; border-collapse: separate; border-spacing: 0; table-layout: fixed; }
                /* El borde vive en la celda: ambas tarjetas comparten la altura natural de la fila. */
                .rov-ficha .rov-closing-cell { padding: 0; vertical-align: top; border: 1px solid #9fb4c3; border-radius: 7px; background: #fff; page-break-inside: auto !important; }
                .rov-ficha .rov-closing-cell-half { width: 49%; }
                .rov-ficha .rov-closing-cell-full { width: 100%; }
                .rov-ficha .rov-closing-gap { width: 2%; padding: 0; border: 0; background: transparent; }
                .rov-ficha .rov-closing-card { min-height: 170.56px; box-sizing: border-box; padding: 12.26px 14.14px 11.03px; background: transparent; overflow: visible; }
                .rov-ficha .rov-finding { display: table; width: 100%; padding: 3.68px 0; border-bottom: 1px solid #edf2f5; font-size: 10.02pt; line-height: 1.275; page-break-inside: avoid !important; }
                .rov-ficha .rov-finding:last-child { border-bottom: 0; }
                .rov-ficha .rov-finding-summary { margin-top: 4.9px; color: #657585; font-style: italic; border-bottom: 0; }
                .rov-ficha .rov-finding-label, .rov-ficha .rov-finding-value { display: table-cell; vertical-align: top; overflow-wrap: break-word; word-wrap: break-word; }
                .rov-ficha .rov-finding-label { width: 44%; padding-right: 12.97px; }
                .rov-ficha .rov-finding-value { width: 56%; padding-left: 4.71px; text-align: right; font-family: 'Courier New', monospace; font-size: .95em; }
                /* QtWebKit treats table height as a minimum, so long content can grow naturally. */
                .rov-ficha .rov-observations-layout { width: 100%; height: 239.45px; margin: 0; border-collapse: collapse; table-layout: fixed; }
                .rov-ficha .rov-observations-layout td { padding: 0; vertical-align: top; }
                .rov-ficha .rov-observations-differences-cell { vertical-align: bottom !important; }
                .rov-ficha .rov-observations-title { margin: 0 0 9.81px; }
                .rov-ficha .rov-observations-text { margin: 0; color: #3d4d5d; font-family: Georgia, serif; font-size: 11.14pt; font-style: italic; line-height: 1.51; white-space: pre-wrap; overflow-wrap: break-word; word-wrap: break-word; }
                .rov-ficha .rov-differences { margin-top: 9.81px; padding: 8.58px 10.61px; border-left: 2px solid #b36b00; border-radius: 0 5px 5px 0; background: #fff7ed; color: #8f5600; font-size: 10.15pt; line-height: 1.408; overflow-wrap: break-word; word-wrap: break-word; }
                .rov-ficha .rov-difference-line + .rov-difference-line { margin-top: 3.68px; }
                .rov-ficha .rov-pair { width: 50%; padding: 0 10.61px 0 0; }
                .rov-ficha .rov-section { font-weight: bold; background: #f0f5f8; }
                .rov-ficha .rov-check { padding-left: 18.86px; }
                .rov-ficha .rov-fail { color: #a42323; font-weight: bold; }
                .rov-ficha .rov-na { color: #657585; font-style: italic; }
                .rov-ficha .rov-signatures { width: 100%; margin: 4.9px 0 0; border-collapse: separate; border-spacing: 15.32px 0; page-break-inside: avoid; }
                .rov-ficha .rov-signatures td { width: 50%; padding: 0; text-align: left; }
                .rov-ficha .rov-signature-line { height: 31.88px; margin-bottom: 3.68px; border-bottom: 1px solid #8fa6b7; }
                .rov-ficha .rov-signature-label { color: #526b80; font-family: 'Courier New', monospace; font-size: 8.17pt; letter-spacing: .04em; text-transform: uppercase; }
                .rov-ficha .rov-logo { max-height: 53.04px; max-width: 212.17px; }
                .rov-ficha .rov-footer { margin: 12.26px 0 2.45px; padding-top: 11.03px; border-top: 1px solid #8fa6b7; color: #526b80; font-size: 8.17pt; letter-spacing: .03em; line-height: 1.377; text-align: center; page-break-inside: avoid; }
                .rov-ficha .rov-footer-item { display: inline-block; margin: 0 5.89px 2.45px; white-space: nowrap; }
                /* QtWebKit puede ignorar la regla del tr y partir el contenido de una celda. */
                .rov-ficha tr, .rov-ficha td, .rov-ficha th { page-break-inside: avoid !important; }
                /* Escala final: +2 % sobre la composición aprobada. */
                .rov-ficha, .rov-ficha.article { font-size: 12.63pt; }
                .rov-ficha .rov-report-body { padding-bottom: 16.19px; }
                .rov-ficha .rov-card-pair { margin-bottom: 12.46px; }
                .rov-ficha .rov-report-card { min-height: 166.82px; padding-top: 12.46px; padding-bottom: 11.21px; }
                .rov-ficha .rov-section-title { margin-bottom: 7.47px; font-size: 9.21pt; line-height: 1.286; }
                .rov-ficha .rov-card-row { padding-top: 3.74px; padding-bottom: 3.74px; font-size: 10.6pt; line-height: 1.286; }
                .rov-ficha .rov-measurements { margin-bottom: 12.46px; padding-top: 12.46px; padding-bottom: 11.21px; }
                .rov-ficha .rov-measurement-grid { border-spacing: 4.71px 4.98px; }
                .rov-ficha .rov-measurement-grid td.rov-measurement-panel { padding-top: 7.47px; padding-bottom: 7.47px; }
                .rov-ficha .rov-measurement-name { margin-bottom: 3.74px; font-size: 7.7pt; }
                .rov-ficha .rov-measurement-row { padding-top: 1.25px; padding-bottom: 1.25px; font-size: 10.22pt; line-height: 1.286; }
                .rov-ficha .rov-measurement-arrow { font-size: 11.36pt; }
                .rov-ficha .rov-checks { margin-bottom: 12.46px; padding-top: 12.46px; padding-bottom: 11.21px; }
                .rov-ficha .rov-checks-header { margin-bottom: 6.22px; }
                .rov-ficha .rov-checks-legend { font-size: 8.84pt; }
                .rov-ficha .rov-check-grid { border-spacing: 5.89px 4.98px; }
                .rov-ficha .rov-check-section { padding-top: 2.49px; padding-bottom: 2.49px; }
                .rov-ficha .rov-check-section-head { margin-bottom: 2.49px; }
                .rov-ficha .rov-check-section-name, .rov-ficha .rov-check-section-summary { font-size: 8.84pt; }
                .rov-ficha .rov-check-details { font-size: 8.84pt; line-height: 1.357; }
                .rov-ficha .rov-check-status { font-size: 7.33pt; }
                .rov-ficha .rov-closing-grid { margin-bottom: 12.46px; }
                .rov-ficha .rov-closing-card { min-height: 173.32px; padding-top: 12.46px; padding-bottom: 11.21px; }
                .rov-ficha .rov-finding { padding-top: 3.74px; padding-bottom: 3.74px; font-size: 10.22pt; line-height: 1.286; }
                .rov-ficha .rov-finding-summary { margin-top: 4.98px; }
                .rov-ficha .rov-observations-title { margin-bottom: 9.97px; }
                .rov-ficha .rov-observations-text { font-size: 11.36pt; line-height: 1.522; }
                .rov-ficha .rov-differences { margin-top: 9.97px; padding-top: 8.72px; padding-bottom: 8.72px; font-size: 10.36pt; line-height: 1.419; }
                .rov-ficha .rov-difference-line + .rov-difference-line { margin-top: 3.74px; }
                .rov-ficha .rov-signatures { margin-top: 4.98px; }
                .rov-ficha .rov-signature-line { height: 32.39px; margin-bottom: 3.74px; }
                .rov-ficha .rov-signature-label { font-size: 8.33pt; }
                .rov-ficha .rov-footer { margin-top: 12.46px; margin-bottom: 2.49px; padding-top: 11.21px; font-size: 8.33pt; line-height: 1.388; }
                .rov-ficha .rov-footer-item { margin-bottom: 2.49px; }
                /* Escala final: +4 % sobre la composición aprobada. */
                .rov-ficha, .rov-ficha.article { font-size: 12.87pt; }
                .rov-ficha .rov-report-body { padding-bottom: 8px; }
                .rov-ficha .rov-card-pair { margin-bottom: 12.66px; }
