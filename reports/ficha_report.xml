                .rov-ficha .rov-check-section-head { margin-bottom: 2.53px; }
                .rov-ficha .rov-check-section-name, .rov-ficha .rov-check-section-summary { font-size: 9.01pt; }
                .rov-ficha .rov-check-details { font-size: 9.01pt; line-height: 1.369; }
                .rov-ficha .rov-check-status { font-size: 7.47pt; }
                .rov-ficha .rov-closing-grid { margin-bottom: 12.66px; }
                .rov-ficha .rov-closing-card { min-height: 176.07px; padding-top: 12.66px; padding-bottom: 11.39px; }
                .rov-ficha .rov-finding { padding-top: 3.8px; padding-bottom: 3.8px; font-size: 10.42pt; line-height: 1.296; }
                .rov-ficha .rov-finding-summary { margin-top: 5.06px; }
                .rov-ficha .rov-observations-sizer { min-height: 176.07px; padding-top: 12.66px; padding-bottom: 11.39px; }
                .rov-ficha .rov-observations-title { margin-bottom: 10.12px; }
                .rov-ficha .rov-observations-text { font-size: 11.59pt; line-height: 1.534; }
                .rov-ficha .rov-observations-card-paired .rov-observations-content { padding-bottom: 101.24px; }
                .rov-ficha .rov-observations-card-paired .rov-observations-differences { bottom: 11.39px; }
                .rov-ficha .rov-differences { margin-top: 10.12px; padding-top: 8.86px; padding-bottom: 8.86px; font-size: 10.56pt; line-height: 1.431; }
                .rov-ficha .rov-difference-line + .rov-difference-line { margin-top: 3.8px; }
                .rov-ficha .rov-signatures { margin-top: 5.06px; }
                .rov-ficha .rov-signature-line { height: 32.91px; margin-bottom: 3.8px; }
                .rov-ficha .rov-signature-label { font-size: 8.5pt; }
                .rov-ficha .rov-footer { margin-top: 12.66px; margin-bottom: 2.53px; padding-top: 11.39px; font-size: 8.5pt; line-height: 1.4; }
                .rov-ficha .rov-footer-item { margin-bottom: 2.53px; }

                /* Microajustes finales: aire en identificación y zona funcional de firma. */
                .rov-ficha .rov-identity-wrap { padding-top: 12.5px; padding-bottom: 11.25px; }
                .rov-ficha .rov-identity-card { min-height: 50.5px; padding-top: 7px; padding-bottom: 7px; }
                .rov-ficha .rov-identity-label { margin-bottom: 4px; }
                .rov-ficha .rov-finding-summary { margin-top: 8.5px; }
                .rov-ficha .rov-observations-title { margin-bottom: 11.5px; }
                .rov-ficha .rov-signatures { margin-top: 12.66px; }
                .rov-ficha .rov-signature-line { height: 47px; margin-bottom: 4px; }
                .rov-ficha .rov-signature-label { font-size: 8.75pt; color: #536779; }
                .rov-ficha .rov-footer { font-size: 8.7pt; color: #536779; }
                .rov-ficha .rov-header-logo-window { margin-bottom: 9px; }
            </style>
            <div class="page">
                <div class="rov-draft" data-rov-watermark="1" t-if="o.estado == 'borrador'"><span>BORRADOR</span></div>
                <t t-call="mc_rov.ficha_cabecera"/>
                <div class="rov-report-body">
                    <table class="rov-card-pair"><tr>
                        <td class="rov-card-pair-cell"><t t-call="mc_rov.ficha_condiciones"/></td>
                        <td class="rov-card-pair-cell"><t t-if="options.get('sellos', True)" t-call="mc_rov.ficha_sellos"/></td>
                    </tr></table>
                    <t t-call="mc_rov.ficha_mediciones"/>
                    <t t-call="mc_rov.ficha_chequeos"/>
                    <t t-call="mc_rov.ficha_hallazgos_observaciones"/>
                    <t t-if="options.get('firmas', True)" t-call="mc_rov.ficha_firmas"/>
                    <div class="rov-footer" data-rov-footer="1">
                        <span class="rov-footer-item">Ingeniería y Servicios Marine Connection SpA</span>
                        <span class="rov-footer-item">· RUT 76.957.685-1</span>
                        <span class="rov-footer-item">· Pje. Chinquihue 136, Puerto Montt</span>
                        <span class="rov-footer-item">· +56 9 7646 3823</span>
                        <span class="rov-footer-item">· marineconnection.cl</span>
                    </div>
                </div>
            </div>
        </div>
    </template>
    <template id="ficha_cabecera">
        <table class="rov-header-band" data-rov-header-band="1" role="presentation">
            <tr>
                <td class="rov-header-brand">
                    <div class="rov-header-logo-window"><img t-if="o._ficha_logo_blanco_uri()" class="rov-header-logo" t-att-src="o._ficha_logo_blanco_uri()" alt="Marine Connection"/></div>
                    <div class="rov-header-title">Ficha de equipo reparado</div>
                </td>
                <td class="rov-header-number"><span t-field="o.name"/></td>
            </tr>
        </table>
        <div class="rov-identity-wrap">
            <table class="rov-identity-strip" role="presentation">
                <tr>
                    <td class="rov-identity-slot"><div class="rov-identity-card" data-rov-identity-card="1"><span class="rov-identity-label">Fecha</span><span class="rov-identity-value" t-field="o.fecha"/></div></td>
                    <td class="rov-identity-slot"><div class="rov-identity-card" data-rov-identity-card="1"><span class="rov-identity-label">Equipo</span><span class="rov-identity-value" t-field="o.product_id"/></div></td>
                    <td class="rov-identity-slot"><div class="rov-identity-card" data-rov-identity-card="1"><span class="rov-identity-label">N° de serie</span><span class="rov-identity-value" t-field="o.lot_id.name"/></div></td>
                    <td class="rov-identity-slot"><div class="rov-identity-card" data-rov-identity-card="1"><span class="rov-identity-label"><t t-if="o.repair_id">Cliente</t><t t-else="">Propietario</t></span><span t-if="o.repair_id" class="rov-identity-value" t-field="o.partner_id"/><span t-else="" class="rov-identity-value" t-field="o.propietario_id"/></div></td>
                    <td class="rov-identity-slot"><div class="rov-identity-card" data-rov-identity-card="1"><span class="rov-identity-label">Técnico</span><span class="rov-identity-value" t-field="o.responsable_id"/></div></td>
                </tr>
            </table>
        </div>
    </template>
    <template id="ficha_condiciones">
        <t t-set="largo_umbilical" t-value="o.largo if o.umbilical == 'prueba' else o.largo_ficha"/>
        <div class="rov-report-card" data-rov-conditions="1">
            <h2 class="rov-section-title">CON QU&#201; SE PROB&#211;</h2>
            <div class="rov-card-row"><span class="rov-card-label">Umbilical</span><span class="rov-card-value" t-field="o.umbilical"/></div>
            <div t-if="largo_umbilical" class="rov-card-row"><span class="rov-card-label">Largo</span><span class="rov-card-value"><span t-out="largo_umbilical"/> m</span></div>
            <div class="rov-card-row"><span class="rov-card-label">Alimentaci&#243;n</span><span class="rov-card-value" t-field="o.alimentacion"/></div>
            <div t-if="o.modelo_fuente" class="rov-card-row"><span class="rov-card-label">Fuente</span><span class="rov-card-value" t-field="o.modelo_fuente"/></div>
            <div class="rov-card-row"><span class="rov-card-label">Tensi&#243;n de salida</span><span class="rov-card-value"><span t-field="o.tension_salida"/> V</span></div>
        </div>
    </template>
    <template id="ficha_mediciones">
        <div class="rov-measurements" data-rov-measurements="1">
            <h2 class="rov-section-title">MEDICIONES</h2>
            <table class="rov-measurement-grid" role="presentation">
                <tr>
                    <td class="rov-measurement-panel" data-rov-measurement-panel="continuo">
                        <span class="rov-measurement-name">Funcionamiento continuo</span>
                        <div class="rov-measurement-row"><span class="rov-measurement-label">Duraci&#243;n</span><span class="rov-measurement-value"><span t-field="o.funcionamiento_continuo_duracion"/> h</span></div>
                        <div class="rov-measurement-row"><span class="rov-measurement-label">Resultado</span><span t-att-class="'rov-measurement-value rov-measurement-success' if o.funcionamiento_continuo_resultado == 'ok' else 'rov-measurement-value'"><span t-if="o.funcionamiento_continuo_resultado" t-field="o.funcionamiento_continuo_resultado"/><span t-else="">Pendiente</span></span></div>
                    </td>
                    <td class="rov-measurement-panel" data-rov-measurement-panel="banda">
                        <span class="rov-measurement-name">Ancho de banda</span>
                        <div class="rov-measurement-row"><span class="rov-measurement-label">Subida</span><span class="rov-measurement-value"><span class="rov-measurement-arrow">&#8593;</span> <span t-field="o.subida"/> Mbps</span></div>
                        <div class="rov-measurement-row"><span class="rov-measurement-label">Bajada</span><span class="rov-measurement-value"><span class="rov-measurement-arrow">&#8595;</span> <span t-field="o.bajada"/> Mbps</span></div>
                    </td>
                    <td class="rov-measurement-panel" data-rov-measurement-panel="estanqueidad">
                        <span class="rov-measurement-name">Estanqueidad</span>
                        <div class="rov-measurement-row"><span class="rov-measurement-label">Presi&#243;n</span><span class="rov-measurement-value"><span t-field="o.presion_bar"/> bar</span></div>
                        <div class="rov-measurement-row"><span class="rov-measurement-label">Sostenida</span><span class="rov-measurement-value"><span t-field="o.presion_tiempo"/> h</span></div>
                    </td>
                </tr>
                <tr>
                    <td class="rov-measurement-panel" data-rov-measurement-panel="aislacion">
                        <span class="rov-measurement-name">Aislaci&#243;n</span>
                        <div class="rov-measurement-row"><span class="rov-measurement-label">Fuga</span><span class="rov-measurement-value" data-rov-leakage="1"><span t-field="o.fuga_corriente"/> A</span></div>
                    </td>
                    <td class="rov-measurement-panel" data-rov-measurement-panel="consumo">
                        <span class="rov-measurement-name">Consumo</span>
                        <div class="rov-measurement-row"><span class="rov-measurement-label">Reposo</span><span class="rov-measurement-value"><span t-field="o.consumo_reposo"/> kWh</span></div>
                        <div class="rov-measurement-row"><span class="rov-measurement-label">Carga</span><span class="rov-measurement-value"><span t-field="o.consumo_carga"/> kWh</span></div>
                    </td>
                    <td class="rov-measurement-panel" data-rov-measurement-panel="luces">
                        <span class="rov-measurement-name">Luces</span>
                        <div class="rov-measurement-row"><span class="rov-measurement-label">Internas</span><span class="rov-measurement-value" t-field="o.luces_internas"/></div>
                        <div class="rov-measurement-row"><span class="rov-measurement-label">Externas</span><span class="rov-measurement-value" t-field="o.luces_externas"/></div>
                    </td>
                </tr>
            </table>
        </div>
    </template>
    <template id="ficha_sellos">
        <t t-set="sellos_visibles" t-value="o.inspeccion_ids.filtered(lambda sello: sello.estado_sello != 'no_lo_tiene')"/>
        <div t-if="sellos_visibles" class="rov-report-card" data-rov-seals="1">
            <h2 class="rov-section-title">SELLOS AL RECIBIR</h2>
            <div t-foreach="sellos_visibles" t-as="sello" class="rov-card-row" t-att-data-rov-seal="sello.id">
                <span class="rov-card-label" t-field="sello.componente_id"/>
                <span t-att-class="'rov-card-value rov-seal-ok' if sello.estado_sello == 'intacto' else 'rov-card-value rov-seal-fail' if sello.estado_sello in ('roto', 'ausente') else 'rov-card-value rov-seal-warning' if sello.estado_sello == 'sin_sello_previo' else 'rov-card-value rov-seal-pending'"><span t-if="sello.estado_sello" t-field="sello.estado_sello"/><span t-else="">Pendiente</span></span>
            </div>
        </div>
    </template>
    <template id="ficha_chequeos">
        <t t-set="order" t-value="['inspeccion_fisica', 'energia', 'leak', 'presion', 'comunicacion', 'video', 'luces', 'navegacion', 'accesorios', 'otro']"/>
        <t t-set="sections" t-value="order + [s for s in o.chequeo_ids.mapped('seccion') if s not in order]"/>
        <!-- No usar una lambda dentro de una comprensión: el safe_eval de QWeb la rechaza. -->
        <t t-set="visible_sections" t-value="[section for section in sections if section in o.chequeo_ids.mapped('seccion')]"/>
        <div class="rov-checks" data-rov-checks="1">
            <div class="rov-checks-header">
                <span class="rov-checks-title rov-section-title">CHEQUEOS EJECUTADOS &#183; <t t-out="len(o.chequeo_ids)"/></span>
                <span class="rov-checks-legend"><span class="rov-check-ok">Conforme</span> &#183; <span class="rov-check-fail">No conforme</span> &#183; <span class="rov-check-na">No aplica</span> &#183; <span class="rov-check-pending">Pendiente</span></span>
            </div>
            <table class="rov-check-grid" role="presentation">
                <t t-foreach="range(0, len(visible_sections), 3)" t-as="row_start">
                    <tr>
                        <t t-foreach="visible_sections[row_start:row_start + 3]" t-as="section">
                            <t t-set="lines" t-value="o.chequeo_ids.filtered(lambda line: line.seccion == section)"/>
                            <td class="rov-check-section" t-att-data-rov-check-section="section">
                                <div class="rov-check-section-head">
                                    <span class="rov-check-section-name" t-field="lines[0].seccion"/>
                                    <t t-set="results" t-value="lines.mapped('resultado')"/>
                                    <span t-att-class="'rov-check-section-summary ' + ('rov-check-summary-fail' if 'no_ok' in results else 'rov-check-summary-pending' if not all(results) else 'rov-check-summary-na' if 'no_lo_tiene' in results else 'rov-check-summary-ok')" data-rov-check-summary="1"><t t-out="len(lines.filtered(lambda line: line.resultado == 'ok'))"/> de <t t-out="len(lines)"/></span>
                                </div>
                                <div class="rov-check-details">
                                    <t t-foreach="lines" t-as="line">
                                        <span t-if="line_index" class="rov-check-separator"> &#183; </span>
                                        <span t-att-data-rov-check="line.id" t-att-class="'rov-check-line rov-check-ok' if line.resultado == 'ok' else 'rov-check-line rov-check-fail' if line.resultado == 'no_ok' else 'rov-check-line rov-check-na' if line.resultado == 'no_lo_tiene' else 'rov-check-line rov-check-pending'">
                                            <span t-out="line.chequeo_id.nombre_ficha or line.chequeo_id.name"/><t t-if="line.componente_id"> / <span t-field="line.componente_id"/></t>
                                        </span>
                                    </t>
                                </div>
                            </td>
                        </t>
                    </tr>
                </t>
            </table>
        </div>
    </template>
    <template id="ficha_hallazgos_observaciones">
        <t t-set="mostrar_hallazgos" t-value="o.tipo == 'reparacion' and options.get('hallazgos', True) and bool(o.hallazgo_ids)"/>
        <t t-set="mostrar_diferencias" t-value="o.tipo == 'reparacion' and options.get('diferencias', True) and (o.umbilical_difiere or o.luces_difieren or o.software_difiere)"/>
        <t t-set="mostrar_observaciones" t-value="bool(o.repair_id.observaciones_salida)"/>
        <t t-set="mostrar_tarjeta_observaciones" t-value="mostrar_observaciones or mostrar_diferencias"/>
        <table t-if="mostrar_hallazgos or mostrar_tarjeta_observaciones" class="rov-closing-grid" data-rov-closing-layout="1" role="presentation">
            <tr>
                <td t-if="mostrar_hallazgos" t-att-class="'rov-closing-cell ' + ('rov-closing-cell-half' if mostrar_tarjeta_observaciones else 'rov-closing-cell-full')">
                    <t t-call="mc_rov.ficha_hallazgos"/>
                </td>
                <td t-if="mostrar_hallazgos and mostrar_tarjeta_observaciones" class="rov-closing-gap"></td>
                <td t-if="mostrar_tarjeta_observaciones" t-att-class="'rov-closing-cell ' + ('rov-closing-cell-half rov-closing-cell-paired' if mostrar_hallazgos else 'rov-closing-cell-full')">
                    <t t-call="mc_rov.ficha_observaciones"/>
                </td>
            </tr>
        </table>
    </template>
    <template id="ficha_hallazgos">
        <div class="rov-closing-card" data-rov-findings="1">
            <div class="rov-closing-title rov-section-title">HALLAZGOS</div>
            <t t-set="hallazgos_ficha" t-value="o._ficha_hallazgos_para_pdf()"/>
            <t t-set="hallazgos_ocultos" t-value="len(o.hallazgo_ids) - len(hallazgos_ficha)"/>
            <div class="rov-finding" t-foreach="hallazgos_ficha" t-as="hallazgo">
                <div class="rov-finding-label"><span t-field="hallazgo.componente_id"/><t t-if="hallazgo.subtipo_id"> / <span t-field="hallazgo.subtipo_id"/></t></div>
                <div class="rov-finding-value"><span t-field="hallazgo.hallazgo_id"/></div>
            </div>
            <div t-if="hallazgos_ocultos" class="rov-finding rov-finding-summary" data-rov-findings-summary="1">
                <div class="rov-finding-label">y <t t-esc="hallazgos_ocultos"/> <t t-if="hallazgos_ocultos == 1">hallazgo más</t><t t-else="">hallazgos más</t></div>
                <div class="rov-finding-value">ver en el sistema</div>
            </div>
        </div>
    </template>
    <template id="ficha_diferencias">
        <div class="rov-differences" data-rov-differences="1">
            <div class="rov-difference-line" t-if="o.umbilical_difiere">El equipo llegó con el umbilical N° <span t-field="o.umbilical_serie"/>; su ficha declara el N° <span t-field="o.umbilical_ficha"/>.</div>
            <div class="rov-difference-line" t-if="o.luces_difieren">Luces probadas: <span t-field="o.luces_total"/>. Según ficha: <span t-field="o.luces_ficha"/>.</div>
            <div class="rov-difference-line" t-if="o.software_difiere" t-field="o.software_diferencias"/>
        </div>
    </template>
    <template id="ficha_observaciones_contenido">
        <div class="rov-closing-title rov-section-title rov-observations-title">OBSERVACIONES</div>
        <div t-if="mostrar_observaciones" class="rov-observations-content">
            <div class="rov-observations-text" t-field="o.repair_id.observaciones_salida"/>
        </div>
        <div t-if="mostrar_diferencias" class="rov-observations-differences"><t t-call="mc_rov.ficha_diferencias"/></div>
    </template>
    <template id="ficha_observaciones">
        <!-- La réplica invisible hace crecer la fila; la tarjeta visible ocupa esa altura. -->
        <div t-if="mostrar_hallazgos" class="rov-observations-sizer"><t t-call="mc_rov.ficha_observaciones_contenido"/></div>
        <div t-att-class="'rov-closing-card rov-observations-card ' + ('rov-observations-card-paired' if mostrar_hallazgos else '')" data-rov-observations="1">
            <t t-call="mc_rov.ficha_observaciones_contenido"/>
        </div>
    </template>
    <template id="ficha_firmas">
        <table class="rov-signatures" data-rov-signatures="1" role="presentation"><tr>
            <td><div class="rov-signature-line"></div><span class="rov-signature-label">Firma del técnico</span></td>
            <td><div class="rov-signature-line"></div><span class="rov-signature-label">Jefe de taller</span></td>
        </tr></table>
    </template>
</odoo>
