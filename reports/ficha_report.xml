<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_ficha_carta" model="report.paperformat">
        <field name="name">Ficha ROV - Carta</field>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">12</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">12</field>
        <field name="margin_right">12</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
    <record id="action_report_ficha" model="ir.actions.report">
        <field name="name">Ficha para el cliente</field>
        <field name="model">mc.rov.revision</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mc_rov.report_ficha</field>
        <field name="report_file">mc_rov.report_ficha</field>
        <field name="binding_model_id" ref="model_mc_rov_revision"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_ficha_carta"/>
        <field name="print_report_name">'Ficha - %s' % object.name.replace('/', '-')</field>
    </record>

    <!-- Los bloques tienen IDs estables para herencias Studio. El código base sigue
         actualizándose; una personalización debe ser una vista heredada, no sobrescribirlo. -->
    <template id="report_ficha">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="mc_rov.report_ficha_document"/>
            </t>
        </t>
    </template>
    <template id="report_ficha_document">
        <t t-set="company" t-value="o.lot_id.company_id or res_company"/>
        <t t-set="options" t-value="o.env.context.get('rov_options', {})"/>
        <div class="article rov-ficha" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" t-att-data-oe-lang="o.env.lang">
            <style>
                .rov-ficha { font-family: Arial, sans-serif; font-size: 10pt; color: #243444; }
                .rov-ficha h1 { font-family: Georgia, serif; font-size: 21pt; color: #00569a; margin: 5px 0 8px; }
                .rov-ficha h2 { font-size: 11pt; color: #00569a; margin: 10px 0 4px; page-break-after: avoid; }
                .rov-ficha table { width: 100%; border-collapse: collapse; table-layout: fixed; }
                .rov-ficha td, .rov-ficha th { padding: 4px 7px; vertical-align: top; overflow-wrap: break-word; word-wrap: break-word; }
                .rov-ficha th { text-align: left; font-weight: normal; }
                .rov-ficha .rov-value { font-family: 'Courier New', monospace; }
                .rov-ficha .rov-data tr { border-bottom: 1px solid #dbe3e9; }
                .rov-ficha .rov-data th { width: 45%; }
                .rov-ficha .rov-meta { background: #f0f5f8; border: 1px solid #dbe3e9; }
                .rov-ficha .rov-pair { width: 50%; padding: 0 9px 0 0; }
                .rov-ficha .rov-section { font-weight: bold; background: #f0f5f8; }
                .rov-ficha .rov-check { padding-left: 16px; }
                .rov-ficha .rov-fail { color: #a42323; font-weight: bold; }
                .rov-ficha .rov-na { color: #657585; font-style: italic; }
                .rov-ficha .rov-finding { display: table; width: 100%; border-bottom: 1px solid #dbe3e9; page-break-inside: avoid !important; }
                .rov-ficha .rov-finding-label, .rov-ficha .rov-finding-value { display: table-cell; padding: 4px 7px; vertical-align: top; }
                .rov-ficha .rov-finding-label { width: 36%; }
                .rov-ficha .rov-draft { border: 2px solid #00569a; padding: 6px; text-align: center; font-weight: bold; margin-bottom: 8px; }
                .rov-ficha .rov-signatures td { padding-top: 12px; text-align: center; }
                .rov-ficha .rov-signatures { page-break-inside: avoid; }
                .rov-ficha .rov-notes { white-space: pre-wrap; overflow-wrap: break-word; }
                .rov-ficha .rov-logo { max-height: 45px; max-width: 180px; }
                .rov-ficha .rov-footer { font-size: 8pt; color: #657585; border-top: 1px solid #dbe3e9; margin-top: 8px; padding-top: 4px; }
                /* QtWebKit puede ignorar la regla del tr y partir el contenido de una celda. */
                .rov-ficha tr, .rov-ficha td, .rov-ficha th { page-break-inside: avoid !important; }
            </style>
            <div class="page">
                <div class="rov-draft" t-if="o.estado == 'borrador'">BORRADOR - revisión sin confirmar</div>
                <t t-call="mc_rov.ficha_cabecera"/>
                <table><tr>
                    <td class="rov-pair"><t t-call="mc_rov.ficha_condiciones"/></td>
                    <td class="rov-pair"><t t-call="mc_rov.ficha_mediciones"/></td>
                </tr></table>
                <t t-if="o.tipo == 'reparacion' and options.get('sellos', True)" t-call="mc_rov.ficha_sellos"/>
                <t t-call="mc_rov.ficha_chequeos"/>
                <t t-if="o.tipo == 'reparacion' and options.get('hallazgos', True)" t-call="mc_rov.ficha_hallazgos"/>
                <t t-if="o.tipo == 'reparacion' and options.get('diferencias', True)" t-call="mc_rov.ficha_diferencias"/>
                <t t-call="mc_rov.ficha_observaciones"/>
                <t t-if="options.get('firmas', True)" t-call="mc_rov.ficha_firmas"/>
                <div class="rov-footer">
                    <span t-field="company.name"/> · <span t-field="o.name"/>
                    <t t-if="company.vat"> · <span t-field="company.vat"/></t>
                    <t t-if="company.phone"> · <span t-field="company.phone"/></t>
                    <t t-if="company.website"> · <span t-field="company.website"/></t>
                </div>
            </div>
        </div>
    </template>
    <template id="ficha_cabecera">
        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" class="rov-logo" alt="Logotipo de la compañía"/>
        <div t-else="" t-field="company.name"/>
        <h1><t t-if="o.tipo == 'reparacion'">Ficha de equipo reparado</t><t t-else="">Ficha de equipo nuevo</t></h1>
        <table class="rov-meta">
            <tr><th>Documento</th><td class="rov-value"><span t-field="o.name"/></td><th>Fecha</th><td><span t-field="o.fecha"/></td></tr>
            <tr><th>Equipo</th><td><span t-field="o.product_id"/></td><th>N° de serie</th><td class="rov-value"><span t-field="o.lot_id.name"/></td></tr>
            <tr><th><t t-if="o.repair_id">Cliente</t><t t-else="">Propietario</t></th>
                <td><span t-if="o.repair_id" t-field="o.partner_id"/><span t-else="" t-field="o.propietario_id"/></td>
                <th>Técnico</th><td><span t-field="o.responsable_id"/></td></tr>
            <tr><th>Tipo de prueba</th><td colspan="3"><span t-field="o.tipo"/></td></tr>
        </table>
    </template>
    <template id="ficha_condiciones">
        <h2>Con qué se probó</h2>
        <table class="rov-data">
            <tr><th>Umbilical</th><td><span t-field="o.umbilical"/>
                <t t-if="o.umbilical == 'prueba'"> · <span t-field="o.largo"/> m</t>
                <t t-elif="o.largo_ficha"> · <span t-field="o.largo_ficha"/> m</t>
            </td></tr>
            <tr t-if="o.umbilical_serie"><th>N° de umbilical recibido</th><td><span t-field="o.umbilical_serie"/></td></tr>
            <tr><th>Alimentación</th><td><span t-field="o.alimentacion"/></td></tr>
            <tr t-if="o.modelo_fuente"><th>Fuente</th><td><span t-field="o.modelo_fuente"/></td></tr>
            <tr><th>Tensión de salida</th><td><span t-field="o.tension_salida"/> V</td></tr>
            <t t-if="o.tipo == 'terreno'">
                <tr><th>Lugar</th><td><span t-field="o.lugar"/></td></tr>
                <tr><th>Profundidad</th><td><span t-field="o.profundidad"/> m</td></tr>
                <tr><th>Corriente</th><td><span t-field="o.velocidad_corriente"/> kn</td></tr>
            </t>
        </table>
    </template>
    <template id="ficha_mediciones">
        <h2>Mediciones</h2>
        <table class="rov-data">
            <tr t-if="o.tipo != 'terreno'"><th>Funcionamiento continuo</th><td><span t-field="o.funcionamiento_continuo_duracion"/> h ·
                <span t-if="o.funcionamiento_continuo_resultado" t-field="o.funcionamiento_continuo_resultado"/><span t-else="">Pendiente</span></td></tr>
            <tr><th>Ancho de banda</th><td>Subida <span t-field="o.subida"/> / bajada <span t-field="o.bajada"/> Mbps</td></tr>
            <tr t-if="o.tipo != 'terreno'"><th>Presión</th><td><span t-field="o.presion_bar"/> bar · <span t-field="o.presion_tiempo"/> h</td></tr>
            <tr t-if="o.tipo != 'terreno'"><th>Fuga de corriente</th><td data-rov-leakage="1"><span t-field="o.fuga_corriente"/> A</td></tr>
            <tr t-if="o.tipo != 'terreno'"><th>Consumo</th><td>Reposo <span t-field="o.consumo_reposo"/> / carga <span t-field="o.consumo_carga"/> kWh</td></tr>
            <tr t-if="o.tipo == 'terreno'"><th>Duración de la prueba</th><td><span t-field="o.duracion"/> h</td></tr>
            <tr><th>Luces</th><td>Internas <span t-field="o.luces_internas"/> · externas <span t-field="o.luces_externas"/></td></tr>
        </table>
    </template>
    <template id="ficha_sellos">
        <div t-if="o.inspeccion_ids" data-rov-seals="1">
            <h2>Sellos al recibir</h2>
            <table class="rov-data"><tr t-foreach="o.inspeccion_ids" t-as="sello">
                <th><span t-field="sello.componente_id"/></th><td><span t-if="sello.estado_sello" t-field="sello.estado_sello"/><span t-else="">Pendiente</span></td>
            </tr></table>
        </div>
    </template>
    <template id="ficha_chequeos">
        <h2>Chequeos</h2>
        <p>Conforme · No conforme · No aplica · Pendiente</p>
        <!-- El catálogo puede crecer. No se limita la lista al ejemplo de 24 chequeos. -->
        <t t-set="order" t-value="['inspeccion_fisica', 'energia', 'leak', 'presion', 'comunicacion', 'video', 'luces', 'navegacion', 'accesorios', 'otro']"/>
        <t t-set="sections" t-value="order + [s for s in o.chequeo_ids.mapped('seccion') if s not in order]"/>
        <table class="rov-data">
            <t t-foreach="sections" t-as="section">
                <t t-set="lines" t-value="o.chequeo_ids.filtered(lambda line: line.seccion == section)"/>
                <t t-if="lines">
                    <tr>
                        <td style="width: 30%"><strong t-field="lines[0].seccion"/>
                            <small>(<t t-out="len(lines.filtered(lambda line: line.resultado == 'ok'))"/>/<t t-out="len(lines)"/>)</small>
                        </td>
                        <td class="rov-check">
                            <t t-foreach="lines" t-as="line">
                                <span t-att-data-rov-check="line.id" t-att-class="'rov-fail' if line.resultado == 'no_ok' else 'rov-na' if line.resultado == 'no_lo_tiene' else ''">
                                    <span t-field="line.chequeo_id"/><t t-if="line.componente_id"> / <span t-field="line.componente_id"/></t>
                                    (<t t-out="{'ok': 'Conforme', 'no_ok': 'No conforme', 'no_lo_tiene': 'No aplica'}.get(line.resultado, 'Pendiente')"/>)
                                </span><t t-if="not line_last"> · </t>
                            </t>
                        </td>
                    </tr>
                </t>
            </t>
        </table>
    </template>
    <template id="ficha_hallazgos">
        <div t-if="o.hallazgo_ids" data-rov-findings="1">
            <h2>Hallazgos</h2>
            <div class="rov-finding" t-foreach="o.hallazgo_ids" t-as="hallazgo">
                <div class="rov-finding-label"><span t-field="hallazgo.componente_id"/><t t-if="hallazgo.subtipo_id"> / <span t-field="hallazgo.subtipo_id"/></t></div>
                <div class="rov-finding-value"><span t-field="hallazgo.hallazgo_id"/></div>
            </div>
        </div>
    </template>
    <template id="ficha_diferencias">
        <div t-if="o.umbilical_difiere or o.luces_difieren or o.software_difiere">
            <h2>Diferencias con la ficha del equipo</h2>
            <p t-if="o.umbilical_difiere">Umbilical recibido: <span t-field="o.umbilical_serie"/>. Según ficha: <span t-field="o.umbilical_ficha"/>.</p>
            <p t-if="o.luces_difieren">Luces probadas: <span t-field="o.luces_total"/>. Según ficha: <span t-field="o.luces_ficha"/>.</p>
            <p t-if="o.software_difiere" t-field="o.software_diferencias"/>
        </div>
    </template>
    <template id="ficha_observaciones">
        <div t-if="o.repair_id.observaciones_salida">
            <h2>Observaciones</h2><div class="rov-notes" t-field="o.repair_id.observaciones_salida"/>
        </div>
    </template>
    <template id="ficha_firmas">
        <table class="rov-signatures" data-rov-signatures="1"><tr>
            <td>________________________<br/>Firma del técnico</td>
            <td>________________________<br/>Jefe de taller</td>
        </tr></table>
    </template>
</odoo>
