                .rov-ficha .rov-header-logo { position: absolute; top: -25.99px; left: -3.72px; width: 180.71px; max-width: none; height: auto; }
                .rov-ficha .rov-header-title { margin-left: .28em; font-family: Georgia, serif; font-size: 20.41pt; font-weight: bold; line-height: 1; }
